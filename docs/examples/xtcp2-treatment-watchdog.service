[Unit]
Description=xtcp2 independent TCP treatment lease watchdog
After=local-fs.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/xtcp2-treatmentctl -mode=watchdog -config=/etc/xtcp2/controller-agent.json
Restart=always
RestartSec=2s
StateDirectory=xtcp2
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

{
 "cmd": "tc qdisc del dev eth0 root handle 1:",
 "desc": "negative: Delete mqprio Qdisc twice",
 "env": {
  "iproute2": "ip utility, iproute2-7.2.0, libbpf 1.8.0",
  "kernel": "7.3.0"
 },
 "expect": {
  "match": {
   "count": 0,
   "pattern": "(?sm)qdisc mqprio 1: root",
   "readback": "verify"
  },
  "rc": 2
 },
 "id": "tdc/qdiscs/mqprio/5292",
 "modules": [
  "sch_mqprio",
  "netdevsim"
 ],
 "pre": [
  [
   "echo 1 > /sys/bus/netdevsim/del_device",
   [
    1,
    2
   ]
  ],
  "echo \"1 1 8\" > /sys/bus/netdevsim/new_device",
  "tc qdisc add dev eth0 root handle 1: mqprio num_tc 8 map 0 1 2 3 4 5 6 7 queues 1@0 1@1 1@2 1@3 1@4 1@5 1@6 1@7 hw 0",
  "tc qdisc del dev eth0 root handle 1:"
 ],
 "readback": [
  {
   "cmd": "tc qdisc show dev eth0",
   "name": "verify"
  }
 ],
 "result": {
  "pre": [
   {
    "cmd": "echo 1 > /sys/bus/netdevsim/del_device",
    "rc": 0
   },
   {
    "cmd": "echo \"1 1 8\" > /sys/bus/netdevsim/new_device",
    "rc": 0
   },
   {
    "cmd": "tc qdisc add dev eth0 root handle 1: mqprio num_tc 8 map 0 1 2 3 4 5 6 7 queues 1@0 1@1 1@2 1@3 1@4 1@5 1@6 1@7 hw 0",
    "rc": 0
   },
   {
    "cmd": "tc qdisc del dev eth0 root handle 1:",
    "rc": 0
   }
  ],
  "rc": 2,
  "status": "OK"
 },
 "serial": true,

{
 "cmd": "tc qdisc add dev eth0 root handle 1: mq",
 "desc": "positive: Show mq class",
 "env": {
  "iproute2": "ip utility, iproute2-7.2.0, libbpf 1.8.0",
  "kernel": "7.3.0"
 },
 "expect": {
  "match": {
   "count": 4,
   "pattern": "(?sm)class mq 1:[0-9]+ root",
   "readback": "verify"
  },
  "rc": 0
 },
 "id": "tdc/qdiscs/mq/1023",

if1:
    inet 127.0.0.1/8 scope host lo
       valid_lft forever preferred_lft forever
if3:
    inet 192.0.2.1/24 scope global d0
       valid_lft forever preferred_lft forever
if3:
    inet 192.0.2.2/24 scope global secondary d0
       valid_lft forever preferred_lft forever
if1:
    inet6 ::1/128 scope host proto kernel_lo 
       valid_lft forever preferred_lft forever
if3:
    inet6 2001:db8:3::1/48 scope global nodad 
       valid_lft forever preferred_lft forever
if3:
    inet6 2001:db8:2::1/64 scope global nodad mngtmpaddr noprefixroute 
       valid_lft forever preferred_lft forever
if3:
    inet6 2001:db8:1::1/64 scope global home 
       valid_lft forever preferred_lft forever
if3:
    inet6 2001:db8::1/64 scope global nodad 
       valid_lft forever preferred_lft forever

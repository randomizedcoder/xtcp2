{"id":"mpls/get","desc":"positive: a get of a label","cmd":"ip -f mpls route get 100","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input","ip -f mpls route add 100 via inet 10.0.0.2 dev d0"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":0,"refused_by":"none"},"axes":{"dst":"100","verb":"get"}}
{"id":"mpls/get-as","desc":"positive: a get with as","cmd":"ip -f mpls route get 100 as 200","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input","ip -f mpls route add 100 via inet 10.0.0.2 dev d0"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":0,"refused_by":"none"},"axes":{"as":"200","dst":"100","verb":"get"}}
{"id":"mpls/get-absent","desc":"negative: a get of a label that isn't there (Network is unreachable)","cmd":"ip -f mpls route get 101","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input","ip -f mpls route add 100 via inet 10.0.0.2 dev d0"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":2,"errno":"ENETUNREACH","refused_by":"kernel"},"axes":{"dst":"101","verb":"get"}}
{"id":"mpls/show","desc":"positive: a show of a stack, a mixed multipath and a ttl-propagate","cmd":"ip -f mpls route show","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input","ip -f mpls route add 100 as 200/300 via inet 10.0.0.2 dev d0","ip -f mpls route add 101 nexthop as 200 via inet 10.0.0.2 dev d0 nexthop via inet6 2001:db8::2 dev d0","ip -f mpls route add 102 dev d0 ttl-propagate disabled"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":0,"refused_by":"none"}}
{"id":"mpls/show-json","desc":"positive: the same, as JSON, whose ttl-propagate key ip misspells","cmd":"ip -j -f mpls route show","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input","ip -f mpls route add 100 as 200/300 via inet 10.0.0.2 dev d0","ip -f mpls route add 101 nexthop as 200 via inet 10.0.0.2 dev d0 nexthop via inet6 2001:db8::2 dev d0","ip -f mpls route add 102 dev d0 ttl-propagate disabled"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":0,"refused_by":"none"}}
{"id":"mpls/ttl-after-hops","desc":"negative: ttl-propagate after the nexthops, refused once the hops' devices are looked up (\"nexthop\" or end of line is expected)","cmd":"ip -f mpls route add 100 nexthop as 300 via inet 10.0.0.2 dev d0 nexthop as 400 via inet 10.0.0.3 dev d0 ttl-propagate enabled","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":255,"refused_by":"ack-then-fail"}}
{"id":"mpls/inet-as","desc":"corner: as on an IPv4 route, sent as the IPv4 address 200.0.0.0, which the kernel ignores","cmd":"ip route add 10.1.0.0/24 as 200 via 10.0.0.2","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":0,"refused_by":"none"},"axes":{"newdst":"c8000000","verb":"add"}}
{"id":"mpls/inet6-as","desc":"negative: as on an IPv6 route (inet6 address is expected)","cmd":"ip -6 route add 2001:db8:9::/64 as 200 via 2001:db8::2","pre":["ip link add d0 type dummy && ip link set d0 addrgenmode none && ip link set d0 up && ip addr add 10.0.0.1/24 dev d0 && ip -6 addr add 2001:db8::1/64 dev d0 nodad && echo 1000 > /proc/sys/net/mpls/platform_labels && echo 1 > /proc/sys/net/mpls/conf/d0/input"],"readback":[{"name":"show","cmd":"ip -f mpls route show"},{"name":"showj","cmd":"ip -j -f mpls route show"}],"modules":["mpls_router","mpls_iptunnel"],"expect":{"rc":1,"refused_by":"iproute2"}}

foreach o $bridge_options {
    lappend design_rows bridge/add_$o
}
lappend design_rows {*}{
    bridge/add_fdb_flush bridge/add_stp_mode_auto bridge/add_stp_mode_user
    bridge/add_stp_mode_kernel bridge/add_boolopts bridge/add_several

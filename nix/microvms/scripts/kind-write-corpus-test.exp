    {slugs $R} [join $design_rows " "]
check first_row "boundary: add_default comes first" \
    {lindex [slugs $R] 0} bridge/add_default
check row_count "boundary: KC2's 60 bridge and 42 bridge_slave rows, KC3-T01's 28 vlan rows, KC3-T02's 34 macvlan and 6 macvtap rows, KC3-T03's 18 ipvlan and 4 ipvtap rows, KC4-T01's 73 vxlan rows, KC4-T02's 49 geneve rows, KC4-T03's 16 bareudp and 20 amt rows, KC4-T04's 19 gtp rows, KC5-T01's 45 gre, 11 gretap and 25 erspan rows, KC5-T02's 36 ip6gre, 9 ip6gretap and 19 ip6erspan rows, KC5-T03's 47 ipip and 37 sit rows, KC5-T04's 49 ip6tnl rows, KC5-T05's 23 vti, 12 vti6 and 23 xfrm rows" \
    {llength $R} 705
check bridge_first "boundary: bridge's rows all come before bridge_slave's" \
    {lsearch -glob [slugs $R] bridge_slave/*} 60
check option_rows "positive: one add_ row per value-taking option but stp_mode, each once" \
    {add_options} [join $bridge_options " "]
check option_count "boundary: 39 of them" \
    {llength $bridge_options} 39
check slave_option_rows "positive: one set_ row per value-taking port option, each once, then neigh_forward_grat's and backup_port's own" \
    {set_options} [join [concat $slave_options neigh_forward_grat backup_port] " "]
check slave_option_count "boundary: 24 of them" \
    {llength $slave_options} 24
check arity "negative: every row is {slug floor pre command readbacks rc}" \
    {bad_arity $R} {}
check arity_five "negative: a five-field row is listed" \
    {bad_arity [list {a 2 {} {ip link add br0 type bridge} {}}]} a
check unique_slugs "negative: no slug names two rows" \
    {dup_slugs $R} {}
check unique_dup "negative: a duplicated slug is listed" \
    {dup_slugs [list {a} {b} {a}]} a


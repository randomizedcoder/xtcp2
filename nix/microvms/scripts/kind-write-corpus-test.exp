    bridge/add_igmp_version_bad bridge/add_mcast_vlan_snooping_no_vlan
    bridge/add_stp_mode_bad bridge/add_vlan_protocol_bad
    bridge/add_priority_bad bridge/add_no_value
}
set slave_options {
    state priority cost hairpin guard root_block fastleave learning flood

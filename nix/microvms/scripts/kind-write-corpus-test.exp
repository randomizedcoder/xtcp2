check refused_statuses "positive: exactly the refusal rows expect a non-zero status" \
    {refused_rows} [join $refused_design " "]
check rc_values "boundary: every status is 0, 1, 2 or 255" \
    {bad_rc $R} {}
check rc_three "negative: a status of 3 is listed" \
    {bad_rc [list {x3 2 {} {ip link add br0 type bridge} {} 3}]} x3

foreach {name description want got expected} {
    rc_ok     "positive: the status the row wants is no problem"   0 "0\n" ""
    rc_wrong  "negative: another status is named"                  2 0     "kinds/x/ip.rc is 0, want 2"
    rc_none   "corner: an unreadable ip.rc is named as such"       0 ""    "kinds/x/ip.rc unreadable, want 0"
} {
    check $name $description [list kindcorpus::rc_problem x $want $got] $expected
}

###############################################################################
# 3. floors, readbacks and quoting
###############################################################################
check floors "boundary: no row or readback is under its structural floor" \
    {bad_floors $R} {}
check floor_refused "boundary: an ip-refused row's floor is 0 and it has no readback" \
    {bad_floors [list {x0 0 {} {ip link add br0 type bridge priority x} {} 255} \
                      {x2 2 {} {ip link add br0 type bridge priority x} {} 255} \
                      {xr 0 {} {ip link add br0 type bridge priority x} {{getlink 2 {ip link show}}} 1}]} \
    {x2 xr}
check floor_set "boundary: a set at 2 is listed, as it resolves the name first" \
    {bad_floors [list {s2 2 {} {ip link set br0 type bridge ageing_time 1} {} 0}]} s2
check floor_add "positive: an add at 2 and a set at 4 are their floors" \
    {list [field bridge/add_default 1] [field bridge/set_ageing_time 1]} {2 4}
check readbacks_accepted "positive: an accepted row reads back three ways" \
    {readback_names bridge/add_default} {getlink_detail getlink_detail_json getlink}
check readbacks_kernel_refused "corner: a kernel-refused row reads back too, to show no device" \
    {readback_names bridge/add_group_address_bad} {getlink_detail getlink_detail_json getlink}
check readbacks_ip_refused "negative: a row ip refuses has nothing to read back" \
    {readback_names bridge/add_priority_bad} {}
check readback_commands "positive: the readbacks name br0" \
    {lmap rb [field bridge/add_default 4] {lindex $rb 2}} \
    {{ip -d link show dev br0} {ip -d -j -p link show dev br0} {ip link show dev br0}}
check no_single_quotes "corner: no command or readback holds a single quote" \
    {quoted} {}
check readback_args_shape "positive: a readback is a capio of netlink_route_<name> into ip_<name>" \
    {kindcorpus::readback_args lacpa kinds/bridge/x {getlink 2 {ip link show dev br0}}} \
    {lacpa kinds/bridge/x netlink_route_getlink 2 {ip link show dev br0} ip_getlink}
check readback_args_short "negative: a two-field readback is an error" \
    {kindcorpus::readback_args lacpa kinds/x {getlink 2}} ERROR

###############################################################################
# 4. the bridge rows' states
###############################################################################
check set_pre "corner: every set_ row but the busy one starts from a bare br0" \
    {lmap s {set_ageing_time set_vlan_filtering set_stp_mode} {field bridge/$s 2}} \
    [list {{link add br0 type bridge}} {{link add br0 type bridge}} {{link add br0 type bridge}}]
check set_busy_pre "corner: the busy row's br0 has STP on" \
    {field bridge/set_stp_mode_busy 2} {{link add br0 type bridge stp_state 1}}
check add_pre "boundary: an add row has no pre step" \
    {field bridge/add_default 2} {}
check add_default_cmd "corner: add_default sends no option, with no trailing space" \
    {field bridge/add_default 3} {ip link add br0 type bridge}
check vlan_snooping_needs_filtering "corner: mcast_vlan_snooping's row turns vlan_filtering on first" \
    {field bridge/add_mcast_vlan_snooping 3} \
    {ip link add br0 type bridge vlan_filtering 1 mcast_vlan_snooping 1}
check vlan_snooping_refused "negative: without vlan_filtering the kernel refuses it" \
    {list [field bridge/add_mcast_vlan_snooping_no_vlan 3] [field bridge/add_mcast_vlan_snooping_no_vlan 5]} \
    {{ip link add br0 type bridge mcast_vlan_snooping 1} 2}
check abbrev_matches "corner: a matches keyword's abbreviation is accepted" \
    {list [field bridge/add_abbrev 3] [field bridge/add_abbrev 5]} \
    {{ip link add br0 type bridge forward_d 400} 0}
check abbrev_strcmp "corner: a strcmp keyword's is refused by ip" \
    {list [field bridge/add_stp_mode_abbrev 3] [field bridge/add_stp_mode_abbrev 5]} \
    {{ip link add br0 type bridge stp_m user} 1}

###############################################################################
# 5. the bridge_slave rows' states
###############################################################################
set ports {{link add br0 type bridge} {link add p0 type dummy} {link add p1 type dummy} {link set p0 master br0} {link set p1 master br0}}

check slave_floor "positive: a port option is a set, at floor 4" \
    {field bridge_slave/set_cost 1} 4
check slave_readbacks "positive: a port row reads p0 back" \
    {lmap rb [field bridge_slave/set_cost 4] {lindex $rb 2}} \
    {{ip -d link show dev p0} {ip -d -j -p link show dev p0} {ip link show dev p0}}
check slave_pre "positive: a port row starts from br0 with p0 and p1 enslaved" \
    {field bridge_slave/set_cost 2} $ports
check slave_state_pre "corner: state's row brings p0 up, with no IPv6 address" \
    {lrange [field bridge_slave/set_state 2] 5 end} \
    {{link set p0 addrgenmode none} {link set p0 up}}
check slave_state_bad_pre "corner: the refused state needs no up port, as the range check comes first" \
    {field bridge_slave/set_state_bad 2} $ports
check slave_nobackup_pre "corner: nobackup_port clears a backup port set before the window" \
    {lindex [field bridge_slave/set_nobackup_port 2] end} \
    {link set dev p0 type bridge_slave backup_port p1}
check slave_not_enslaved_pre "negative: the not-enslaved row's p0 has no master" \
    {field bridge_slave/set_not_enslaved 2} {{link add p0 type dummy}}
check slave_mab_locked "corner: mab's row locks the port first" \
    {field bridge_slave/set_mab 3} {ip link set dev p0 type bridge_slave locked on mab on}
check slave_mab_unlocked "negative: mab alone is refused by the kernel" \
    {list [field bridge_slave/set_mab_unlocked 3] [field bridge_slave/set_mab_unlocked 5]} \
    {{ip link set dev p0 type bridge_slave mab on} 2}
check slave_backup_port "positive: backup_port names p1, which the readback prints by name" \
    {field bridge_slave/set_backup_port 3} {ip link set dev p0 type bridge_slave backup_port p1}
check slave_priority_bounds "boundary: priority 64 is one past the kernel's 63" \
    {list [field bridge_slave/set_priority_over 3] [field bridge_slave/set_priority_over 5]} \
    {{ip link set dev p0 type bridge_slave priority 64} 2}
check slave_cost_bounds "boundary: cost 0 is one under the kernel's 1" \
    {list [field bridge_slave/set_cost_zero 3] [field bridge_slave/set_cost_zero 5]} \
    {{ip link set dev p0 type bridge_slave cost 0} 2}
check slave_abbrev "corner: a matches keyword's abbreviation is accepted, a strcmp keyword's refused" \
    {list [field bridge_slave/set_abbrev 5] [field bridge_slave/set_strcmp_abbrev 3] [field bridge_slave/set_strcmp_abbrev 5]} \
    {0 {ip link set dev p0 type bridge_slave neigh_forward_g on} 1}
check slave_on_off_vs_value "corner: a bad on/off exits 1, a missing value 255" \
    {list [field bridge_slave/set_on_off_bad 5] [field bridge_slave/set_no_value 5]} {1 255}

###############################################################################
# 6. the vlan rows' states
###############################################################################
check vlan_after_slave "positive: vlan's rows follow bridge_slave's" \
    {lsearch -glob [slugs $R] vlan/*} 102
check vlan_flag_rows "positive: one add_ row per flag keyword, each once" \
    {vlan_flags} [join $vlan_flags " "]
check vlan_flag_count "boundary: 5 of them" \
    {llength $vlan_flags} 5
check vlan_default "positive: add_default sends the id alone, on d0" \
    {list [field vlan/add_default 2] [field vlan/add_default 3]} \
    {{{link add d0 type dummy}} {ip link add link d0 name v0 type vlan id 10}}
check vlan_id_range "boundary: 4094 is accepted, 4095 refused by the kernel" \
    {list [field vlan/add_id_max 3] [field vlan/add_id_max 5] [field vlan/add_id_over 3] [field vlan/add_id_over 5]} \
    {{ip link add link d0 name v0 type vlan id 4094} 0 {ip link add link d0 name v0 type vlan id 4095} 2}
check vlan_set_id_pre "corner: set_id sends a new id to a v0 made with id 10" \
    {list [field vlan/set_id 2] [field vlan/set_id 3] [field vlan/set_id 1]} \
    {{{link add d0 type dummy} {link add link d0 name v0 type vlan id 10}} {ip link set v0 type vlan id 20} 4}
check vlan_duplicate "corner: the duplicate's pre holds v0 with id 10, and its readbacks read v1" \
    {list [lindex [field vlan/add_duplicate_id 2] end] [lindex [field vlan/add_duplicate_id 4] 0 2]} \
    {{link add link d0 name v0 type vlan id 10} {ip -d link show dev v1}}
check vlan_no_link "negative: the no-link row names no lower" \
    {field vlan/add_no_link 3} {ip link add name v0 type vlan id 10}
check vlan_no_id "negative: the no-id row sends no option" \
    {field vlan/add_no_id 3} {ip link add link d0 name v0 type vlan}
check vlan_loopback "corner: the loopback row stacks on lo" \
    {field vlan/add_on_loopback 3} {ip link add link lo name v0 type vlan id 10}
check vlan_pre_d0 "positive: every vlan row's pre makes d0 first" \
    {lsort -unique [lmap r $R {expr {[string match vlan/* [lindex $r 0]] ? [lindex $r 2 0] : "-"}}]} \
    {- {link add d0 type dummy}}
check vlan_returned_vs_exit "corner: on_off and an unknown word return (1); a bad mapping exits (255)" \
    {lmap s {add_on_off_bad add_qos_no_colon add_qos_bad} {field vlan/$s 5}} {1 1 255}

###############################################################################
# 7. the macvlan and macvtap rows' states
###############################################################################
check macvlan_after_vlan "positive: macvlan's rows follow vlan's, and macvtap's macvlan's" \
    {list [lsearch -glob [slugs $R] macvlan/*] [lsearch -glob [slugs $R] macvtap/*]} {130 164}
check macvlan_mode_rows "positive: one add_mode_ row per mode, each once" \
    {macvlan_modes} [join $macvlan_modes " "]
check macvlan_mode_count "boundary: 5 of them" \
    {llength $macvlan_modes} 5
check macvlan_default "positive: add_default sends no option, on d0" \
    {field macvlan/add_default 3} {ip link add link d0 name m0 type macvlan}
check macvlan_source_pre "corner: set_macaddr_del's pre makes m0 in source mode, holding the address deleted" \
    {list [lindex [field macvlan/set_macaddr_del 2] end] [field macvlan/set_macaddr_del 3]} \
    {{link add link d0 name m0 type macvlan mode source macaddr add 02:00:00:00:00:01} {ip link set m0 type macvlan macaddr del 02:00:00:00:00:01}}
check macvlan_second_passthru "corner: the second passthru's pre holds a passthru m0, and its readbacks read m1" \
    {list [lindex [field macvlan/add_second_passthru 2] end] [lindex [field macvlan/add_second_passthru 4] 0 2]} \
    {{link add link d0 name m0 type macvlan mode passthru} {ip -d link show dev m1}}
check macvlan_set_passthru "negative: set_passthru changes a bridge-mode m0 to passthru" \
    {list [lindex [field macvlan/set_passthru 2] end] [field macvlan/set_passthru 3] [field macvlan/set_passthru 5]} \
    {{link add link d0 name m0 type macvlan mode bridge} {ip link set m0 type macvlan mode passthru} 2}
check macvlan_bclim_negative "boundary: bclim takes a negative" \
    {list [field macvlan/add_bclim_negative 3] [field macvlan/add_bclim_negative 5]} \
    {{ip link add link d0 name m0 type macvlan bclim -1} 0}
check macvlan_bclim_strcmp "corner: bclim is strcmp, so bcl is an unknown word (1)" \
    {list [field macvlan/add_bclim_abbrev 3] [field macvlan/add_bclim_abbrev 5]} \
    {{ip link add link d0 name m0 type macvlan bcl 10} 1}
check macvlan_returned_vs_exit "corner: every ip refusal returns (1) but NEXT_ARG's (255)" \
    {lmap s {add_nopromisc_not_passthru add_mode_bad add_macaddr_bad add_no_value} {field macvlan/$s 5}} \
    {1 1 1 255}
check macvtap_kind "corner: every macvtap row adds or sets t0 as a macvtap" \
    {strays $R macvtap t0} {}
check macvtap_kind_caught "negative: a macvtap row sent as macvlan is listed" \
    {strays [list {macvtap/x 4 {} {ip link add link d0 name t0 type macvlan} {} 0}] macvtap t0} \
    macvtap/x

###############################################################################
# 8. the ipvlan and ipvtap rows' states
###############################################################################
check ipvlan_after_macvtap "positive: ipvlan's rows follow macvtap's, and ipvtap's ipvlan's" \
    {list [lsearch -glob [slugs $R] ipvlan/*] [lsearch -glob [slugs $R] ipvtap/*]} {170 188}
check ipvlan_mode_rows "positive: one add_mode_ row per mode, each once" \
    {word_rows ipvlan "ip link add link d0 name i0 type ipvlan" mode_} [join $ipvlan_modes " "]
check ipvlan_flag_rows "positive: one add_ row per flag word, each once" \
    {word_rows ipvlan "ip link add link d0 name i0 type ipvlan" ""} [join $ipvlan_flags " "]
check ipvlan_word_counts "boundary: 3 modes and 3 flag words" \
    {list [llength $ipvlan_modes] [llength $ipvlan_flags]} {3 3}
check ipvlan_default "positive: add_default sends no option, on d0" \
    {field ipvlan/add_default 3} {ip link add link d0 name i0 type ipvlan}
check ipvlan_two_flags "corner: two flag words is ip's refusal: rc 1, floor 0, no readback" \
    {list [field ipvlan/add_two_flags 3] [field ipvlan/add_two_flags 5] [field ipvlan/add_two_flags 1] [field ipvlan/add_two_flags 4]} \
    {{ip link add link d0 name i0 type ipvlan private vepa} 1 0 {}}
check ipvlan_busy_pre "corner: the busy lower's pre makes d0, then a macvlan m0 on it" \
    {field ipvlan/add_on_busy_lower 2} \
    {{link add d0 type dummy} {link add link d0 name m0 type macvlan mode bridge}}
check ipvlan_set_mode_pre "corner: set_mode sends a mode alone to an i0 made private" \
    {list [lindex [field ipvlan/set_mode 2] end] [field ipvlan/set_mode 3]} \
    {{link add link d0 name i0 type ipvlan private} {ip link set i0 type ipvlan mode l2}}
check ipvlan_no_link "negative: the no-link row names no lower" \
    {field ipvlan/add_no_link 3} {ip link add name i0 type ipvlan}
check ipvlan_returned_vs_exit "corner: the mode error and an unknown word return (1); NEXT_ARG exits (255)" \
    {lmap s {add_mode_bad add_unknown add_no_value} {field ipvlan/$s 5}} {1 1 255}
check ipvtap_kind "corner: every ipvtap row adds or sets j0 as an ipvtap" \
    {strays $R ipvtap j0} {}
check ipvtap_kind_caught "negative: an ipvtap row sent as ipvlan is listed" \
    {strays [list {ipvtap/x 4 {} {ip link add link d0 name j0 type ipvlan} {} 0}] ipvtap j0} \
    ipvtap/x

###############################################################################
# 9. the vxlan rows' states
###############################################################################
set vxlan_head "ip link add vx0 type vxlan id 42 dstport 4789"
check vxlan_after_ipvtap "positive: vxlan's rows follow ipvtap's" \
    {lsearch -glob [slugs $R] vxlan/*} 192
check vxlan_flag_rows "positive: one add_ row per flag word, each once" \
    {word_rows vxlan $vxlan_head ""} [join $vxlan_flags " "]
check vxlan_df_rows "positive: one add_df_ row per df value" \
    {word_rows vxlan $vxlan_head df_} [join $vxlan_df " "]
check vxlan_word_counts "boundary: 13 flags and 3 df values" \
    {list [llength $vxlan_flags] [llength $vxlan_df]} {13 3}
check vxlan_id_range "boundary: the VNI's top is accepted; one over is ip's invarg" \
    {list [field vxlan/add_id_max 3] [field vxlan/add_id_max 5] [field vxlan/add_id_over 3] [field vxlan/add_id_over 5]} \
    {{ip link add vx0 type vxlan id 16777215 dstport 4789} 0 {ip link add vx0 type vxlan id 16777216} 255}
check vxlan_dstport "corner: only add_default and the external rows that don't name one send no dstport" \
    {vxlan_no_dstport} {vxlan/add_default vxlan/add_external vxlan/add_gpe}
check vxlan_dev_pre "corner: every row naming dev d0 makes it first" \
    {dev_d0_pres} {{link add d0 type dummy}}
check vxlan_duplicate "corner: the duplicate's pre holds vx0 with id 42, and its readbacks read vx1" \
    {list [field vxlan/add_duplicate_vni 2] [field vxlan/add_duplicate_vni 3] [lindex [field vxlan/add_duplicate_vni 4] 0 2]} \
    {{{link add vx0 type vxlan id 42 dstport 4789}} {ip link add vx1 type vxlan id 42 dstport 4789} {ip -d link show dev vx1}}
check vxlan_set_pre "positive: every set acts on a vx0 its pre made" \
    {lsort -unique [lmap r $R {expr {[string match vxlan/set_* [lindex $r 0]] ? [lindex $r 2 end] : "-"}}]} \
    {- {link add vx0 type vxlan id 42 dstport 4789}}
check vxlan_get_addr "corner: get_addr's failure exits 1, invarg's 255" \
    {list [field vxlan/add_remote_bad 5] [field vxlan/add_remote_multicast 5]} {1 255}

###############################################################################
# 10. the geneve rows' states
###############################################################################
check geneve_after_vxlan "positive: geneve's rows follow vxlan's" \
    {lsearch -glob [slugs $R] geneve/*} 265
check geneve_local_one_keyword "positive: one keyword, local, sends either family" \
    {lmap s {add_local add_local6} {lrange [field geneve/$s 3] end-1 end}} \
    {{local 10.0.0.2} {local 2001:db8::2}}
check geneve_local_refused "corner: local6 and loc are ip's refusals: rc 1, floor 0" \
    {lmap s {add_local6_word add_local_abbrev} {list [field geneve/$s 5] [field geneve/$s 1]}} \
    {{1 0} {1 0}}
check geneve_conflict_pres "corner: the conflict rows' pres make gn0 with the base, external, external" \
    {lmap s {add_duplicate add_after_external set_on_external} {lindex [field geneve/$s 2] end}} \
    {{link add gn0 type geneve id 1 remote 10.0.0.1} {link add gn0 type geneve external} {link add gn0 type geneve external}}
check geneve_conflict_readbacks "corner: their readbacks read gn1, gn1, gn0" \
    {lmap s {add_duplicate add_after_external set_on_external} {lindex [field geneve/$s 4] 0 2}} \
    {{ip -d link show dev gn1} {ip -d link show dev gn1} {ip -d link show dev gn0}}
check geneve_id_range "boundary: the VNI's top is accepted; one over is ip's invarg" \
    {list [field geneve/add_id_max 5] [field geneve/add_id_over 5]} {0 255}
check geneve_set_needs_id "negative: a set without id is ip's refusal; with it the kernel's" \
    {list [field geneve/set_no_id 5] [field geneve/set_id 5]} {1 2}

###############################################################################
# 11. the bareudp and amt rows' states
###############################################################################
check bareudp_after_geneve "positive: bareudp's rows follow geneve's, and amt's bareudp's" \
    {list [lsearch -glob [slugs $R] bareudp/*] [lsearch -glob [slugs $R] amt/*]} {314 330}
check required_option_owner "corner: a missing required option is ip's for bareudp and the kernel's for amt" \
    {list [field bareudp/add_no_dstport 5] [field amt/add_no_link 5]} {255 2}
check bareudp_busy_pre "corner: the busy port's pre makes b0 on port 6635" \
    {field bareudp/add_port_busy 2} {{link add b0 type bareudp dstport 6635 ethertype ip}}
check bareudp_busy_readbacks "corner: its readbacks read b1" \
    {lmap rb [field bareudp/add_port_busy 4] {lindex $rb 2}} \
    {{ip -d link show dev b1} {ip -d -j -p link show dev b1} {ip link show dev b1}}
check no_changelink_sets "corner: the sets are refused by the kernel, on a device the pre made" \
    {lmap s {bareudp/set_same amt/set_same} {list [field $s 5] [lindex [split [lindex [field $s 2] end]] 2]}} \
    {{2 b0} {2 a0}}
check amt_lower "corner: every amt row the kernel answers, but add_no_option and add_no_link, names a lower" \
    {amt_no_lower} {}
check amt_lower_excluded "negative: the two left out name none" \
    {lmap s {add_no_option add_no_link} {regexp { dev } [field amt/$s 3]}} {0 0}
check keyword_matching "positive: bareudp's keywords are matches, amt's strcmp" \
    {list [field bareudp/add_abbrev 5] [field amt/add_abbrev 5]} {0 1}

###############################################################################
# 12. the gtp rows' states
###############################################################################
check gtp_after_amt "positive: gtp's rows follow amt's" \
    {lsearch -glob [slugs $R] gtp/*} 350
check gtp_hsize_top "boundary: the hash size's top is accepted; 1<<17 is ip's invarg" \
    {lmap s {add_hsize_max add_hsize_over} {list [lindex [field gtp/$s 3] end] [field gtp/$s 5]}} \
    {{131071 0} {131072 255}}
check gtp_unknown_vs_abbrev "corner: an unknown word is skipped; an abbreviated role is too, so the role is missing" \
    {list [field gtp/add_unknown_skipped 5] [field gtp/add_abbrev 5]} {0 1}
check gtp_second_pre "corner: the second device's pre makes g0 as a ggsn" \
    {field gtp/add_second 2} {{link add g0 type gtp role ggsn}}
check gtp_second_readbacks "corner: its readbacks read g1" \
    {lmap rb [field gtp/add_second 4] {lindex $rb 2}} \
    {{ip -d link show dev g1} {ip -d -j -p link show dev g1} {ip link show dev g1}}
check gtp_sets_on_g0 "corner: every set acts on the g0 its pre made" \
    {lmap s {set_same set_no_option set_no_role} {list [lindex [field gtp/$s 3] 3] [field gtp/$s 2]}} \
    {{g0 {{link add g0 type gtp role ggsn}}} {g0 {{link add g0 type gtp role ggsn}}} {g0 {{link add g0 type gtp role ggsn}}}}

###############################################################################
# 13. the gre, gretap and erspan rows' states
###############################################################################
check gre_after_gtp "positive: gre's rows follow gtp's, then gretap's, then erspan's" \
    {lmap k {gre gretap erspan} {lsearch -glob [slugs $R] $k/*}} {369 414 425}
check bare_type_accepted "positive: a bare type <kind> is accepted by all three, sending no word" \
    {lmap k {gre gretap erspan} {list [field $k/add_no_option 5] [lindex [field $k/add_no_option 3] end]}} \
    {{0 gre} {0 gretap} {0 erspan}}
check erspan_ranges "boundary: erspan's index top is ip's, the key's and hwid's the kernel's" \
    {lmap s {add_index_max add_index_over add_key_max add_key_over add_hwid_max add_hwid_over} {field erspan/$s 5}} \
    {0 255 0 2 0 2}
check gre_ttl_tos_tops "boundary: gre's ttl and tos tops are accepted, one past is ip's invarg" \
    {lmap s {add_ttl_max add_ttl_over add_tos_max add_tos_over} {field gre/$s 5}} {0 255 0 255}
check remote_any "corner: the remote going to any is refused on gre and accepted on gretap" \
    {list [field gre/set_remote_any 5] [field gretap/set_remote_any 5]} {2 0}
check prefetch_sets "corner: the prefetch shapes a set: an external gr0, a dummy d0, a keyed es0" \
    {lmap s {gre/set_on_external gre/set_not_a_tunnel erspan/set_index} {list [field $s 5] [lindex [field $s 2] end]}} \
    {{0 {link add gr0 type gre external}} {1 {link add d0 type dummy}} {0 {link add es0 type erspan remote 10.0.0.1 seq key 10}}}
check conflict_pres "corner: the conflict rows' pres make the device they collide with" \
    {lmap s {add_duplicate add_second_keyed add_second_external set_collide set_pmtudisc_ignore_df} {field gre/$s 2}} \
    {{{link add gr0 type gre remote 10.0.0.1}} {{link add gr0 type gre remote 10.0.0.1}} {{link add gr0 type gre external}} {{link add gr0 type gre remote 10.0.0.1} {link add gr1 type gre remote 10.0.0.2}} {{link add gr0 type gre remote 10.0.0.1 nopmtudisc ignore-df}}}
check conflict_readbacks "corner: their readbacks read the device the command names" \
    {lmap s {add_duplicate add_second_keyed add_second_external set_collide set_pmtudisc_ignore_df} {lindex [lindex [field gre/$s 4] 0] 2}} \
    {{ip -d link show dev gr1} {ip -d link show dev gr1} {ip -d link show dev gr1} {ip -d link show dev gr1} {ip -d link show dev gr0}}
check gre_d0_first "corner: the rows naming d0 make it first" \
    {lmap s {add_dev set_dev set_not_a_tunnel} {lindex [field gre/$s 2] 0}} \
    {{link add d0 type dummy} {link add d0 type dummy} {link add d0 type dummy}}
check key_exits "corner: get_addr32's failure is 1, tnl_parse_key's 255" \
    {list [field gre/add_key_dotted_bad 5] [field gre/add_key_bad 5]} {1 255}
check foreign_words "negative: the erspan words on another kind, and the help text's encap-csum6, are ip's refusals" \
    {lmap s {gre/add_erspan_word gretap/add_erspan_word gre/add_encap_csum6_word} {list [field $s 5] [field $s 1]}} \
    {{1 0} {1 0} {1 0}}

###############################################################################
# 14. the ip6gre, ip6gretap and ip6erspan rows' states
###############################################################################
check ip6gre_after_erspan "positive: ip6gre's rows follow erspan's, then ip6gretap's, then ip6erspan's" \
    {lmap k {ip6gre ip6gretap ip6erspan} {lsearch -glob [slugs $R] $k/*}} {450 486 495}
check ip6gre_no_repeat_check "negative: a repeated keyword is no refusal" \
    {field ip6gre/add_repeat 5} 0
check ip6_tops "boundary: the tops ip and the kernel take, and the first values each refuses" \
    {lmap s {ip6gre/add_tops ip6gre/add_hoplimit_over ip6gre/add_flowlabel_over ip6erspan/add_index_max ip6erspan/add_index_over ip6erspan/add_key_max ip6erspan/add_key_over} {field $s 5}} \
    {0 255 255 0 255 0 2}
check ip6_bare_rows "corner: the no-option rows are the only ones that end at type <kind>" \
    {bare_rows {ip6gre ip6gretap ip6erspan}} \
    {ip6gre/add_no_option ip6gre/set_no_option ip6gretap/add_no_option ip6erspan/add_no_option}
check ip6_bare_accepted "corner: all three kinds accept one" \
    {lmap s [bare_rows {ip6gre ip6gretap ip6erspan}] {field $s 5}} {0 0 0 0}
check erspan_ver_zero "corner: erspan_ver 0 is accepted by ip6gre and refused by ip6erspan" \
    {list [field ip6gre/add_erspan_ver_zero 5] [field ip6erspan/add_ver_zero 5]} {0 2}
check ip6gre_key_exits "corner: a dotted key's failure is 1, a numeric key's 255" \
    {list [field ip6gre/add_key_dotted_bad 5] [field ip6gre/add_key_bad 5]} {1 255}
check ip6_collision_pres "corner: the collision rows' pres make the device they collide with" \
    {lmap s {ip6gre/add_duplicate ip6gre/add_second_key ip6gre/add_external_twice ip6gre/set_collide ip6gretap/add_beside_ip6gre ip6gretap/set_collide_unchecked ip6gretap/add_duplicate ip6gretap/add_external_beside_ip6gre} {field $s 2}} \
    {{{link add g6 type ip6gre remote 2001:db8::1}} {{link add g6 type ip6gre remote 2001:db8::1}} {{link add g6 type ip6gre external}} {{link add g6 type ip6gre remote 2001:db8::1} {link add g7 type ip6gre remote 2001:db8::2}} {{link add g6 type ip6gre remote 2001:db8::1}} {{link add gt6 type ip6gretap remote 2001:db8::1} {link add gt7 type ip6gretap remote 2001:db8::2}} {{link add gt6 type ip6gretap remote 2001:db8::1}} {{link add g6 type ip6gre external}}}
check ip6_collision_readbacks "corner: their readbacks read the device the command names" \
    {lmap s {ip6gre/add_duplicate ip6gre/add_second_key ip6gre/add_external_twice ip6gre/set_collide ip6gretap/add_beside_ip6gre ip6gretap/set_collide_unchecked ip6gretap/add_duplicate ip6gretap/add_external_beside_ip6gre} {lindex [split [lindex [lindex [field $s 4] 0] 2]] end}} \
    {g7 g7 g7 g7 gt6 gt7 gt7 gt6}
check ip6_set_collide "corner: the same collision on a set is refused by ip6gre and accepted by ip6gretap" \
    {list [field ip6gre/set_collide 5] [field ip6gretap/set_collide_unchecked 5]} {2 0}
check ip6gre_d0_first "corner: the rows naming d0 make it first" \
    {lmap s {add_dev set_not_tunnel} {lindex [field ip6gre/$s 2] 0}} \
    {{link add d0 type dummy} {link add d0 type dummy}}
check ip6gre_sport_swap_pre "corner: the port-swap row's pre sets the source port" \
    {field ip6gre/set_encap_sport_swap 2} {{link add g6 type ip6gre remote 2001:db8::1 encap-sport 4660}}

###############################################################################
# 15. the ipip and sit rows' states
###############################################################################
check ipip_after_ip6erspan "positive: ipip's rows follow ip6erspan's, and sit's ipip's" \
    {lmap k {ipip sit} {lsearch -glob [slugs $R] $k/*}} {514 561}
check iptnl_mode_rows "positive: one accepted add_mode_ row per mode word" \
    {lmap k {ipip sit} d {ip0 st0} {
        set ws {}
        foreach w [word_rows $k "ip link add $d type $k remote 10.0.0.1" mode_] {
            if {[field $k/add_mode_$w 5] == 0} {
                lappend ws $w
            }
        }
        set ws
    }} \
    {{ipip mplsip any} {ip6ip ipip mplsip any}}
check iptnl_ttl_tops "boundary: the ttl's top, and the smallest ttl nopmtudisc refuses" \
    {lmap s {ipip/add_ttl ipip/add_ttl_over sit/add_ttl_nopmtudisc} {field $s 5}} {0 255 255}
check iptnl_prefetch_ttl "corner: a nopmtudisc set depends on the prefetched ttl" \
    {lmap s {set_nopmtudisc set_nopmtudisc_ttl} {list [field ipip/$s 5] [field ipip/$s 2]}} \
    {{0 {{link add ip0 type ipip remote 10.0.0.1}}} {255 {{link add ip0 type ipip remote 10.0.0.1 ttl 64}}}}
check sit_words "corner: isatap and mode ip6ip are sit's words" \
    {lmap s {ipip/add_isatap ipip/add_mode_ip6ip sit/add_isatap sit/add_mode_ip6ip} {field $s 5}} {1 255 0 0}
check sit_6rd "corner: the 6rd words are accepted wherever the prefix parses, and ip's refusal (1) where it doesn't" \
    {lmap s {ipip/add_6rd_ignored sit/add_6rd_overlong sit/add_6rd_prefix_v4} {field $s 5}} {0 0 1}
check iptnl_set_unapplied "corner: a set of mode or isatap is accepted" \
    {lmap s {ipip/set_mode sit/set_mode sit/set_isatap} {field $s 5}} {0 0 0}
check iptnl_pres "corner: the conflict and set rows' pres" \
    {lmap s {ipip/add_duplicate sit/add_duplicate ipip/add_external_second sit/add_duplicate_wildcard ipip/set_collide sit/set_collide ipip/set_on_external ipip/set_remote_on_wildcard sit/set_remote_on_wildcard sit/set_external_wildcard} {field $s 2}} \
    {{{link add ip0 type ipip remote 10.0.0.1}} {{link add st0 type sit remote 10.0.0.1}} {{link add ip0 type ipip external}} {{link add st0 type sit}} {{link add ip0 type ipip remote 10.0.0.1} {link add ip1 type ipip remote 10.0.0.2}} {{link add st0 type sit remote 10.0.0.1} {link add st1 type sit remote 10.0.0.2}} {{link add ip0 type ipip external}} {{link add ip0 type ipip}} {{link add st0 type sit}} {{link add st0 type sit}}}
check iptnl_second_readbacks "corner: the conflicting adds' readbacks read ip1 or st1" \
    {lmap s {ipip/add_duplicate ipip/add_external_second sit/add_duplicate sit/add_duplicate_wildcard} {lindex [split [lindex [lindex [field $s 4] 0] 2]] end}} \
    {ip1 ip1 st1 st1}
check iptnl_d0_first "corner: the rows naming d0 make it first" \
    {lmap s {ipip/add_dev ipip/set_dev sit/add_local_dev} {lindex [field $s 2] 0}} \
    {{link add d0 type dummy} {link add d0 type dummy} {link add d0 type dummy}}
check sit_wildcard_prefetch "corner: a set's prefetch of sit's wildcard exits 255, and of a ttl inherit sit reaches the kernel" \
    {lmap s {set_external_wildcard set_remote_on_wildcard set_remote_on_inherit} {list [field sit/$s 5] [field sit/$s 2]}} \
    {{255 {{link add st0 type sit}}} {255 {{link add st0 type sit}}} {2 {{link add st0 type sit ttl inherit}}}}
check no_6rd_reset "negative: no row sends 6rd-reset, which segfaults ip" \
    {llength [lsearch -all -glob [lmap r $R {lindex $r 3}] *6rd-reset*]} 0
check iptnl_exits "corner: get_addr's and get_prefix's failures are 1, invarg's 255" \
    {lmap s {ipip/add_remote6 sit/add_6rd_prefix_v4 ipip/add_tos_over} {field $s 5}} {1 1 255}

###############################################################################
# 16. the ip6tnl rows' states
###############################################################################
check ip6tnl_after_sit "positive: ip6tnl's rows follow sit's" \
    {lsearch -glob [slugs $R] ip6tnl/*} 598
check ip6tnl_mode_rows "positive: one accepted add_mode_ row per mode word" \
    {set ws {}
     foreach w [word_rows ip6tnl "ip link add t6 type ip6tnl remote 2001:db8::1" mode_] {
         if {[field ip6tnl/add_mode_$w 5] == 0} {
             lappend ws $w
         }
     }
     set ws} \
    {ip6ip6 ipip6 any}
check ip6tnl_tops "boundary: the label's and hop limit's tops" \
    {lmap s {add_flowlabel add_flowlabel_over add_hoplimit add_hoplimit_over} {field ip6tnl/$s 5}} {0 255 0 255}
check ip6tnl_encap_words "corner: encap takes a type and encaplimit is exact" \
    {list [field ip6tnl/add_encap_abbrev 5] [field ip6tnl/add_encaplimit_abbrev 5]} {255 1}
check ip6tnl_prefetch_pre "corner: the set prefetch's row makes t6 with hoplimit 10 and sets only tclass" \
    {list [field ip6tnl/set_keeps_prefetch 2] [field ip6tnl/set_keeps_prefetch 3]} \
    {{{link add t6 type ip6tnl remote 2001:db8::1 hoplimit 10}} {ip link set t6 type ip6tnl tclass 0x20}}
check ip6tnl_set_mode "corner: unlike ipip and sit, a set of mode is accepted on the tunnel" \
    {list [field ip6tnl/set_mode 5] [field ip6tnl/set_mode 3]} {0 {ip link set t6 type ip6tnl mode ipip6}}
check ip6tnl_pres "corner: the conflict rows' pres" \
    {lmap s {add_duplicate add_duplicate_wildcard add_external_second set_collide set_on_external} {field ip6tnl/$s 2}} \
    {{{link add t6 type ip6tnl remote 2001:db8::1}} {{link add t6 type ip6tnl}} {{link add t6 type ip6tnl external}} {{link add t6 type ip6tnl remote 2001:db8::1} {link add t7 type ip6tnl remote 2001:db8::2}} {{link add t6 type ip6tnl external}}}
check ip6tnl_second_readbacks "corner: the conflicting adds' readbacks read t7" \
    {lmap s {add_duplicate add_duplicate_wildcard add_external_second} {lindex [split [lindex [lindex [field ip6tnl/$s 4] 0] 2]] end}} \
    {t7 t7 t7}
check ip6tnl_d0_first "corner: add_dev's pre makes d0" \
    {field ip6tnl/add_dev 2} {{link add d0 type dummy}}

###############################################################################
# 17. the vti, vti6 and xfrm rows' states
###############################################################################
check vti_after_ip6tnl "positive: vti's rows follow ip6tnl's, then vti6's, then xfrm's" \
    {lmap k {vti vti6 xfrm} {lsearch -glob [slugs $R] $k/*}} {647 670 682}
check vti_abbrev "positive: each keyword's abbreviation is accepted" \
    {list [field vti/add_abbrev 5] [field xfrm/add_abbrev 5]} {0 0}
check vti_key_range "boundary: the key's range" \
    {lmap s {add_key_max add_key_over} {list [lindex [field vti/$s 3] end] [field vti/$s 5]}} \
    {{4294967295 0} {4294967296 255}}
check xfrm_if_id_range "boundary: the if_id's range" \
    {lmap s {add_if_id_zero add_if_id_max add_if_id_over} {field xfrm/$s 5}} {255 0 255}
check vti_p2p "corner: vti refuses the point-to-point change that vti6 allows" \
    {list [field vti/set_remote_on_any 5] [field vti6/set_remote_on_any 5]} {2 0}
check vti_lower_key "corner: a lower separates two vti tunnels but not two vti6 ones, and a key separates neither" \
    {lmap s {vti/add_second_other_dev vti6/add_duplicate_other_dev vti/add_duplicate_other_key} {field $s 5}} {0 2 2}
check vti_set_keeps "corner: a vti or vti6 set keeps what the device has; an xfrm set naming no dev drops it" \
    {lmap s {vti/set_fwmark vti6/set_fwmark xfrm/set_drop_dev} {list [field $s 5] [regexp { dev } [field $s 3]] [lindex [field $s 2] end]}} \
    {{0 0 {link add vt0 type vti remote 10.0.0.1}} {0 0 {link add v6 type vti6 remote 2001:db8::1}} {2 0 {link add xf0 type xfrm dev d0 if_id 1}}}
check vti_prefetch_fail "corner: the vti prefetch's failure is ip's" \
    {list [field vti/set_on_dummy 5] [field vti/set_on_dummy 1] [field vti/set_on_dummy 2]} \
    {1 0 {{link add d0 type dummy}}}
check vti_bare_sets "corner: a bare set is accepted on all three" \
    {lmap k {vti vti6 xfrm} {list [field $k/set_no_option 5] [field $k/set_no_option 1] [lindex [field $k/set_no_option 3] end]}} \
    {{0 4 vti} {0 4 vti6} {0 4 xfrm}}
check vti_conflict_pres "corner: the conflict rows' pres make the first device, after d0 where named" \
    {lmap s {vti/add_second_other_dev vti/add_duplicate_other_key vti/add_duplicate_any vti/set_collide vti6/add_duplicate_other_dev vti6/set_collide xfrm/add_duplicate_other_dev xfrm/add_second_external xfrm/set_collide} {lmap step [field $s 2] {lindex $step 2}}} \
    {{d0 vt0} vt0 vt0 {vt0 vt1} {d0 v6} {v6 v7} {d0 xf0} xf0 {xf0 xf1}}
check vti_conflict_readbacks "corner: their readbacks read vt1, v7 or xf1" \
    {lmap s {vti/add_second_other_dev vti/add_duplicate_other_key vti/add_duplicate_any vti/set_collide vti6/add_duplicate_other_dev vti6/set_collide xfrm/add_duplicate_other_dev xfrm/add_second_external xfrm/set_collide} {lindex [split [lindex [lindex [field $s 4] 0] 2]] end}} \
    {vt1 vt1 vt1 vt1 v7 v7 xf1 xf1 xf1}
check vti_strcmp_words "corner: fwmark and external are strcmp" \
    {lmap s {vti/add_fwmark_abbrev vti6/add_fwmark_abbrev xfrm/add_external_abbrev} {field $s 5}} {1 1 1}
check vti_d0_first "corner: the rows naming dev d0 make it first" \
    {d0_not_first {vti vti6 xfrm}} {}
check vti_d0_first_listed "negative: a row naming d d0 without making it is listed" \
    {set saved $R
     set R [list {vti/x 2 {} {ip link add vt0 type vti d d0} {} 0}]
     set got [d0_not_first vti]
     set R $saved
     set got} \
    vti/x
check xfrm_ip_checks "negative: ip's xfrm checks stop before the kernel" \
    {lmap s {add_external_if_id add_no_if_id} {list [field xfrm/$s 5] [field xfrm/$s 1] [field xfrm/$s 4]}} \
    {{1 0 {}} {255 0 {}}}

###############################################################################
# summary
###############################################################################
puts ""
puts "=== kind-write-corpus.exp: $pass passed, $fail failed ==="
if {$fail > 0} {
    puts "KINDCORPUS_TEST_FAIL"
    exit 1
}
puts "KINDCORPUS_TEST_PASS"
exit 0

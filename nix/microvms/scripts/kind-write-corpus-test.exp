#!/usr/bin/env expect
###############################################################################
# kind-write-corpus-test.exp - table-driven test for kind-write-corpus.exp,
# with no microVM and no console
#
# Usage: kind-write-corpus-test.exp
#
# Run by nix/checks/vm-lib-exp.nix after xfrm-write-corpus-test.exp, the
# same way: the corpus is data, and its procs (readbacks, row,
# readback_args, rc_problem) need no shell.
#
# The slugs, statuses and option keywords are written out again below as
# literals rather than read from the corpus, so a row dropped or changed
# there has to disagree with something that was not edited with it.
#
# What this does NOT cover: what the guest runs or what the kernel answers.
# The KP phases' parser tests pin that in the committed fixtures.
#
# Every row has a name, a description that starts with its class
# (positive/negative/boundary/corner) and an expected value.
###############################################################################

set here [file dirname [info script]]
source $here/kind-write-corpus.exp

set pass 0
set fail 0

# check <name> <description> <script> <expected> - the script's result, or
# ERROR if it raised one, must equal expected.
proc check {name description script expected} {
    global pass fail
    if {[catch {uplevel #0 $script} got]} {
        set got ERROR
    }
    if {$got eq $expected} {
        puts "PASS: $name - $description"
        incr pass
    } else {
        puts "FAIL: $name - $description"
        puts "      got \[$got\] want \[$expected\]"
        incr fail
    }
}

set R $kindcorpus::rows

proc slugs {rows} {
    set out {}
    foreach r $rows {
        lappend out [lindex $r 0]
    }
    return $out
}

proc field {slug i} {
    return [lindex [lsearch -exact -index 0 -inline $::R $slug] $i]
}

# readback_names <slug> - the names of a row's readbacks, in order.
proc readback_names {slug} {
    set out {}
    foreach rb [field $slug 4] {
        lappend out [lindex $rb 0]
    }
    return $out
}

# bad_arity <rows> - the rows that are not six fields.
proc bad_arity {rows} {
    set out {}
    foreach r $rows {
        if {[llength $r] != 6} {
            lappend out [lindex $r 0]
        }
    }
    return $out
}

# dup_slugs <rows> - every slug that names more than one row.
proc dup_slugs {rows} {
    set seen {}
    set out {}
    foreach s [slugs $rows] {
        if {[dict exists $seen $s]} {
            lappend out $s
        }
        dict set seen $s 1
    }
    return $out
}

# refused_rows - {slug rc} for every row whose ip.rc is meant to be non-zero.
proc refused_rows {} {
    set out {}
    foreach r $::R {
        if {[lindex $r 5] != 0} {
            lappend out [lindex $r 0] [lindex $r 5]
        }
    }
    return $out
}

# bad_rc <rows> - every row whose status is not 0, 1, 2 or 255, which is all
# ip exits with.
proc bad_rc {rows} {
    set out {}
    foreach r $rows {
        if {[lindex $r 5] ni {0 1 2 255}} {
            lappend out [lindex $r 0]
        }
    }
    return $out
}

# bad_floors <rows> - rows under their structural floor: an ip-refused row
# (1 or 255) is 0 with no readback, an add 2, a set 4 (the name lookup),
# and every readback 2.
proc bad_floors {rows} {
    set out {}
    foreach r $rows {
        lassign $r slug floor pre command readbacks rc
        if {$rc in {1 255}} {
            if {$floor != 0 || [llength $readbacks] != 0} {
                lappend out $slug
            }
            continue
        }
        set want 2
        if {[string match "ip link set *" $command]} {
            set want 4
        }
        if {$floor < $want} {
            lappend out $slug
        }
        foreach rb $readbacks {
            if {[lindex $rb 1] < 2} {
                lappend out $slug/[lindex $rb 0]
            }
        }
    }
    return $out
}

# quoted - every command or readback holding a single quote, which
# write_row's quoting cannot carry.
proc quoted {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command readbacks
        if {[string first ' $command] >= 0} {
            lappend out $slug
        }
        foreach rb $readbacks {
            if {[string first ' [lindex $rb 2]] >= 0} {
                lappend out $slug/[lindex $rb 0]
            }
        }
    }
    return $out
}

# add_options - the option keyword of every bridge add_<option> row named
# after it, in order.
proc add_options {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command
        if {![regexp {^bridge/add_(.*)$} $slug -> name]} {
            continue
        }
        if {[regexp "^ip link add br0 type bridge (?:vlan_filtering 1 )?$name \\S+\$" $command]} {
            lappend out $name
        }
    }
    return $out
}

# set_options - the option keyword of every bridge_slave set_<option> row
# named after it, in order.
proc set_options {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command
        if {![regexp {^bridge_slave/set_(.*)$} $slug -> name]} {
            continue
        }
        if {[regexp "^ip link set dev p0 type bridge_slave (?:locked on )?$name \\S+\$" $command]} {
            lappend out $name
        }
    }
    return $out
}

# vlan_flags - the flag keyword of every vlan add_<flag> row named after
# it, in order.
proc vlan_flags {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command
        if {![regexp {^vlan/add_(.*)$} $slug -> name]} {
            continue
        }
        if {[regexp "^ip link add link d0 name v0 type vlan id 10 $name (?:on|off)\$" $command]} {
            lappend out $name
        }
    }
    return $out
}

# macvlan_modes - the mode of every macvlan add_mode_<mode> row named
# after it, in order.
proc macvlan_modes {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command
        if {![regexp {^macvlan/add_mode_(.*)$} $slug -> name]} {
            continue
        }
        if {$command eq "ip link add link d0 name m0 type macvlan mode $name"} {
            lappend out $name
        }
    }
    return $out
}

# strays <rows> <kind> <dev> - the <kind> rows whose command is not an
# add or a set of <dev> as a <kind>.
proc strays {rows kind dev} {
    set out {}
    foreach r $rows {
        lassign $r slug floor pre command
        if {![string match $kind/* $slug]} {
            continue
        }
        if {![regexp "^ip link (?:add link d0 name $dev|set $dev) type ${kind}(?: |\$)" $command]} {
            lappend out $slug
        }
    }
    return $out
}

# word_rows <kind> <head> <prefix> - <word> for every <kind>
# add_<prefix><word> row whose command is <head> then "<prefix as
# words><word>", in order: mode_ for "mode <word>", "" for "<word>".
proc word_rows {kind head prefix} {
    set out {}
    set words [string map {_ " "} $prefix]
    foreach r $::R {
        lassign $r slug floor pre command
        if {![regexp "^$kind/add_${prefix}(.*)\$" $slug -> name]} {
            continue
        }
        if {$command eq "$head $words$name"} {
            lappend out $name
        }
    }
    return $out
}

# vxlan_no_dstport - the accepted vxlan adds that send no dstport.
proc vxlan_no_dstport {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command readbacks rc
        if {[string match vxlan/add_* $slug] && $rc == 0 && ![string match *dstport* $command]} {
            lappend out $slug
        }
    }
    return $out
}

# dev_d0_pres - the distinct first pre steps of the vxlan rows that name
# dev d0.
proc dev_d0_pres {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command
        if {[string match vxlan/* $slug] && [string match {* dev d0*} $command]} {
            lappend out [lindex $pre 0]
        }
    }
    return [lsort -unique $out]
}

###############################################################################
# 1. the rows
###############################################################################
set bridge_options {
    forward_delay hello_time max_age ageing_time stp_state priority
    vlan_filtering vlan_protocol group_fwd_mask group_address
    no_linklocal_learn mst_enabled fdb_max_learned vlan_default_pvid
    vlan_stats_enabled vlan_stats_per_port mcast_router mcast_snooping
    mcast_vlan_snooping mcast_query_use_ifaddr mcast_querier
    mcast_hash_elasticity mcast_hash_max mcast_last_member_count
    mcast_startup_query_count mcast_last_member_interval
    mcast_membership_interval mcast_querier_interval mcast_query_interval
    mcast_query_response_interval mcast_startup_query_interval
    mcast_stats_enabled mcast_igmp_version mcast_mld_version
    nf_call_iptables nf_call_ip6tables nf_call_arptables
    mdb_offload_fail_notification fdb_local_vlan_0
}
set design_rows [list bridge/add_default]
foreach o $bridge_options {
    lappend design_rows bridge/add_$o
}
lappend design_rows {*}{
    bridge/add_fdb_flush bridge/add_stp_mode_auto bridge/add_stp_mode_user
    bridge/add_stp_mode_kernel bridge/add_boolopts bridge/add_several
    bridge/set_ageing_time bridge/set_vlan_filtering bridge/set_stp_mode
    bridge/set_stp_mode_busy bridge/add_abbrev bridge/add_stp_mode_abbrev
    bridge/add_group_address_bad bridge/add_group_fwd_mask_bad
    bridge/add_igmp_version_bad bridge/add_mcast_vlan_snooping_no_vlan
    bridge/add_stp_mode_bad bridge/add_vlan_protocol_bad
    bridge/add_priority_bad bridge/add_no_value
}
set slave_options {
    state priority cost hairpin guard root_block fastleave learning flood
    mcast_flood bcast_flood mcast_to_unicast proxy_arp proxy_arp_wifi
    mcast_router mcast_fast_leave neigh_suppress neigh_vlan_suppress
    group_fwd_mask vlan_tunnel isolated locked mab backup_nhid
}
foreach o $slave_options {
    lappend design_rows bridge_slave/set_$o
}
lappend design_rows {*}{
    bridge_slave/set_fdb_flush bridge_slave/set_nobackup_port
    bridge_slave/set_neigh_forward_grat bridge_slave/set_backup_port
    bridge_slave/set_several bridge_slave/set_abbrev
    bridge_slave/set_strcmp_abbrev bridge_slave/set_state_bad
    bridge_slave/set_priority_over bridge_slave/set_cost_zero
    bridge_slave/set_group_fwd_mask_bad bridge_slave/set_mab_unlocked
    bridge_slave/set_backup_port_self bridge_slave/set_not_enslaved
    bridge_slave/set_backup_port_missing bridge_slave/set_cost_bad
    bridge_slave/set_on_off_bad bridge_slave/set_no_value
}
set vlan_flags {reorder_hdr gvrp mvrp loose_binding bridge_binding}
lappend design_rows vlan/add_default vlan/add_protocol
foreach o $vlan_flags {
    lappend design_rows vlan/add_$o
}
lappend design_rows {*}{
    vlan/add_ingress_qos_map vlan/add_egress_qos_map vlan/add_several
    vlan/add_id_max vlan/add_abbrev vlan/set_flags vlan/set_egress_qos_map
    vlan/set_id vlan/add_no_id vlan/add_no_link vlan/add_id_over
    vlan/add_protocol_unsupported vlan/add_duplicate_id vlan/add_on_loopback
    vlan/add_on_off_bad vlan/add_unknown vlan/add_qos_no_colon
    vlan/add_id_bad vlan/add_protocol_bad vlan/add_qos_bad vlan/add_no_value
}
set macvlan_modes {private vepa bridge passthru source}
lappend design_rows macvlan/add_default
foreach m $macvlan_modes {
    lappend design_rows macvlan/add_mode_$m
}
lappend design_rows {*}{
    macvlan/add_flag_nodst macvlan/add_nodst macvlan/add_flag_null
    macvlan/add_passthru_nopromisc macvlan/add_bcqueuelen macvlan/add_bclim
    macvlan/add_bclim_negative macvlan/add_macaddr_add macvlan/add_macaddr_set
    macvlan/add_abbrev macvlan/set_mode macvlan/set_macaddr_del
    macvlan/set_macaddr_flush macvlan/set_bcqueuelen macvlan/set_passthru
    macvlan/add_macaddr_not_source macvlan/add_macaddr_multicast
    macvlan/add_second_passthru macvlan/add_on_loopback
    macvlan/add_nopromisc_not_passthru macvlan/add_mode_bad macvlan/add_flag_bad
    macvlan/add_macaddr_op_bad macvlan/add_macaddr_bad
    macvlan/add_bcqueuelen_bad macvlan/add_bclim_bad macvlan/add_bclim_abbrev
    macvlan/add_no_value
    macvtap/add_default macvtap/add_mode_bridge macvtap/add_mode_passthru
    macvtap/add_bcqueuelen macvtap/set_mode macvtap/add_mode_bad
}
set ipvlan_modes {l2 l3 l3s}
set ipvlan_flags {private vepa bridge}
lappend design_rows ipvlan/add_default
foreach m $ipvlan_modes {
    lappend design_rows ipvlan/add_mode_$m
}
foreach f $ipvlan_flags {
    lappend design_rows ipvlan/add_$f
}
lappend design_rows {*}{
    ipvlan/add_mode_and_flag ipvlan/add_abbrev ipvlan/set_mode ipvlan/set_flag
    ipvlan/add_no_link ipvlan/add_on_loopback ipvlan/add_on_busy_lower
    ipvlan/add_two_flags ipvlan/add_mode_bad ipvlan/add_unknown
    ipvlan/add_no_value
    ipvtap/add_default ipvtap/add_mode_l2 ipvtap/set_mode ipvtap/add_mode_bad
}
set vxlan_flags {
    proxy rsc l2miss l3miss noudpcsum udp6zerocsumtx udp6zerocsumrx
    remcsumtx remcsumrx nolearning nolocalbypass gbp mcroute
}
set vxlan_df {set unset inherit}
lappend design_rows {*}{
    vxlan/add_default vxlan/add_dstport vxlan/add_dstport_zero vxlan/add_id_zero
    vxlan/add_id_max vxlan/add_vni_abbrev vxlan/add_remote vxlan/add_remote6
    vxlan/add_group vxlan/add_group6 vxlan/add_local vxlan/add_local6_link_local
    vxlan/add_ttl vxlan/add_ttl_auto vxlan/add_ttl_inherit vxlan/add_tos
    vxlan/add_tos_inherit
}
foreach v $vxlan_df {
    lappend design_rows vxlan/add_df_$v
}
lappend design_rows {*}{
    vxlan/add_flowlabel vxlan/add_ageing vxlan/add_ageing_none
    vxlan/add_maxaddress vxlan/add_srcport
}
foreach f $vxlan_flags {
    lappend design_rows vxlan/add_$f
}
lappend design_rows {*}{
    vxlan/add_external vxlan/add_vnifilter vxlan/add_gpe vxlan/add_reserved_bits
    vxlan/add_no_abbrev vxlan/set_changeable vxlan/set_dev vxlan/set_id_same
    vxlan/add_no_option vxlan/add_duplicate_vni vxlan/add_link_local_no_dev
    vxlan/add_scope_mix vxlan/add_flowlabel_v4 vxlan/add_srcport_inverted
    vxlan/add_gpe_no_external vxlan/add_reserved_bits_overlap vxlan/set_id
    vxlan/set_dstport vxlan/set_proxy vxlan/set_family vxlan/add_no_id
    vxlan/add_group_no_dev vxlan/add_group_and_remote vxlan/add_external_and_id
    vxlan/add_vnifilter_no_external vxlan/add_remote_bad vxlan/add_strcmp_abbrev
    vxlan/add_unknown vxlan/add_id_over vxlan/add_remote_multicast
    vxlan/add_dev_missing vxlan/add_ttl_over vxlan/add_srcport_one
    vxlan/add_learning_twice vxlan/add_no_value
}
lappend design_rows {*}{
    geneve/add_default geneve/add_remote6 geneve/add_external geneve/add_id_max
    geneve/add_abbrev geneve/add_local geneve/add_local6
    geneve/add_external_local geneve/add_external_local6 geneve/add_ttl
    geneve/add_ttl_inherit geneve/add_tos geneve/add_df geneve/add_dstport
    geneve/add_dstport_zero geneve/add_flowlabel geneve/add_zero_csum6
    geneve/add_csum_cancel geneve/add_innerprotoinherit geneve/set_changeable
    geneve/set_remote geneve/set_local_same geneve/add_no_option
    geneve/add_remote6_link_local geneve/add_local6_link_local
    geneve/add_local_family_mix geneve/add_flowlabel_v4
    geneve/add_external_udpcsum geneve/add_duplicate geneve/add_after_external
    geneve/set_id geneve/set_dstport geneve/set_family geneve/set_local_new
    geneve/set_on_external geneve/add_no_id geneve/add_no_remote
    geneve/add_external_and_id geneve/set_no_id geneve/add_remote_bad
    geneve/add_local_abbrev geneve/add_local6_word geneve/add_id_over
    geneve/add_remote_multicast geneve/add_local_multicast geneve/add_ttl_over
    geneve/add_flowlabel_over geneve/add_external_twice geneve/add_no_value
}

check slug_list "positive: the rows are the plan's, in run order" \
    {slugs $R} [join $design_rows " "]
check first_row "boundary: add_default comes first" \
    {lindex [slugs $R] 0} bridge/add_default
check row_count "boundary: KC2's 60 bridge and 42 bridge_slave rows, KC3-T01's 28 vlan rows, KC3-T02's 34 macvlan and 6 macvtap rows, KC3-T03's 18 ipvlan and 4 ipvtap rows, KC4-T01's 73 vxlan rows, KC4-T02's 49 geneve rows" \
    {llength $R} 314
check bridge_first "boundary: bridge's rows all come before bridge_slave's" \
    {lsearch -glob [slugs $R] bridge_slave/*} 60
check option_rows "positive: one add_ row per value-taking option but stp_mode, each once" \
    {add_options} [join $bridge_options " "]
check option_count "boundary: 39 of them" \
    {llength $bridge_options} 39
check slave_option_rows "positive: one set_ row per value-taking port option, each once, then neigh_forward_grat's and backup_port's own" \
    {set_options} [join [concat $slave_options neigh_forward_grat backup_port] " "]
check slave_option_count "boundary: 24 of them" \
    {llength $slave_options} 24
check arity "negative: every row is {slug floor pre command readbacks rc}" \
    {bad_arity $R} {}
check arity_five "negative: a five-field row is listed" \
    {bad_arity [list {a 2 {} {ip link add br0 type bridge} {}}]} a
check unique_slugs "negative: no slug names two rows" \
    {dup_slugs $R} {}
check unique_dup "negative: a duplicated slug is listed" \
    {dup_slugs [list {a} {b} {a}]} a

###############################################################################
# 2. statuses
###############################################################################
set refused_design {
    bridge/set_stp_mode_busy 2 bridge/add_stp_mode_abbrev 1
    bridge/add_group_address_bad 2 bridge/add_group_fwd_mask_bad 2
    bridge/add_igmp_version_bad 2 bridge/add_mcast_vlan_snooping_no_vlan 2
    bridge/add_stp_mode_bad 1 bridge/add_vlan_protocol_bad 255
    bridge/add_priority_bad 255 bridge/add_no_value 255
    bridge_slave/set_strcmp_abbrev 1 bridge_slave/set_state_bad 2
    bridge_slave/set_priority_over 2 bridge_slave/set_cost_zero 2
    bridge_slave/set_group_fwd_mask_bad 2 bridge_slave/set_mab_unlocked 2
    bridge_slave/set_backup_port_self 2 bridge_slave/set_not_enslaved 2
    bridge_slave/set_backup_port_missing 255 bridge_slave/set_cost_bad 255
    bridge_slave/set_on_off_bad 1 bridge_slave/set_no_value 255
    vlan/add_no_id 2 vlan/add_no_link 2 vlan/add_id_over 2
    vlan/add_protocol_unsupported 2 vlan/add_duplicate_id 2
    vlan/add_on_loopback 2 vlan/add_on_off_bad 1 vlan/add_unknown 1
    vlan/add_qos_no_colon 1 vlan/add_id_bad 255 vlan/add_protocol_bad 255
    vlan/add_qos_bad 255 vlan/add_no_value 255
    macvlan/set_passthru 2 macvlan/add_macaddr_not_source 2
    macvlan/add_macaddr_multicast 2 macvlan/add_second_passthru 2
    macvlan/add_on_loopback 2 macvlan/add_nopromisc_not_passthru 1
    macvlan/add_mode_bad 1 macvlan/add_flag_bad 1 macvlan/add_macaddr_op_bad 1
    macvlan/add_macaddr_bad 1 macvlan/add_bcqueuelen_bad 1
    macvlan/add_bclim_bad 1 macvlan/add_bclim_abbrev 1 macvlan/add_no_value 255
    macvtap/add_mode_bad 1
    ipvlan/add_no_link 2 ipvlan/add_on_loopback 2 ipvlan/add_on_busy_lower 2
    ipvlan/add_two_flags 1 ipvlan/add_mode_bad 1 ipvlan/add_unknown 1
    ipvlan/add_no_value 255 ipvtap/add_mode_bad 1
    vxlan/add_no_option 2 vxlan/add_duplicate_vni 2
    vxlan/add_link_local_no_dev 2 vxlan/add_scope_mix 2
    vxlan/add_flowlabel_v4 2 vxlan/add_srcport_inverted 2
    vxlan/add_gpe_no_external 2 vxlan/add_reserved_bits_overlap 2
    vxlan/set_id 2 vxlan/set_dstport 2 vxlan/set_proxy 2 vxlan/set_family 2
    vxlan/add_no_id 1 vxlan/add_group_no_dev 1 vxlan/add_group_and_remote 1
    vxlan/add_external_and_id 1 vxlan/add_vnifilter_no_external 1
    vxlan/add_remote_bad 1 vxlan/add_strcmp_abbrev 1 vxlan/add_unknown 1
    vxlan/add_id_over 255 vxlan/add_remote_multicast 255
    vxlan/add_dev_missing 255 vxlan/add_ttl_over 255 vxlan/add_srcport_one 255
    vxlan/add_learning_twice 255 vxlan/add_no_value 255
    geneve/add_no_option 2 geneve/add_remote6_link_local 2
    geneve/add_local6_link_local 2 geneve/add_local_family_mix 2
    geneve/add_flowlabel_v4 2 geneve/add_external_udpcsum 2
    geneve/add_duplicate 2 geneve/add_after_external 2 geneve/set_id 2
    geneve/set_dstport 2 geneve/set_family 2 geneve/set_local_new 2
    geneve/set_on_external 2 geneve/add_no_id 1 geneve/add_no_remote 1
    geneve/add_external_and_id 1 geneve/set_no_id 1 geneve/add_remote_bad 1
    geneve/add_local_abbrev 1 geneve/add_local6_word 1 geneve/add_id_over 255
    geneve/add_remote_multicast 255 geneve/add_local_multicast 255
    geneve/add_ttl_over 255 geneve/add_flowlabel_over 255
    geneve/add_external_twice 255 geneve/add_no_value 255
}
check refused_statuses "positive: exactly the refusal rows expect a non-zero status" \
    {refused_rows} [join $refused_design " "]
check rc_values "boundary: every status is 0, 1, 2 or 255" \
    {bad_rc $R} {}
check rc_three "negative: a status of 3 is listed" \
    {bad_rc [list {x3 2 {} {ip link add br0 type bridge} {} 3}]} x3

foreach {name description want got expected} {
    rc_ok     "positive: the status the row wants is no problem"   0 "0\n" ""
    rc_wrong  "negative: another status is named"                  2 0     "kinds/x/ip.rc is 0, want 2"
    rc_none   "corner: an unreadable ip.rc is named as such"       0 ""    "kinds/x/ip.rc unreadable, want 0"
} {
    check $name $description [list kindcorpus::rc_problem x $want $got] $expected
}

###############################################################################
# 3. floors, readbacks and quoting
###############################################################################
check floors "boundary: no row or readback is under its structural floor" \
    {bad_floors $R} {}
check floor_refused "boundary: an ip-refused row's floor is 0 and it has no readback" \
    {bad_floors [list {x0 0 {} {ip link add br0 type bridge priority x} {} 255} \
                      {x2 2 {} {ip link add br0 type bridge priority x} {} 255} \
                      {xr 0 {} {ip link add br0 type bridge priority x} {{getlink 2 {ip link show}}} 1}]} \
    {x2 xr}
check floor_set "boundary: a set at 2 is listed, as it resolves the name first" \
    {bad_floors [list {s2 2 {} {ip link set br0 type bridge ageing_time 1} {} 0}]} s2
check floor_add "positive: an add at 2 and a set at 4 are their floors" \
    {list [field bridge/add_default 1] [field bridge/set_ageing_time 1]} {2 4}
check readbacks_accepted "positive: an accepted row reads back three ways" \
    {readback_names bridge/add_default} {getlink_detail getlink_detail_json getlink}
check readbacks_kernel_refused "corner: a kernel-refused row reads back too, to show no device" \
    {readback_names bridge/add_group_address_bad} {getlink_detail getlink_detail_json getlink}
check readbacks_ip_refused "negative: a row ip refuses has nothing to read back" \
    {readback_names bridge/add_priority_bad} {}
check readback_commands "positive: the readbacks name br0" \
    {lmap rb [field bridge/add_default 4] {lindex $rb 2}} \
    {{ip -d link show dev br0} {ip -d -j -p link show dev br0} {ip link show dev br0}}
check no_single_quotes "corner: no command or readback holds a single quote" \
    {quoted} {}
check readback_args_shape "positive: a readback is a capio of netlink_route_<name> into ip_<name>" \
    {kindcorpus::readback_args lacpa kinds/bridge/x {getlink 2 {ip link show dev br0}}} \
    {lacpa kinds/bridge/x netlink_route_getlink 2 {ip link show dev br0} ip_getlink}
check readback_args_short "negative: a two-field readback is an error" \
    {kindcorpus::readback_args lacpa kinds/x {getlink 2}} ERROR

###############################################################################
# 4. the bridge rows' states
###############################################################################
check set_pre "corner: every set_ row but the busy one starts from a bare br0" \
    {lmap s {set_ageing_time set_vlan_filtering set_stp_mode} {field bridge/$s 2}} \
    [list {{link add br0 type bridge}} {{link add br0 type bridge}} {{link add br0 type bridge}}]
check set_busy_pre "corner: the busy row's br0 has STP on" \
    {field bridge/set_stp_mode_busy 2} {{link add br0 type bridge stp_state 1}}
check add_pre "boundary: an add row has no pre step" \
    {field bridge/add_default 2} {}
check add_default_cmd "corner: add_default sends no option, with no trailing space" \
    {field bridge/add_default 3} {ip link add br0 type bridge}
check vlan_snooping_needs_filtering "corner: mcast_vlan_snooping's row turns vlan_filtering on first" \
    {field bridge/add_mcast_vlan_snooping 3} \
    {ip link add br0 type bridge vlan_filtering 1 mcast_vlan_snooping 1}
check vlan_snooping_refused "negative: without vlan_filtering the kernel refuses it" \
    {list [field bridge/add_mcast_vlan_snooping_no_vlan 3] [field bridge/add_mcast_vlan_snooping_no_vlan 5]} \
    {{ip link add br0 type bridge mcast_vlan_snooping 1} 2}
check abbrev_matches "corner: a matches keyword's abbreviation is accepted" \
    {list [field bridge/add_abbrev 3] [field bridge/add_abbrev 5]} \
    {{ip link add br0 type bridge forward_d 400} 0}
check abbrev_strcmp "corner: a strcmp keyword's is refused by ip" \
    {list [field bridge/add_stp_mode_abbrev 3] [field bridge/add_stp_mode_abbrev 5]} \
    {{ip link add br0 type bridge stp_m user} 1}

###############################################################################
# 5. the bridge_slave rows' states
###############################################################################
set ports {{link add br0 type bridge} {link add p0 type dummy} {link add p1 type dummy} {link set p0 master br0} {link set p1 master br0}}

check slave_floor "positive: a port option is a set, at floor 4" \
    {field bridge_slave/set_cost 1} 4
check slave_readbacks "positive: a port row reads p0 back" \
    {lmap rb [field bridge_slave/set_cost 4] {lindex $rb 2}} \
    {{ip -d link show dev p0} {ip -d -j -p link show dev p0} {ip link show dev p0}}
check slave_pre "positive: a port row starts from br0 with p0 and p1 enslaved" \
    {field bridge_slave/set_cost 2} $ports
check slave_state_pre "corner: state's row brings p0 up, with no IPv6 address" \
    {lrange [field bridge_slave/set_state 2] 5 end} \
    {{link set p0 addrgenmode none} {link set p0 up}}
check slave_state_bad_pre "corner: the refused state needs no up port, as the range check comes first" \
    {field bridge_slave/set_state_bad 2} $ports
check slave_nobackup_pre "corner: nobackup_port clears a backup port set before the window" \
    {lindex [field bridge_slave/set_nobackup_port 2] end} \
    {link set dev p0 type bridge_slave backup_port p1}
check slave_not_enslaved_pre "negative: the not-enslaved row's p0 has no master" \
    {field bridge_slave/set_not_enslaved 2} {{link add p0 type dummy}}
check slave_mab_locked "corner: mab's row locks the port first" \
    {field bridge_slave/set_mab 3} {ip link set dev p0 type bridge_slave locked on mab on}
check slave_mab_unlocked "negative: mab alone is refused by the kernel" \
    {list [field bridge_slave/set_mab_unlocked 3] [field bridge_slave/set_mab_unlocked 5]} \
    {{ip link set dev p0 type bridge_slave mab on} 2}
check slave_backup_port "positive: backup_port names p1, which the readback prints by name" \
    {field bridge_slave/set_backup_port 3} {ip link set dev p0 type bridge_slave backup_port p1}
check slave_priority_bounds "boundary: priority 64 is one past the kernel's 63" \
    {list [field bridge_slave/set_priority_over 3] [field bridge_slave/set_priority_over 5]} \
    {{ip link set dev p0 type bridge_slave priority 64} 2}
check slave_cost_bounds "boundary: cost 0 is one under the kernel's 1" \
    {list [field bridge_slave/set_cost_zero 3] [field bridge_slave/set_cost_zero 5]} \
    {{ip link set dev p0 type bridge_slave cost 0} 2}
check slave_abbrev "corner: a matches keyword's abbreviation is accepted, a strcmp keyword's refused" \
    {list [field bridge_slave/set_abbrev 5] [field bridge_slave/set_strcmp_abbrev 3] [field bridge_slave/set_strcmp_abbrev 5]} \
    {0 {ip link set dev p0 type bridge_slave neigh_forward_g on} 1}
check slave_on_off_vs_value "corner: a bad on/off exits 1, a missing value 255" \
    {list [field bridge_slave/set_on_off_bad 5] [field bridge_slave/set_no_value 5]} {1 255}

###############################################################################
# 6. the vlan rows' states
###############################################################################
check vlan_after_slave "positive: vlan's rows follow bridge_slave's" \
    {lsearch -glob [slugs $R] vlan/*} 102
check vlan_flag_rows "positive: one add_ row per flag keyword, each once" \
    {vlan_flags} [join $vlan_flags " "]
check vlan_flag_count "boundary: 5 of them" \
    {llength $vlan_flags} 5
check vlan_default "positive: add_default sends the id alone, on d0" \
    {list [field vlan/add_default 2] [field vlan/add_default 3]} \
    {{{link add d0 type dummy}} {ip link add link d0 name v0 type vlan id 10}}
check vlan_id_range "boundary: 4094 is accepted, 4095 refused by the kernel" \
    {list [field vlan/add_id_max 3] [field vlan/add_id_max 5] [field vlan/add_id_over 3] [field vlan/add_id_over 5]} \
    {{ip link add link d0 name v0 type vlan id 4094} 0 {ip link add link d0 name v0 type vlan id 4095} 2}
check vlan_set_id_pre "corner: set_id sends a new id to a v0 made with id 10" \
    {list [field vlan/set_id 2] [field vlan/set_id 3] [field vlan/set_id 1]} \
    {{{link add d0 type dummy} {link add link d0 name v0 type vlan id 10}} {ip link set v0 type vlan id 20} 4}
check vlan_duplicate "corner: the duplicate's pre holds v0 with id 10, and its readbacks read v1" \
    {list [lindex [field vlan/add_duplicate_id 2] end] [lindex [field vlan/add_duplicate_id 4] 0 2]} \
    {{link add link d0 name v0 type vlan id 10} {ip -d link show dev v1}}
check vlan_no_link "negative: the no-link row names no lower" \
    {field vlan/add_no_link 3} {ip link add name v0 type vlan id 10}
check vlan_no_id "negative: the no-id row sends no option" \
    {field vlan/add_no_id 3} {ip link add link d0 name v0 type vlan}
check vlan_loopback "corner: the loopback row stacks on lo" \
    {field vlan/add_on_loopback 3} {ip link add link lo name v0 type vlan id 10}
check vlan_pre_d0 "positive: every vlan row's pre makes d0 first" \
    {lsort -unique [lmap r $R {expr {[string match vlan/* [lindex $r 0]] ? [lindex $r 2 0] : "-"}}]} \
    {- {link add d0 type dummy}}
check vlan_returned_vs_exit "corner: on_off and an unknown word return (1); a bad mapping exits (255)" \
    {lmap s {add_on_off_bad add_qos_no_colon add_qos_bad} {field vlan/$s 5}} {1 1 255}

###############################################################################
# 7. the macvlan and macvtap rows' states
###############################################################################
check macvlan_after_vlan "positive: macvlan's rows follow vlan's, and macvtap's macvlan's" \
    {list [lsearch -glob [slugs $R] macvlan/*] [lsearch -glob [slugs $R] macvtap/*]} {130 164}
check macvlan_mode_rows "positive: one add_mode_ row per mode, each once" \
    {macvlan_modes} [join $macvlan_modes " "]
check macvlan_mode_count "boundary: 5 of them" \
    {llength $macvlan_modes} 5
check macvlan_default "positive: add_default sends no option, on d0" \
    {field macvlan/add_default 3} {ip link add link d0 name m0 type macvlan}
check macvlan_source_pre "corner: set_macaddr_del's pre makes m0 in source mode, holding the address deleted" \
    {list [lindex [field macvlan/set_macaddr_del 2] end] [field macvlan/set_macaddr_del 3]} \
    {{link add link d0 name m0 type macvlan mode source macaddr add 02:00:00:00:00:01} {ip link set m0 type macvlan macaddr del 02:00:00:00:00:01}}
check macvlan_second_passthru "corner: the second passthru's pre holds a passthru m0, and its readbacks read m1" \
    {list [lindex [field macvlan/add_second_passthru 2] end] [lindex [field macvlan/add_second_passthru 4] 0 2]} \
    {{link add link d0 name m0 type macvlan mode passthru} {ip -d link show dev m1}}
check macvlan_set_passthru "negative: set_passthru changes a bridge-mode m0 to passthru" \
    {list [lindex [field macvlan/set_passthru 2] end] [field macvlan/set_passthru 3] [field macvlan/set_passthru 5]} \
    {{link add link d0 name m0 type macvlan mode bridge} {ip link set m0 type macvlan mode passthru} 2}
check macvlan_bclim_negative "boundary: bclim takes a negative" \
    {list [field macvlan/add_bclim_negative 3] [field macvlan/add_bclim_negative 5]} \
    {{ip link add link d0 name m0 type macvlan bclim -1} 0}
check macvlan_bclim_strcmp "corner: bclim is strcmp, so bcl is an unknown word (1)" \
    {list [field macvlan/add_bclim_abbrev 3] [field macvlan/add_bclim_abbrev 5]} \
    {{ip link add link d0 name m0 type macvlan bcl 10} 1}
check macvlan_returned_vs_exit "corner: every ip refusal returns (1) but NEXT_ARG's (255)" \
    {lmap s {add_nopromisc_not_passthru add_mode_bad add_macaddr_bad add_no_value} {field macvlan/$s 5}} \
    {1 1 1 255}
check macvtap_kind "corner: every macvtap row adds or sets t0 as a macvtap" \
    {strays $R macvtap t0} {}
check macvtap_kind_caught "negative: a macvtap row sent as macvlan is listed" \
    {strays [list {macvtap/x 4 {} {ip link add link d0 name t0 type macvlan} {} 0}] macvtap t0} \
    macvtap/x

###############################################################################
# 8. the ipvlan and ipvtap rows' states
###############################################################################
check ipvlan_after_macvtap "positive: ipvlan's rows follow macvtap's, and ipvtap's ipvlan's" \
    {list [lsearch -glob [slugs $R] ipvlan/*] [lsearch -glob [slugs $R] ipvtap/*]} {170 188}
check ipvlan_mode_rows "positive: one add_mode_ row per mode, each once" \
    {word_rows ipvlan "ip link add link d0 name i0 type ipvlan" mode_} [join $ipvlan_modes " "]
check ipvlan_flag_rows "positive: one add_ row per flag word, each once" \
    {word_rows ipvlan "ip link add link d0 name i0 type ipvlan" ""} [join $ipvlan_flags " "]
check ipvlan_word_counts "boundary: 3 modes and 3 flag words" \
    {list [llength $ipvlan_modes] [llength $ipvlan_flags]} {3 3}
check ipvlan_default "positive: add_default sends no option, on d0" \
    {field ipvlan/add_default 3} {ip link add link d0 name i0 type ipvlan}
check ipvlan_two_flags "corner: two flag words is ip's refusal: rc 1, floor 0, no readback" \
    {list [field ipvlan/add_two_flags 3] [field ipvlan/add_two_flags 5] [field ipvlan/add_two_flags 1] [field ipvlan/add_two_flags 4]} \
    {{ip link add link d0 name i0 type ipvlan private vepa} 1 0 {}}
check ipvlan_busy_pre "corner: the busy lower's pre makes d0, then a macvlan m0 on it" \
    {field ipvlan/add_on_busy_lower 2} \
    {{link add d0 type dummy} {link add link d0 name m0 type macvlan mode bridge}}
check ipvlan_set_mode_pre "corner: set_mode sends a mode alone to an i0 made private" \
    {list [lindex [field ipvlan/set_mode 2] end] [field ipvlan/set_mode 3]} \
    {{link add link d0 name i0 type ipvlan private} {ip link set i0 type ipvlan mode l2}}
check ipvlan_no_link "negative: the no-link row names no lower" \
    {field ipvlan/add_no_link 3} {ip link add name i0 type ipvlan}
check ipvlan_returned_vs_exit "corner: the mode error and an unknown word return (1); NEXT_ARG exits (255)" \
    {lmap s {add_mode_bad add_unknown add_no_value} {field ipvlan/$s 5}} {1 1 255}
check ipvtap_kind "corner: every ipvtap row adds or sets j0 as an ipvtap" \
    {strays $R ipvtap j0} {}
check ipvtap_kind_caught "negative: an ipvtap row sent as ipvlan is listed" \
    {strays [list {ipvtap/x 4 {} {ip link add link d0 name j0 type ipvlan} {} 0}] ipvtap j0} \
    ipvtap/x

###############################################################################
# 9. the vxlan rows' states
###############################################################################
set vxlan_head "ip link add vx0 type vxlan id 42 dstport 4789"
check vxlan_after_ipvtap "positive: vxlan's rows follow ipvtap's" \
    {lsearch -glob [slugs $R] vxlan/*} 192
check vxlan_flag_rows "positive: one add_ row per flag word, each once" \
    {word_rows vxlan $vxlan_head ""} [join $vxlan_flags " "]
check vxlan_df_rows "positive: one add_df_ row per df value" \
    {word_rows vxlan $vxlan_head df_} [join $vxlan_df " "]
check vxlan_word_counts "boundary: 13 flags and 3 df values" \
    {list [llength $vxlan_flags] [llength $vxlan_df]} {13 3}
check vxlan_id_range "boundary: the VNI's top is accepted; one over is ip's invarg" \
    {list [field vxlan/add_id_max 3] [field vxlan/add_id_max 5] [field vxlan/add_id_over 3] [field vxlan/add_id_over 5]} \
    {{ip link add vx0 type vxlan id 16777215 dstport 4789} 0 {ip link add vx0 type vxlan id 16777216} 255}
check vxlan_dstport "corner: only add_default and the external rows that don't name one send no dstport" \
    {vxlan_no_dstport} {vxlan/add_default vxlan/add_external vxlan/add_gpe}
check vxlan_dev_pre "corner: every row naming dev d0 makes it first" \
    {dev_d0_pres} {{link add d0 type dummy}}
check vxlan_duplicate "corner: the duplicate's pre holds vx0 with id 42, and its readbacks read vx1" \
    {list [field vxlan/add_duplicate_vni 2] [field vxlan/add_duplicate_vni 3] [lindex [field vxlan/add_duplicate_vni 4] 0 2]} \
    {{{link add vx0 type vxlan id 42 dstport 4789}} {ip link add vx1 type vxlan id 42 dstport 4789} {ip -d link show dev vx1}}
check vxlan_set_pre "positive: every set acts on a vx0 its pre made" \
    {lsort -unique [lmap r $R {expr {[string match vxlan/set_* [lindex $r 0]] ? [lindex $r 2 end] : "-"}}]} \
    {- {link add vx0 type vxlan id 42 dstport 4789}}
check vxlan_get_addr "corner: get_addr's failure exits 1, invarg's 255" \
    {list [field vxlan/add_remote_bad 5] [field vxlan/add_remote_multicast 5]} {1 255}

###############################################################################
# 10. the geneve rows' states
###############################################################################
check geneve_after_vxlan "positive: geneve's rows follow vxlan's" \
    {lsearch -glob [slugs $R] geneve/*} 265
check geneve_local_one_keyword "positive: one keyword, local, sends either family" \
    {lmap s {add_local add_local6} {lrange [field geneve/$s 3] end-1 end}} \
    {{local 10.0.0.2} {local 2001:db8::2}}
check geneve_local_refused "corner: local6 and loc are ip's refusals: rc 1, floor 0" \
    {lmap s {add_local6_word add_local_abbrev} {list [field geneve/$s 5] [field geneve/$s 1]}} \
    {{1 0} {1 0}}
check geneve_conflict_pres "corner: the conflict rows' pres make gn0 with the base, external, external" \
    {lmap s {add_duplicate add_after_external set_on_external} {lindex [field geneve/$s 2] end}} \
    {{link add gn0 type geneve id 1 remote 10.0.0.1} {link add gn0 type geneve external} {link add gn0 type geneve external}}
check geneve_conflict_readbacks "corner: their readbacks read gn1, gn1, gn0" \
    {lmap s {add_duplicate add_after_external set_on_external} {lindex [field geneve/$s 4] 0 2}} \
    {{ip -d link show dev gn1} {ip -d link show dev gn1} {ip -d link show dev gn0}}
check geneve_id_range "boundary: the VNI's top is accepted; one over is ip's invarg" \
    {list [field geneve/add_id_max 5] [field geneve/add_id_over 5]} {0 255}
check geneve_set_needs_id "negative: a set without id is ip's refusal; with it the kernel's" \
    {list [field geneve/set_no_id 5] [field geneve/set_id 5]} {1 2}

###############################################################################
# summary
###############################################################################
puts ""
puts "=== kind-write-corpus.exp: $pass passed, $fail failed ==="
if {$fail > 0} {
    puts "KINDCORPUS_TEST_FAIL"
    exit 1
}
puts "KINDCORPUS_TEST_PASS"
exit 0

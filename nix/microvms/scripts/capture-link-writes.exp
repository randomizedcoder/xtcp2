#!/usr/bin/env expect
###############################################################################
# capture-link-writes.exp - drive the bond / LACP capture inside a microVM
#
# Usage:
#   capture-link-writes.exp <serial-port> <blob-out>
#
#   <serial-port>  host TCP port qemu bound the guest's serial console to
#   <blob-out>     file to write the base64 tarball to
#
# Phase 0 of docs/netlink/link-write-path.md: the Tier 1 topology and its
# READBACK rows only. Three states of one two-namespace topology
# (scripts/link-write-topology.exp), each captured off nlmon0 in lacpa as
# that state's own subdirectory:
#
#   lacp_no_partner    lacpa's bond up, lacpb's ports up but in no bond
#   lacp_converged     lacpb's bond built, both ports at 0x3f/0x3f
#   lacp_partner_down  lb2 taken down, la2 out of the aggregate, la1 still in
#
# They run in that order because each state is the previous one plus one
# change, which is cheaper than three topologies and is also how a bond
# reaches them in production.
#
# Every state also waits for lacpa's churn machines to leave MONITOR
# (lwtopo::wait_churn), so churn_actor_state and churn_partner_state read the
# same on every run: NO_CHURN once converged, and CHURN where lacp_no_partner's
# silent partner leaves a port out of sync. Without the wait they read
# MONITOR on a run that finishes inside AD_CHURN_DETECTION_TIME (60 s).
#
# Then the WRITE rows (phase 6): one `ip link add|set|replace|del` each, in
# a namespace rebuilt for the row, captured with `xtcp2-nlcap write` so the
# request, the kernel's answer, `ip`'s stderr and its exit status land
# together under write/<slug>/. See write_row below.
#
# Then the ROUTE rows (route-write-path.md phase 4): one `ip route add|
# change|replace|prepend|append|test|del` each, the same way, under
# route/<slug>/.
#
# Then the ADDRESS corpus (addr-write-path.md, "The capture corpus"):
#
#   addr-show/<state>/   each addrtopo state (scripts/addr-topology.exp),
#                        built in its own netns addra and read back with
#                        `ip addr show`, its output modes and its selectors
#   addr/<slug>/         one `ip addr add|change|replace|del` each
#   addr-flush/<slug>/   one `ip addr flush` each
#   addr-save/<slug>/    `ip addr save|showdump|restore`
#   addr-mcdump/mc_any/  the RTM_GETMULTICAST and RTM_GETANYCAST dumps,
#                        which no `ip addr` sends; see addr_mcdump below
#   addr-monitor/mc_any/ `ip monitor maddress acaddress` over the same
#                        joins, the only `ip` that prints `mcast` and `any`;
#                        see addr_monitor below
#
# The rows are data in scripts/addr-corpus.exp, where the hermetic check
# can read them. A required state that cannot be built fails the run; one of
# the two measured states (optimistic, temporary) that the kernel will not
# produce is dropped with a note in its topology file, and the refusals
# while building it do not count against the run.
#
# POLICY HERE, MECHANISM IN THE GUEST
#
# As for the dump driver: which states exist, what each waits for and what
# is captured in each is this file; how to capture with a floor, write a
# sidecar and read a port's LACP state is `xtcp2-nlcap`
# (nix/microvms/netlink-capture.nix).
#
# A STATE THAT IS NOT REACHED IS NOT CAPTURED
#
# Every state is entered through a wait on the state itself (wait-lacp,
# then wait-churn). If
# the wait times out the state's captures are SKIPPED, not taken anyway: a
# fixture labelled lacp_converged that holds a half-negotiated bond would be
# a wrong answer that looks like a right one. The states after it are skipped
# too, since each is built on the one before. The run then reports
# NLCAP_LACP_TIMEOUT and exits 1, and what was captured before it is still
# packed.
###############################################################################

source [file dirname [info script]]/vm-lib.exp
source [file dirname [info script]]/netlink-topology.exp
source [file dirname [info script]]/link-write-topology.exp
source [file dirname [info script]]/link-write-readback.exp
source [file dirname [info script]]/addr-topology.exp
source [file dirname [info script]]/addr-corpus.exp

if {$argc != 2} {
    puts "usage: capture-link-writes.exp <serial-port> <blob-out>"
    exit 2
}
set port     [lindex $argv 0]
set blob_out [lindex $argv 1]

set NS_A $lwtopo::NS_A
set NS_B $lwtopo::NS_B

# Accumulated problems, reported together at the end.
set short_caps    {}
set lacp_timeouts {}

###############################################################################
# write_row <slug> <floor> <pre> <command> - one write row of the corpus.
#
# THE NAMESPACE IS REBUILT FOR EVERY ROW
#
# ns-add deletes and recreates lacpa with lo and nlmon0 only, so every row
# starts from lo = 1 and nlmon0 = 2, and the devices its precondition makes
# take the next indexes in the order they are made. The ifindex is in the
# request bytes (ifi_index on a set, IFLA_MASTER, active_slave), so a
# namespace carried over from the row before would make a row's bytes
# depend on its position in this file.
#
# <pre> is a list of `ip` argument lists, run through nltopo::topo OUTSIDE
# the capture window and recorded in write/<slug>/topology. An address row
# may also hold a `sysctl KEY VALUE` step (addrcorpus::pre_step). A refused
# precondition fails the run (it is in nltopo::refused_steps) and the row
# is skipped, since its write would be answered by the wrong state.
#
# FLOORS: two datagrams for the write (the request and its NLMSG_ERROR, an
# ACK or a refusal) and two for every name `ip` resolves first, each of
# which is an RTM_GETLINK and its reply on a socket of its own.
#
# The rows are link-write-path.md's corpus table, and that table is where
# each row's expected kernel answer is argued. up_down is two rows here,
# set_up and set_down, because one capture holds one command.
###############################################################################

set write_skipped {}

# <proto> is the netlink protocol the row's ip.pcap keeps: route, generic or
# xfrm (xtcp2-nlcap --proto).
proc write_row {slug floor pre command {dir write} {proto route}} {
    global NS_A short_caps write_skipped
    set subdir $dir/$slug
    vmlib::log "=== write $slug ==="
    vmlib::must "xtcp2-nlcap ns-add $NS_A"
    foreach step $pre {
        if {![addrcorpus::pre_step $NS_A $subdir $step]} {
            lappend write_skipped $slug
            return 0
        }
    }
    lassign [nlcap write --proto $proto $NS_A $subdir ip $floor "'$command'"] rc out
    if {$rc != 0} {
        lappend short_caps "$subdir/ip"
        vmlib::log "MISSED FLOOR $subdir/ip: $out"
        return 0
    }
    vmlib::log [string trim $out]
    return 1
}

# Preconditions shared by several rows.
set PRE_BOND     {{link add bond0 type bond mode 802.3ad}}
set PRE_PORT     {{link add la1 type veth peer name lb1}}
set PRE_ENSLAVED [concat $PRE_BOND $PRE_PORT {{link set la1 master bond0}}]

set write_rows [list \
    [list add_dummy 2 {} "ip link add d0 type dummy"] \
    [list add_veth 2 {} "ip link add v0 type veth peer name v1"] \
    [list add_bond_bare 2 {} "ip link add bond0 type bond"] \
    [list add_bond_8023ad 2 {} \
        "ip link add bond0 type bond mode 802.3ad lacp_rate fast miimon 100 xmit_hash_policy layer3+4"] \
    [list add_bond_all_lacp 2 {} \
        "ip link add bond0 type bond mode 802.3ad lacp_rate fast lacp_active on ad_select bandwidth ad_actor_sys_prio 100 ad_user_port_key 7 ad_actor_system 02:00:00:00:00:0a min_links 1"] \
    [list add_bond_ab_arp 2 {} \
        "ip link add bond0 type bond mode active-backup arp_interval 100 arp_ip_target 10.0.0.1,10.0.0.2 arp_validate all"] \
    [list add_bond_numeric_mode 2 {} "ip link add bond0 type bond mode 4"] \
    [list enslave_down 6 [concat $PRE_BOND $PRE_PORT] "ip link set la1 down master bond0"] \
    [list enslave_up 6 [concat $PRE_BOND $PRE_PORT {{link set la1 up}}] "ip link set la1 master bond0"] \
    [list nomaster 4 $PRE_ENSLAVED "ip link set la1 nomaster"] \
    [list slave_queue_id 4 $PRE_ENSLAVED "ip link set la1 type bond_slave queue_id 1"] \
    [list slave_actor_port_prio 4 $PRE_ENSLAVED "ip link set la1 type bond_slave actor_port_prio 200"] \
    [list set_lacp_rate_up 4 [concat $PRE_BOND {{link set bond0 up}}] "ip link set bond0 type bond lacp_rate slow"] \
    [list set_mode_with_ports 4 $PRE_ENSLAVED "ip link set bond0 type bond mode balance-rr"] \
    [list set_lacp_rate_rr 4 {{link add bond0 type bond mode balance-rr}} "ip link set bond0 type bond lacp_rate fast"] \
    [list arp_and_miimon 2 {} "ip link add bond0 type bond arp_interval 100 miimon 100"] \
    [list replace_existing 2 $PRE_BOND "ip link replace bond0 type bond"] \
    [list set_up 4 $PRE_BOND "ip link set bond0 up"] \
    [list set_down 4 [concat $PRE_BOND {{link set bond0 up}}] "ip link set bond0 down"] \
    [list rename_mtu_alias 4 {{link add d0 type dummy}} "ip link set d0 name d1 mtu 9000 alias uplink"] \
    [list del_bond 4 $PRE_ENSLAVED "ip link del bond0"] \
]

###############################################################################
# route_rows - route-write-path.md phase 4's corpus, under route/<slug>.
#
# FLOORS: `dev X` is one RTM_GETLINK by name before the write
# (ll_name_to_index, after the whole argv has parsed), so a dev route is 4
# and a dev-less one (via only, a type with no device, a plain del) is 2.
# nodev is the lookup alone: `ip` stops at "Cannot find device" and never
# sends the write.
#
# d0 is ifindex 3 in every row (lo 1, nlmon0 2, then d0), which is in
# RTA_OIF. A row the kernel refuses (del_missing; add_via_inet6 or onlink
# if the kernel says no) is kept for its request, as the refused link rows
# are.
###############################################################################

set PRE_DEV   {{link add d0 type dummy} {link set d0 up} {addr add 192.0.2.1/24 dev d0}}
set PRE_DEV6  [concat $PRE_DEV {{-6 addr add 2001:db8::1/64 nodad dev d0}}]
set PRE_ROUTE [concat $PRE_DEV {{route add 198.51.100.0/24 dev d0}}]

set P24 198.51.100.0/24

set route_rows [list \
    [list replace_nfs 4 $PRE_DEV \
        "ip route replace 192.0.2.50/32 dev d0 congctl lock cubic rto_min 3ms initcwnd 32 initrwnd 32 quickack 1"] \
    [list replace_dev 4 $PRE_DEV "ip route replace $P24 dev d0"] \
    [list add_dev 4 $PRE_DEV "ip route add $P24 dev d0"] \
    [list add_via_dev 4 $PRE_DEV "ip route add $P24 via 192.0.2.254 dev d0"] \
    [list add_via_nodev 2 $PRE_DEV "ip route add $P24 via 192.0.2.254"] \
    [list replace_default 2 $PRE_DEV "ip route replace default via 192.0.2.254"] \
    [list change_metric 4 $PRE_ROUTE "ip route change $P24 dev d0 metric 100"] \
    [list append_dev 4 $PRE_ROUTE "ip route append $P24 dev d0 metric 200"] \
    [list prepend_dev 4 $PRE_ROUTE "ip route prepend $P24 dev d0 metric 300"] \
    [list test_dev 4 $PRE_ROUTE "ip route test $P24 dev d0"] \
    [list del_dev 4 $PRE_ROUTE "ip route del $P24 dev d0"] \
    [list del_nodev 2 $PRE_ROUTE "ip route del $P24"] \
    [list del_missing 2 $PRE_DEV "ip route del 203.0.113.99/32"] \
    [list add_table_100 4 $PRE_DEV "ip route add $P24 dev d0 table 100"] \
    [list add_table_300 4 $PRE_DEV "ip route add $P24 dev d0 table 300"] \
    [list add_blackhole 2 {} "ip route add blackhole $P24"] \
    [list add_unreachable 2 {} "ip route add unreachable $P24"] \
    [list add_local 4 $PRE_DEV "ip route add local 192.0.2.77 dev d0"] \
    [list add_src_proto_scope 4 $PRE_DEV \
        "ip route add $P24 dev d0 src 192.0.2.1 proto static scope link metric 50"] \
    [list add_onlink 4 $PRE_DEV "ip route add $P24 via 203.0.113.1 dev d0 onlink"] \
    [list add_via_inet6 4 $PRE_DEV6 "ip route add $P24 via inet6 2001:db8::2 dev d0"] \
    [list v6_replace_via 4 $PRE_DEV6 "ip -6 route replace 2001:db8:1::/64 via 2001:db8::2 dev d0"] \
    [list v6_del 4 [concat $PRE_DEV6 {{-6 route add 2001:db8:1::/64 dev d0}}] \
        "ip -6 route del 2001:db8:1::/64 dev d0"] \
    [list metrics_all 4 $PRE_DEV \
        "ip route replace $P24 dev d0 mtu lock 1400 advmss 1360 window 65535 rtt 3ms rttvar 10ms ssthresh 100 cwnd 10 reordering 5 hoplimit 64 initcwnd 10 initrwnd 20 features ecn tcp_usec_ts fastopen_no_cookie 1"] \
    [list metrics_raw 4 $PRE_DEV "ip route replace $P24 dev d0 rtt 24 rttvar 40 rto_min 200"] \
    [list metric_repeated 4 $PRE_DEV "ip route replace $P24 dev d0 initcwnd 10 initcwnd 20"] \
    [list nodev 2 {} "ip route add $P24 dev nosuch"] \
]

###############################################################################
# addr_readback - every addrtopo state, built in addra and read back.
#
# A state that is not built captures nothing and says why in its topology
# file: addrtopo::drop writes the note for a measured state, and this writes
# one for a required state, which also fails the run.
###############################################################################

set addr_tolerated {}

proc addr_readback {} {
    global short_caps addr_tolerated
    set ns $addrtopo::NS_A
    foreach state [addrtopo::state_names] {
        set subdir addr-show/$state
        vmlib::log "=== addr state $state ==="
        set before [llength [nltopo::refused_steps]]
        if {![addrtopo::build $state $subdir]} {
            if {$state in [addrtopo::dropped_states]} {
                lappend addr_tolerated {*}[lrange [nltopo::refused_steps] $before end]
            } else {
                nlcap note $subdir "'not built $state: a step was refused or a wait timed out'"
            }
            continue
        }
        foreach row [addrcorpus::readback $state] {
            lassign $row suffix floor command mode
            if {$mode eq "write"} {
                lassign [nlcap write $ns $subdir ip_addr$suffix $floor "'$command'"] rc out
                if {$rc != 0} {
                    lappend short_caps "$subdir/ip_addr$suffix"
                    vmlib::log "MISSED FLOOR $subdir/ip_addr$suffix: $out"
                } else {
                    vmlib::log [string trim $out]
                }
            } else {
                capio $ns $subdir netlink_route_getaddr$suffix $floor $command ip_addr$suffix
            }
        }
    }
}

###############################################################################
# addr_mcdump - the only replies that carry IFA_MULTICAST and IFA_ANYCAST
# (A1-T01; docs/netlink/addr-write-path.md, table 6).
#
# The kernel sends those attributes in RTM_GETMULTICAST and RTM_GETANYCAST
# replies, never in RTM_GETADDR's (net/ipv6/addrconf.c:5267-5303,
# net/ipv4/igmp.c:1526), and the pinned `ip` asks for neither, so
# xtcp2-nl-mcdump sends the request (nix/microvms/netlink-capture.nix).
#
# One dummy, up, in a fresh addra:
#   - forwarding=1 before the IPv6 address, so adding it joins the
#     subnet-router anycast 2001:db8:1:: (addrconf_join_anycast). nodad, so
#     the address is not tentative and the join is not deferred. It is set on
#     `default` before d0 exists, and d0 inherits it: before 058b9b19 (7.2) a
#     per-device forwarding write returns 1 from the handler, which reaches
#     write(2) as a one-byte count, and the `default` branch always returned
#     0 (net/ipv6/addrconf.c:884-892).
#   - 224.0.0.251 autojoin, so the IPv4 dump has a group of ours beside
#     224.0.0.1.
#
# Each dump's oracle is the /proc file the kernel renders from the same
# lists with no netlink in between: igmp, igmp6, anycast6. The floor is 2: the
# request, and one reply datagram, since this namespace's groups and the DONE
# fit in one dump skb.
#
# The two negative rows are `write` rows, which keep the stderr and the exit
# status: an AF_UNSPEC multicast dump and an AF_INET anycast dump have no
# dumpit, for the family or for PF_UNSPEC, so the kernel answers EOPNOTSUPP
# (net/core/rtnetlink.c:7073-7078).
###############################################################################
proc addr_mcdump {} {
    global addr_problems
    set ns $addrtopo::NS_A
    set subdir addr-mcdump/mc_any
    vmlib::log "=== addr mcdump ==="
    vmlib::must "xtcp2-nlcap ns-add $ns"
    if {![addrtopo::sysctl $ns $subdir net.ipv6.conf.default.forwarding 1]} {
        lappend addr_problems "$subdir: sysctl net.ipv6.conf.default.forwarding=1 refused"
        return
    }
    nltopo::topo $ns $subdir link add d0 type dummy
    nltopo::topo $ns $subdir link set d0 up
    nltopo::topo $ns $subdir -6 addr add 2001:db8:1::1/64 dev d0 nodad
    nltopo::topo $ns $subdir addr add 224.0.0.251/32 dev d0 autojoin

    foreach {name command proc_file} {
        netlink_route_getmulticast_v4 {xtcp2-nl-mcdump inet multicast}  igmp
        netlink_route_getmulticast_v6 {xtcp2-nl-mcdump inet6 multicast} igmp6
        netlink_route_getanycast_v6   {xtcp2-nl-mcdump inet6 anycast}   anycast6
    } {
        capio $ns $subdir $name 2 $command $name.counts
        side $ns $subdir proc_net_$proc_file "cat /proc/net/$proc_file"
    }
    foreach {name command} {
        netlink_route_getmulticast_unspec {xtcp2-nl-mcdump unspec multicast}
        netlink_route_getanycast_v4       {xtcp2-nl-mcdump inet anycast}
    } {
        lassign [nlcap write $ns $subdir $name 2 "'$command'"] rc out
        if {$rc != 0} {
            lappend addr_problems "$subdir/$name: $out"
        } else {
            vmlib::log [string trim $out]
        }
    }
}

###############################################################################
# addr_monitor - the oracle for `any ADDR` and `mcast ADDR` (A1-T02;
# docs/netlink/addr-write-path.md, table 6).
#
# `ip addr show` never receives an RTM_NEWMULTICAST or RTM_NEWANYCAST
# message; `ip monitor maddress acaddress` does and hands it to
# print_addrinfo (ip/ipmonitor.c:156-160), so its stdout is what goip must
# render for one. xtcp2-nl-ipmon (nix/microvms/netlink-capture.nix) starts
# the monitor, waits until it prints a canary join on c0, runs the trigger
# and stops once every pattern has been printed.
#
# c0 and d0 exist before the monitor starts, so its `N: dev` prefix names
# them. That also puts d0's ff02::1 and ff01::1 joins (ipv6_add_dev, at
# registration) before the monitor, and a dummy is IFF_NOARP, so it joins no
# solicited-node group at all (addrconf_join_solict returns early). So the
# trigger makes every event explicitly: 224.0.0.1 on up, the subnet-router
# anycast 2001:db8:1:: (forwarding=1, as in addr_mcdump) on the address,
# then a v6 and a v4 autojoin group, each joined and left.
#
# A `write` row, not capio: a read is retried on a missed floor, and a
# second run would meet a namespace the first one changed. Each row has its
# own namespace. The floor is 30 of the 45 datagrams the first passing run
# measured on each row: the notifications, the trigger's requests and acks,
# and the canary's. The `-j` row is the boundary: 7.1.0's monitor never opens a
# JSON context (ipmonitor.c has no new_json_obj), so it prints text too.
###############################################################################
proc addr_monitor {} {
    global addr_problems
    set ns $addrtopo::NS_A
    set subdir addr-monitor/mc_any
    lassign [nlcap dir $subdir] dir_rc dir
    set dir [string trim $dir]
    set trigger "ip link set d0 up; ip -6 addr add 2001:db8:1::1/64 dev d0 nodad; ip -6 addr add ff02::fb/128 dev d0 autojoin; ip -6 addr del ff02::fb/128 dev d0; ip addr add 224.0.0.251/32 dev d0 autojoin; ip addr del 224.0.0.251/32 dev d0"
    set until {}
    foreach re {{any 2001:db8:1:: } {Deleted .*mcast ff02::fb } {Deleted .*mcast 224.0.0.251 }} {
        append until " \"$re\""
    }
    foreach {name args} {
        netlink_route_monitor_maddr      {monitor maddress acaddress}
        netlink_route_monitor_maddr_json {-j monitor maddress acaddress}
    } {
        vmlib::log "=== addr monitor $name ==="
        vmlib::must "xtcp2-nlcap ns-add $ns"
        if {![addrtopo::sysctl $ns $subdir net.ipv6.conf.default.forwarding 1]} {
            lappend addr_problems "$subdir: sysctl net.ipv6.conf.default.forwarding=1 refused"
            return
        }
        nltopo::topo $ns $subdir link add c0 type dummy
        nltopo::topo $ns $subdir link set c0 up
        nltopo::topo $ns $subdir link add d0 type dummy
        nltopo::topo $ns $subdir link set d0 addrgenmode none
        set command "xtcp2-nl-ipmon c0 \"$args\" \"$trigger\"$until"
        lassign [nlcap write $ns $subdir $name 30 "'$command'"] rc out
        if {$rc != 0} {
            lappend addr_problems "$subdir/$name: $out"
            continue
        }
        vmlib::log [string trim $out]
        # The capture's status is the floor; xtcp2-nl-ipmon's is in .rc,
        # and non-zero there means a pattern never printed.
        if {[vmlib::run "grep -qx 0 $dir/$name.rc"] != 0} {
            lappend addr_problems "$subdir/$name: xtcp2-nl-ipmon failed, see $name.err"
        }
    }
}

###############################################################################
# promote_default - M3: the promote_secondaries a fresh namespace gives a new
# device, recorded beside flush_primary and returned so flush_rows can build
# flush_primary_flipped from its opposite. Empty when it cannot be read.
###############################################################################
proc promote_default {} {
    global NS_A
    set key /proc/sys/net/ipv4/conf/default/promote_secondaries
    vmlib::must "xtcp2-nlcap ns-add $NS_A"
    side $NS_A addr-flush/flush_primary promote_secondaries_default "cat $key"
    lassign [vmlib::run_out "ip netns exec $NS_A cat $key"] rc out
    set value [string trim $out]
    if {$rc != 0 || $value ni {0 1}} {
        vmlib::log "cannot read promote_secondaries in $NS_A: rc=$rc \[$out\]"
        return ""
    }
    return $value
}

###############################################################################
# run
###############################################################################

vmlib::init
nltopo::reset
vmlib::connect $port 300

if {[vmlib::run "command -v xtcp2-nlcap >/dev/null"] != 0} {
    vmlib::log "FATAL: xtcp2-nlcap is not on the guest PATH."
    vmlib::log "       The VM was probably built without the link-write-capture"
    vmlib::log "       flavor's environment.systemPackages entry."
    puts "NLCAP_DRIVER_FAIL"
    exit 3
}

# The bonding module has to be loaded and must NOT have made a bond0 in the
# root namespace: mkVm.nix loads it with max_bonds=0 for this flavor. A bond0
# here means that option was lost, and every later `link add bond0` would
# still work - so check rather than let it pass silently.
if {[vmlib::run "test -d /sys/module/bonding"] != 0} {
    vmlib::log "FATAL: the bonding module is not loaded."
    vmlib::log "       mkVm.nix should load it for the link-write-capture flavor."
    puts "NLCAP_DRIVER_FAIL"
    exit 3
}
if {[vmlib::run "test -e /sys/class/net/bond0"] == 0} {
    vmlib::log "WARNING: a bond0 exists in the guest's root namespace; the"
    vmlib::log "         max_bonds=0 module option did not take effect."
}

vmlib::must "xtcp2-nlcap side - . uname 'uname -a'"
vmlib::must "xtcp2-nlcap side - . ip_version 'ip -V'"

vmlib::must "xtcp2-nlcap ns-add $NS_A"
vmlib::must "xtcp2-nlcap ns-add $NS_B"

set reached 1

vmlib::log "=== lacp_no_partner ==="
lwtopo::build_partnerless "."
if {[lwtopo::wait_defaulted] && [lwtopo::wait_churn settled]} {
    readback_set $NS_A lacp_no_partner
} else {
    lappend lacp_timeouts lacp_no_partner
}

# The partner is built whether or not the state above was reached: a bond
# that never defaulted can still converge, and the converged state is the
# one the later phases most need.
vmlib::log "=== lacp_converged ==="
lwtopo::build_partner lacp_converged
if {[lwtopo::wait_lacp_converged] && [lwtopo::wait_churn]} {
    readback_set $NS_A lacp_converged
} else {
    lappend lacp_timeouts lacp_converged
    set reached 0
}

if {$reached} {
    vmlib::log "=== lacp_partner_down ==="
    lwtopo::pull_lb2 lacp_partner_down
    if {[lwtopo::wait_partner_down] && [lwtopo::wait_churn]} {
        readback_set $NS_A lacp_partner_down
    } else {
        lappend lacp_timeouts lacp_partner_down
    }
} else {
    vmlib::log "skipping lacp_partner_down: it starts from lacp_converged"
    lappend lacp_timeouts lacp_partner_down
}

# The address states have namespaces of their own, so they can run here,
# after the LACP states are done with lacpa and before the rows that
# rebuild it.
addr_readback

# The write rows run last because each one recreates lacpa, which tears
# down the veth pairs the readback states were built on.
foreach row $write_rows {
    write_row {*}$row
}
foreach row $route_rows {
    write_row {*}$row route
}
foreach row $addrcorpus::write_rows {
    write_row {*}$row addr
}

set addr_problems {}
addr_mcdump
addr_monitor
set promote [promote_default]
if {$promote eq ""} {
    lappend addr_problems "promote_secondaries default unreadable; addr-flush rows not run"
} else {
    foreach row [addrcorpus::flush_rows $promote] {
        write_row {*}$row addr-flush
    }
}

# A save row's file is written by the row's own redirect, from its own
# directory. Check it is there: a save that wrote somewhere else would
# still have a pcap and an rc, and look like a capture.
lassign [nlcap dir addr-save] dir_rc save_dir
set save_dir [string trim $save_dir]
foreach row $addrcorpus::save_rows {
    set slug [lindex $row 0]
    if {![write_row {*}$row addr-save]} {
        continue
    }
    set file [expr {$slug eq "showdump_bad_magic" ? "bad.save" : "ip.save"}]
    if {[vmlib::run "test -s $save_dir/$slug/$file"] != 0} {
        lappend addr_problems "addr-save/$slug/$file missing or empty"
    }
}

lassign [nlcap inventory] inv_rc inventory
vmlib::log "captured [llength [split [string trim $inventory] "\n"]] files"

vmlib::log "=== packing ==="
lassign [vmlib::run_out "xtcp2-nlcap pack" 600] pack_rc blob
if {$pack_rc != 0} {
    vmlib::log "FATAL: pack failed (rc=$pack_rc)"
    puts "NLCAP_DRIVER_FAIL"
    exit 3
}

set fh [open $blob_out w]
puts $fh $blob
close $fh
vmlib::log "wrote [string length $blob] bytes of base64 to $blob_out"

vmlib::run "xtcp2-nlcap ns-del $NS_A"
vmlib::run "xtcp2-nlcap ns-del $NS_B"
vmlib::run "xtcp2-nlcap ns-del $addrtopo::NS_A"
vmlib::run "xtcp2-nlcap ns-del $addrtopo::NS_B"

vmlib::poweroff

###############################################################################
# verdict
###############################################################################

puts ""
set failed 0
set failed_topo [addrcorpus::fatal_refusals [nltopo::refused_steps] $addr_tolerated]
if {[llength $failed_topo] > 0} {
    # Unlike the dump corpus, no step here is optional: every one builds the
    # bond the readbacks describe, so a refusal fails the run.
    puts "NLCAP_TOPO_REFUSED [llength $failed_topo]"
    foreach t $failed_topo {
        puts "  $t"
    }
    set failed 1
}

if {[llength $lacp_timeouts] > 0} {
    puts "NLCAP_LACP_TIMEOUT [llength $lacp_timeouts]"
    foreach s $lacp_timeouts {
        puts "  $s"
    }
    puts "  Those states were never reached, so nothing was captured for them"
    puts "  and any committed fixture of the same name is unchanged."
    set failed 1
}

if {[llength $write_skipped] > 0} {
    puts "NLCAP_WRITE_SKIPPED [llength $write_skipped]"
    foreach s $write_skipped {
        puts "  $s"
    }
    puts "  A precondition step was refused, so the row's write was not run."
    set failed 1
}

if {[llength [addrtopo::failed_states]] > 0} {
    puts "NLCAP_ADDR_STATE_FAILED [llength [addrtopo::failed_states]]"
    foreach s [addrtopo::failed_states] {
        puts "  $s"
    }
    puts "  Required address states that were not built; nothing was captured"
    puts "  for them. Their topology files say which step or wait failed."
    set failed 1
}

if {[llength [addrtopo::dropped_states]] > 0} {
    # Reported, not failed: these are the measured states, and a kernel
    # that does not produce one is the measurement.
    puts "NLCAP_ADDR_STATE_DROPPED [llength [addrtopo::dropped_states]]"
    foreach s [addrtopo::dropped_states] {
        puts "  $s"
    }
}

if {[llength $addr_problems] > 0} {
    puts "NLCAP_ADDR_MISSING_FILE [llength $addr_problems]"
    foreach p $addr_problems {
        puts "  $p"
    }
    set failed 1
}

if {[llength $short_caps] > 0} {
    puts "NLCAP_MISSED_FLOOR [llength $short_caps]"
    foreach c $short_caps {
        puts "  $c"
    }
    puts "  Those came in short twice and were DISCARDED rather than written."
    set failed 1
}

if {$failed} {
    puts "NLCAP_DRIVER_FAIL"
    exit 1
}

puts "NLCAP_DRIVER_PASS"
exit 0

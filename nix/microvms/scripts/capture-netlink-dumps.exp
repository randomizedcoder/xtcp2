#!/usr/bin/env expect
###############################################################################
# capture-netlink-dumps.exp - drive a netlink DUMP capture inside a microVM
#
# Usage:
#   capture-netlink-dumps.exp <serial-port> <blob-out> [--skip-mesh]
#                                                      [--skip-tunnel]
#
#   <serial-port>  host TCP port qemu bound the guest's serial console to
#   <blob-out>     file to write the base64 tarball to
#   --skip-mesh    skip the mesh set (faster; loses the advisory bridge set)
#   --skip-tunnel  skip the tunnel set (faster; loses every ARPHRD type that
#                  ll_addr_n2a special-cases)
#
# This file holds the POLICY half of the capture: which namespaces exist,
# which commands are captured, what each capture's floor is, and which
# sidecars are recorded. The MECHANISM half - create a namespace, run a
# capture with a floor, write a sidecar, pack the result - is `xtcp2-nlcap` in
# the guest (nix/microvms/netlink-capture.nix). The TOPOLOGY is
# scripts/netlink-topology.exp, shared with the goip-parity driver so both
# capture off one definition; see that file's header for why the clean
# namespace has no bridge.
#
# The split is what makes the capture set editable without rebuilding a VM,
# and it is why this is an expect script rather than another systemd oneshot
# baked into the image.
#
# WHY A GUEST AND NOT THE HOST
#
# The host script this replaces captured on whatever machine ran it, so the
# reply side was a function of that machine: the committed
# netlink_route_getaddr.pcap carries six distinct portids and 24 stray
# multicast notifications because a workstation has other things running. In
# here the interface set is what this script created, and the iproute2 doing
# the asking is the pinned `pkgs.iproute2` rather than whatever the host
# happens to have - which turns nix/upstream-pins.json's iproute2 entry from
# an observation into an enforced pin.
###############################################################################

source [file dirname [info script]]/vm-lib.exp
source [file dirname [info script]]/netlink-topology.exp

if {$argc < 2} {
    puts "usage: capture-netlink-dumps.exp <serial-port> <blob-out> \[--skip-mesh\]"
    exit 2
}
set port     [lindex $argv 0]
set blob_out [lindex $argv 1]
set skip_mesh 0
set skip_tunnel 0
foreach a [lrange $argv 2 end] {
    switch -- $a {
        --skip-mesh   { set skip_mesh 1 }
        --skip-tunnel { set skip_tunnel 1 }
        default {
            puts "unknown argument: $a"
            exit 2
        }
    }
}

set NS_CLEAN  "nlcapc"
set NS_MESH   "nlcapm"
set NS_TUNNEL "nlcapt"
set DUMMY     "goip0"

# The tunnel set's `dev` selector. gre1 rather than one of the other four
# because it is the only device in that namespace carrying addresses and a
# route, so `addr show dev` and `route show dev` have something to print;
# the other four exist for their link-layer address alone.
set TUNDEV    "gre1"

# Accumulated problems, reported together at the end rather than scrolling
# past in the middle of the run.
set short_caps  {}

###############################################################################
# helpers over vmlib
###############################################################################

proc nlcap {args} {
    return [vmlib::run_out "xtcp2-nlcap [join $args { }]"]
}

# cap <ns> <subdir> <name> <floor> <command>
#
# <command> is quoted into one shell word for the guest helper, which runs it
# with `sh -c` inside <ns>.
proc cap {ns subdir name floor command} {
    global short_caps
    lassign [nlcap cap $ns $subdir $name $floor "'$command'"] rc out
    if {$rc != 0} {
        lappend short_caps "$subdir/$name"
        vmlib::log "MISSED FLOOR $subdir/$name: $out"
        return 0
    }
    vmlib::log [string trim $out]
    return 1
}

# capio <ns> <subdir> <name> <floor> <command> <stdout-name>
#
# A `cap` and a `side` of the SAME invocation: one run of the command, its
# netlink in the pcap and its stdout in the sidecar. `cap` plus a separate
# `side` of the same command is two runs, and for anything that prints live
# counters the two disagree - the committed ip_link_stats and a replay of
# netlink_route_getlink_stats.pcap differ on exactly the counter lines, which
# is why internal/goip has a normalizeLinkStatsText at all.
#
# So the rule for a `-s` golden below is: `capio` if a test replays the pcap
# and diffs the sidecar, because then it reproduces byte for byte and needs no
# normalizer; `side` if the golden is compared against another TEXT file
# (the no-op pairs) or in a form that drops counter values anyway (JSON).
proc capio {ns subdir name floor command sout} {
    global short_caps
    lassign [nlcap capio $ns $subdir $name $floor "'$command'" $sout] rc out
    if {$rc != 0} {
        lappend short_caps "$subdir/$name"
        vmlib::log "MISSED FLOOR $subdir/$name: $out"
        return 0
    }
    vmlib::log [string trim $out]
    return 1
}

proc side {ns subdir name command} {
    lassign [nlcap side $ns $subdir $name "'$command'"] rc out
    if {$rc != 0} {
        vmlib::log "sidecar failed: $subdir/$name"
    }
    return $rc
}

###############################################################################
# captures
#
# FLOORS are structural minima: one request plus at least one reply datagram
# per dump the command issues. `link show` is a single dump, so 2. Everything
# that calls ll_init_map() first is two dumps, so 4 - a floor of 2 there would
# pass on a capture that missed the second dump entirely, which is exactly the
# failure worth catching. They are not host-specific expectations, so they
# stay valid on a namespace with fewer objects.
###############################################################################

proc capture_set {ns subdir dev} {
    # A bare `link show` is AF_PACKET and carries IFLA_EXT_MASK = 0x09.
    cap $ns $subdir netlink_route_getlink 2 "ip link show"

    # The same dump with one byte changed. `-s` clears RTEXT_FILTER_SKIP_STATS
    # from the mask, so this sends 0x01 where the line above sends 0x09
    # (ip/ipaddress.c:2017-2026) - a one-byte difference at offset 36 of the
    # same 40-byte datagram - and the kernel answers by attaching IFLA_STATS
    # and IFLA_STATS64 to every reply.
    #
    # Worth its own pcap even though the corpus already contains replies
    # carrying those attributes: netlink_route_getaddr_v4 and
    # netlink_route_getneigh have them only as a SIDE EFFECT, because their
    # link dumps send no IFLA_EXT_MASK at all and rtnl_linkdump_req_filter_fn
    # then skips the filter entirely (lib/libnetlink.c:595). Nothing in the
    # corpus records a request that asks for them on purpose, which is the
    # half goip has to reproduce byte for byte.
    #
    # Floor 2, the same as the line above: one dump, one request, at least one
    # reply. `-s` does not reach ll_link_get or ll_init_map, whose masks are
    # local constants (lib/ll_map.c:277,395), so it adds no transaction.
    cap $ns $subdir netlink_route_getlink_stats 2 "ip -s link show"

    # Plain `addr show` is AF_UNSPEC, so its link dump DOES carry
    # IFLA_EXT_MASK; the -4/-6 forms do not, because
    # rtnl_linkdump_req_filter_fn skips filter_fn unless the family is
    # AF_UNSPEC or AF_PACKET (lib/libnetlink.c:595). All three are captured
    # because that difference is a request-byte difference goip must
    # reproduce, and it had no fixture at all before.
    cap $ns $subdir netlink_route_getaddr 4 "ip addr show"
    cap $ns $subdir netlink_route_getaddr_v4 4 "ip -4 addr show"
    cap $ns $subdir netlink_route_getaddr_v6 4 "ip -6 addr show"

    # `-s addr show`, and it is the ONLY `-s` form in the whole sweep that
    # changes a request byte no existing capture covers. The AF_UNSPEC addr
    # dump's link half does carry IFLA_EXT_MASK (see above), so `-s` clears
    # RTEXT_FILTER_SKIP_STATS there exactly as it does for `ip -s link show`:
    # 0x01 where netlink_route_getaddr sends 0x09.
    #
    # The -4/-6 forms get no pcap of their own because they CANNOT differ -
    # rtnl_linkdump_req_filter_fn skips filter_fn for a non-AF_UNSPEC family
    # (lib/libnetlink.c:595), so those two send no mask with or without `-s`.
    # Their `-s` difference is output-only and lives in a sidecar.
    #
    # Floor 4, like the three above: link dump plus addr dump, request and
    # reply each.
    #
    # capio and not cap+side: the replies carry IFLA_STATS64, so the stdout
    # has to come from the invocation this pcap recorded or a replay cannot
    # reproduce it exactly.
    capio $ns $subdir netlink_route_getaddr_stats 4 "ip -s addr show" ip_addr_stats

    # `-s -6 addr show`, and its REQUEST is byte-identical to
    # netlink_route_getaddr_v6's - rtnl_linkdump_req_filter_fn skips filter_fn
    # for a non-AF_UNSPEC family (lib/libnetlink.c:595), so neither form sends
    # a mask. A second pcap with the same request bytes needs a reason, and the
    # reason is the stdout: this command prints IPv6 MIB counters out of
    # IFLA_PROTINFO/IFLA_INET6_STATS, which tick, so the only way its golden
    # can be diffed against a replay is for the two to come from one run.
    #
    # Pairing them is also what makes the golden survive a RE-capture. The
    # guest's dummy device gets a random MAC per boot, so ip_addr_v6's
    # link-local is a different address in every run; a sidecar captured in one
    # boot and replayed against another boot's pcap differs on that line and on
    # nothing else, which reads exactly like a renderer bug.
    capio $ns $subdir netlink_route_getaddr_v6_stats 4 "ip -s -6 addr show" ip_addr_v6_stats

    # Default `route show` sends AF_INET plus RTA_TABLE=254, not the all-zero
    # rtmsg of `table all` (ip/iproute.c:1836,1997). Both, for the same
    # reason as above.
    cap $ns $subdir netlink_route_getroute 4 "ip route show"
    cap $ns $subdir netlink_route_getroute_table_all 4 "ip route show table all"
    cap $ns $subdir netlink_route_getroute6 4 "ip -6 route show"

    # The -d forms of the two IPv4 route shows need a pcap, not just a sidecar.
    # The clean topology's nhid route makes `ip -d route show` follow RTA_NH_ID
    # into a live RTM_GETNEXTHOP single-get (ip/iproute.c:1002), whose reply only
    # reaches a replay if this run's netlink is recorded; capio writes the pcap
    # and the `_n` sidecar from one run, as the `-s` captures above do.
    capio $ns $subdir netlink_route_getroute_detail 4 "ip -d route show" ip_route_main_n
    capio $ns $subdir netlink_route_getroute_table_all_detail 4 "ip -d route show table all" ip_route_table_all_n

    # `ip nexthop show` dumps the clean topology's nexthop objects (id 1/2/8 single,
    # id 5 fdb, id 7 on the VRF-enslaved goipv, id 10/11 mpath groups, id 20 resilient
    # group). Floor 4: the nexthop dump plus the ll_init_map link dump print_rta_ifidx
    # triggers to turn nh_oif into `dev goip0`. capio pairs the pcap with the ip_nexthop
    # sidecar so a replay reproduces the listing byte for byte.
    capio $ns $subdir netlink_route_getnexthop 4 "ip nexthop show" ip_nexthop
    # `ip nexthop show id 10` is a point GET (NHA_ID, no NLM_F_DUMP), not a dump;
    # id 10 is an mpath group, so this grounds both the by-id request bytes and a
    # group line fetched by id. Floor 2: a group carries no nh_oif, so there is no
    # ll_init_map link lookup, just the GET request and its one RTM_NEWNEXTHOP reply.
    capio $ns $subdir netlink_route_getnexthop_id 2 "ip nexthop show id 10" ip_nexthop_id
    # `ip nexthop show id 20` is the same point GET of the resilient group, grounding
    # the `type resilient buckets .. idle_timer .. unbalanced_timer .. unbalanced_time
    # ..` line. Same floor 2 (a group carries no nh_oif).
    capio $ns $subdir netlink_route_getnexthop_res 2 "ip nexthop show id 20" ip_nexthop_res
    # Wire-filter dump selectors (nh_dump_filter, ip/ipnexthop.c:70). `dev`, `master`
    # and `vrf` each resolve a name via ll_init_map before the filtered dump, and
    # render a `dev` on the reply, so they are floor 4 like the bare dump. `vrf` also
    # sends a name_is_vrf link single-get first (ip/iplink_vrf.c:170) to confirm the
    # kind, so its pcap carries one extra transaction over `master`. `master goipvrf`
    # and `vrf goipvrf` send the same NHA_MASTER dump and both return id 7 (a VRF is a
    # master). `groups` and `fdb` send a zero-length flag and their replies carry no
    # nh_oif, so no ll_init_map and no link get - floor 2; this kernel's NHA_FDB does
    # not narrow the set, so `fdb` returns every nexthop (id 5 among them). `protocol`
    # is a client-side stdout filter over the bare dump (a NUMBER, get_unsigned at
    # :1248), so it reuses the bare pcap and takes side sidecars only (below).
    capio $ns $subdir netlink_route_getnexthop_dev    4 "ip nexthop show dev goip0"      ip_nexthop_dev
    capio $ns $subdir netlink_route_getnexthop_master 4 "ip nexthop show master goipvrf" ip_nexthop_master
    capio $ns $subdir netlink_route_getnexthop_vrf    4 "ip nexthop show vrf goipvrf"    ip_nexthop_vrf
    capio $ns $subdir netlink_route_getnexthop_groups 2 "ip nexthop show groups"         ip_nexthop_groups
    capio $ns $subdir netlink_route_getnexthop_fdb    2 "ip nexthop show fdb"            ip_nexthop_fdb

    # `ip addrlabel show` dumps the kernel's built-in IPv6 address-label policy
    # table (ip6addrlbl_net_init), which a fresh netns carries identically. One
    # RTM_GETADDRLABEL dump; every default entry has ifal_index 0, so there is no
    # ll_init_map dev/ifname lookup - floor 2. capio pairs the pcap with the
    # ip_addrlabel sidecar so a replay reproduces the listing byte for byte.
    capio $ns $subdir netlink_route_getaddrlabel 2 "ip addrlabel show" ip_addrlabel

    # `ip ntable show` dumps the neighbour tables (RTM_GETNEIGHTBL). do_ipntable
    # runs ll_init_map first, so the pcap holds the link dump ahead of the table
    # dump - floor 4, the neigh shape - and that link dump resolves the
    # NDTPA_IFINDEX a device-specific parameter set carries. The `-s` form adds
    # the config and stats blocks; its reply bytes match the plain form (the
    # kernel always sends config/stats), so the second pcap exists for its
    # ip_ntable_s pairing. capio both so each sidecar is captured at the same
    # instant as its bytes - ndtc_last_flush/last_rand are wall-clock deltas.
    capio $ns $subdir netlink_route_getneightbl   4 "ip ntable show"    ip_ntable
    capio $ns $subdir netlink_route_getneightbl_s 4 "ip -s ntable show" ip_ntable_s

    # `ip netconf show` dumps the per-interface forwarding/rp_filter config
    # (RTM_GETNETCONF). do_ipnetconf runs ll_init_map first, so the pcap holds the
    # link dump ahead of the netconf dump - floor 4, the ntable shape - and that
    # link dump resolves the NETCONFA_IFINDEX each record carries. The plain form
    # is a single AF_UNSPEC dump that a modern kernel answers with every family
    # (inet, inet6) in one dump, not the old-kernel two-pass fallback.
    #
    # The `_dev4` form is the one genuinely new shape: `ip -4 netconf show dev X`
    # has an ifindex AND an explicit family, so it is a non-dump point GET
    # (NLM_F_REQUEST|ACK, one NETCONFA_IFINDEX attr, no NLM_F_DUMP) read via
    # rtnl_talk - the first attribute-carrying point get in the corpus. The `_dev`
    # form (no family flag) stays a dump and filters to the ifindex client-side.
    capio $ns $subdir netlink_route_getnetconf      4 "ip netconf show"            ip_netconf
    capio $ns $subdir netlink_route_getnetconf_dev  4 "ip netconf show dev $dev"   ip_netconf_dev
    capio $ns $subdir netlink_route_getnetconf_dev4 4 "ip -4 netconf show dev $dev" ip_netconf_dev4

    # `ip stats show group link` dumps per-interface stats (RTM_GETSTATS). goip
    # grounds only the link group (IFLA_STATS_LINK_64, a rtnl_link_stats64); the
    # explicit `group link` holds filter_mask at 0x1 so the reply carries only that
    # group on every topology - a bare multi-group show would pull in bridge xstats
    # on the mesh's br0, a shape goip does not implement. ipstats resolves ifindex
    # to name lazily via ll_index_to_name, so the pcap holds a link dump ahead of
    # the stats dump - floor 4, the netconf shape. The `_dev` form is a non-dump
    # point GET (ipstats_show_one, no NLM_F_DUMP) read via rtnl_talk. ip_stats_s
    # (extended `-s`) and ip_stats_json replay the plain pcap - -s/-j never reach
    # the wire, so the reply bytes are the plain form's.
    capio $ns $subdir netlink_route_getstats     4 "ip stats show group link"          ip_stats
    capio $ns $subdir netlink_route_getstats_dev 4 "ip stats show group link dev $dev" ip_stats_dev

    # `ip stats show group xstats` requests the link-xstats group (filter_mask 0x2,
    # no IFLA_STATS_GET_FILTERS nest for a whole group). The group expands to four
    # leaves (bond lacp, bridge vlan/mcast/stp), so every device prints four header
    # stanzas with bodies only where the sub-attr exists - on the mesh's br0 that is
    # vlan + mcast; everywhere else the four stanzas are header-only. goip grounds the
    # vlan and mcast bodies and the empty headers; bridge stp/bond bodies are refused.
    # ip_stats_xstats_s (extended `-s`) equals the plain render - the bridge bodies
    # have no show_stats>1 branch - and ip_stats_xstats_json is the flat `-j` array,
    # one object per leaf per device; both replay netlink_route_getstats_xstats.pcap.
    capio $ns $subdir netlink_route_getstats_xstats 4 "ip stats show group xstats"     ip_stats_xstats

    # Closes the corpus's last outright gap: there was no RTM_GETNEIGH dump
    # anywhere, only a notifications pcap.
    cap $ns $subdir netlink_route_getneigh 4 "ip neigh show"

    # `-s neigh show`, whose request is byte-identical to the line above - `-s`
    # reaches no part of rtnl_neighdump_req - so this pcap exists for its
    # stdout pairing alone, like the two addr stats captures.
    #
    # It is the one `-s` golden in this file that prints a block AND whose
    # numbers are unbounded: used/confirmed/updated are ticks since, and they
    # advance between any two invocations. The block also lands mid-line,
    # between the flag run and the state (ip/ipneigh.c:453-465), so a
    # normalizer that rewrote the counters would have to rewrite the middle of
    # a line and would be rewriting the thing under test. capio removes the
    # need for one.
    capio $ns $subdir netlink_route_getneigh_stats 4 "ip -s neigh show" ip_neigh_stats

    # Originally captured to SETTLE what a single-get does rather than to
    # confirm it: whether iproute2 resolves the name through a full dump and
    # filters, or issues a non-dump RTM_GETLINK, decided whether goip needed
    # TalkRtnetlink here at all. It does, and the answer turned out to be two
    # non-dump RTM_GETLINKs, not one — ll_link_get for the index
    # (ip/ipaddress.c:2254) and then iplink_get for the reply that gets
    # printed (:2293).
    #
    # Hence floor 4 and not the 2 this line carried while the question was
    # open: two transactions, each a request and a reply. At 2 a capture
    # window that caught only the first would be written as a good fixture.
    cap $ns $subdir netlink_route_getlink_dev 4 "ip link show dev $dev"

    # The addr object's `dev` selector, and THREE transactions rather than the
    # link object's two - hence floor 6.
    #
    # `dev NAME` lands in the same catch-all else-arm in every `addr` form
    # (ip/ipaddress.c:2241-2247) and ll_name_to_index resolves it with the
    # same throwaway ll_link_get (:2253), so request one is byte-identical to
    # netlink_route_getlink_dev's first. There the two commands part company:
    # with filter.ifindex set, :2302 takes ipaddr_link_get, which re-fetches
    # BY INDEX where iplink_get re-fetched by name, and then :2314 dumps the
    # addresses with that index written into ifa_index.
    #
    # So this is the only capture in the corpus holding an RTM_GETADDR dump
    # with a non-zero ifa_index, and the only one where a by-index and a
    # by-name single-get for the SAME interface appear side by side. Both are
    # request-byte facts with no output consequence at all, which is exactly
    # why they need a pcap rather than a sidecar.
    cap $ns $subdir netlink_route_getaddr_dev 6 "ip addr show dev $dev"

    # The same selector with `-s`, and the only capture in the corpus that
    # records the ext_filter_mask on a NON-DUMP RTM_GETLINK. ipaddr_link_get
    # (ip/ipaddress.c:2302) writes the mask into a single-get, so this is where
    # `-s` reaches the get path - a request-byte fact that source reading can
    # assert and nothing else in the corpus can check. Floor 6, the same three
    # transactions as the line above.
    #
    # capio for the same reason as the two addr stats captures above, and with
    # a second payoff here: this command's counters come from IFLA_STATS64 on
    # a non-dump reply while the bare `-s -6` form's come from the IPv6 MIB, so
    # the two goldens are the evidence that one header covers two sources. That
    # only holds if each is reproducible from its own pcap.
    capio $ns $subdir netlink_route_getaddr_dev_stats 6 "ip -s addr show dev $dev" ip_addr_dev_stats

    # The route object's `dev` selector, and the interesting thing about it is
    # that the selector both ADDS a transaction and REMOVES several.
    #
    # It adds ll_name_to_index's throwaway ll_link_get at the front
    # (ip/iproute.c:2008), byte-identical to the first request of the two
    # captures above - hence two transactions and floor 4, not the single dump
    # a bare `route show` needs.
    #
    # It removes every lazy by-index side-get at the back. print_route's `dev`
    # token is guarded by `filter.oifmask != -1` (:900-901) and that token is
    # the only caller of ll_index_to_name for RTA_OIF, so naming a device means
    # no name ever has to be resolved. A bare `route show` costs one get per
    # distinct output interface; this form costs exactly two transactions no
    # matter how large the answer is, so the saving GROWS with the answer.
    #
    # The dump itself is also the only RTM_GETROUTE in the corpus carrying two
    # attributes: iproute_dump_filter writes RTA_TABLE first (:1726) then
    # RTA_OIF (:1731), each behind its own presence test, and that order is
    # part of the byte-equality contract.
    cap $ns $subdir netlink_route_getroute_dev 4 "ip route show dev $dev"

    # The neigh object's `dev` selector, and the one that costs NOTHING -
    # which is why the floor here is 4, the same as bare `neigh show` above,
    # and not the 6 the addr form needed.
    #
    # do_show_or_flush calls ll_init_map(&rth) unconditionally at
    # ip/ipneigh.c:597, before it resolves the name at :600. That dump has
    # already filled the index cache, so ll_name_to_index's ll_get_by_name
    # hits and never reaches the throwaway ll_link_get every other `dev` form
    # in this list pays for (lib/ll_map.c:354-359). Two transactions, and the
    # first is byte-identical to netlink_route_getneigh's.
    #
    # So the whole on-the-wire difference between this capture and
    # netlink_route_getneigh is 8 bytes on the second request - and they are
    # bytes worth a pcap, because ipneigh_dump_filter writes the index as an
    # NDA_IFINDEX ATTRIBUTE (:493) while `struct ndmsg` has an ndm_ifindex
    # field sitting unused at offset 4. This is the corpus's only RTM_GETNEIGH
    # carrying an attribute at all.
    cap $ns $subdir netlink_route_getneigh_dev 4 "ip neigh show dev $dev"

    # The neigh object's OTHER free selector, and the narrowest request delta
    # in the whole set: ONE byte.
    #
    # ipneigh_dump_filter writes filter.ndm_flags into the base struct at
    # offset 10 (ip/ipneigh.c:490), unconditionally and before either
    # attribute, so `ip neigh show proxy` and `ip neigh show` send the same
    # 28-byte datagram differing in a single position. The `dev` form above
    # needed 8 bytes to say what it wanted; this one needs one.
    #
    # The REPLY side is the opposite of narrow. The kernel tests that byte
    # for equality with NTF_PROXY (net/core/neighbour.c:2956) and walks
    # pneigh_dump_table instead of neigh_dump_table, so this capture and
    # netlink_route_getneigh hold DISJOINT entry sets rather than a subset
    # and a superset. It is the corpus's only RTM_GETNEIGH reply stream with
    # ndm_state NUD_NONE, no NDA_LLADDR and no NDA_CACHEINFO
    # (pneigh_fill_info, :2739-2749) - the shape a decoder that assumes every
    # neighbor has a state gets wrong.
    #
    # Floor 4, the same as the two above, because the byte changes which
    # table is walked and not how many dumps are sent.
    cap $ns $subdir netlink_route_getneigh_proxy 4 "ip neigh show proxy"

    # The fifth object, and the corpus's first RTM_GETRULE and first
    # fib_rule_hdr. Floor 2, the lowest in this table, because
    # iprule_list_flush_or_save sends exactly one dump and calls no
    # ll_init_map at all - `ip rule show` resolves no interface name, since
    # FRA_IIFNAME and FRA_OIFNAME arrive as STRINGS rather than as indices.
    #
    # The request is 28 bytes and carries no attribute, and cannot: under
    # strict check the kernel rejects a rule dump carrying any attribute
    # (net/core/fib_rules.c:1278-1281). So the only byte that varies across
    # every form of this command is frh.family, which makes the v6 capture
    # below a one-byte delta - the narrowest in this set apart from
    # netlink_route_getneigh_proxy's.
    #
    # That family byte is never AF_UNSPEC. iprule_list_flush_or_save
    # substitutes AF_INET first (ip/iprule.c:749-752), so a BARE `ip rule
    # show` asks for IPv4. Which is why there is no separate `-4` capture
    # here: `ip -4 rule show` sends the same 28 bytes and prints the same
    # output, and that equality is worth a parity row rather than a pcap.
    cap $ns $subdir netlink_route_getrule 2 "ip rule show"
    cap $ns $subdir netlink_route_getrule6 2 "ip -6 rule show"
}

# PLAIN AND -d, IN PAIRS.
#
# The host script captured pcaps with plain `ip` but wrote only `ip -d`
# sidecars, so diffing a renderer's output against ip_link_n showed a large
# difference made entirely of -d-only attributes the renderer never decodes.
# Both forms are written, under distinct names: the `_n` suffix keeps meaning
# `-d`, so existing line-number citations keep their meaning.
#
# Every `_n` sidecar this proc writes is now READ, in all three namespaces,
# which it was not when the paragraph above was written: goip implements -d,
# and the eight sidecars of the CLEAN set were the first to get readers, in
# internal/goip/goip_details_test.go. The mesh and tunnel copies followed, and
# four of those are read in a different shape — goip REFUSES -d per-command on
# per-kind IFLA_INFO_DATA, so mesh/ip_addr_v4_n, tunnel/ip_addr_v4_n,
# tunnel/ip_addr_n and tunnel/ip_link_n cannot be reproduced at all and are
# instead asserted to CARRY the per-kind tokens the refusal declines to print.
#
# Note the one comparison none of them can make: nlmon0's promiscuity, which a
# `cap` records as 1 because tcpdump holds a packet socket on it and a `side`
# records as 0 because it does not. No re-capture reconciles that, since
# capturing is what sets the bit.
proc sidecar_set {ns subdir dev} {
    side $ns $subdir ip_link                "ip link show"
    side $ns $subdir ip_link_n              "ip -d link show"

    # The `-s` stanza, which is the only sidecar in this list whose CONTENT
    # is expected to differ between two captures on the same topology: it
    # prints live byte and packet counters. It is committed anyway, because
    # what is being reviewed is the block's LAYOUT - print_stats64 widens
    # every column to the widest value in it (ip/ipaddress.c:530-550), so the
    # whitespace is a function of the traffic and is exactly the part a
    # renderer gets wrong.
    #
    # Still no `-d -s` pair, and the reason has changed now that goip has -d.
    # What that sidecar would add over the two already captured is the ORDER
    # of the detail run against the stats block, and print_linkinfo settles
    # that statically: the show_details block closes at ip/ipaddress.c:1284
    # and __print_link_stats is called at :1297. A capture cannot disagree
    # with a call order, so it would cost a sidecar to restate one.
    side $ns $subdir ip_link_stats          "ip -s link show"
    side $ns $subdir ip_link_stats_json     "ip -j -p -s link show"
    side $ns $subdir ip_addr                "ip addr show"
    side $ns $subdir ip_addr_n              "ip -d addr show"
    side $ns $subdir ip_addr_v4             "ip -4 addr show"
    side $ns $subdir ip_addr_v4_n           "ip -d -4 addr show"
    side $ns $subdir ip_addr_v6             "ip -6 addr show"
    side $ns $subdir ip_addr_v6_n           "ip -d -6 addr show"
    side $ns $subdir ip_route_main          "ip route show"
    side $ns $subdir ip_route_table_all     "ip route show table all"
    side $ns $subdir ip_route6              "ip -6 route show"
    side $ns $subdir ip_route6_n            "ip -d -6 route show"

    # `ip -d nexthop show`. The plain form comes from the capio above; -d adds
    # the always-on scope and the proto token print_nexthop suppresses when
    # unspec (ip/ipnexthop.c), neither of which ticks, so a replay reproduces it.
    side $ns $subdir ip_nexthop_n           "ip -d nexthop show"
    # `ip -d nexthop show id 10`: the group fetched by id, detailed form. Reuses
    # the getnexthop_id pcap (its netlink is byte-identical to the plain GET).
    side $ns $subdir ip_nexthop_id_n        "ip -d nexthop show id 10"
    # `ip -d nexthop show id 20`: the resilient group, detailed form (adds scope
    # global + proto unspec). Reuses the getnexthop_res pcap.
    side $ns $subdir ip_nexthop_res_n       "ip -d nexthop show id 20"
    # `-d` sidecars for the wire-filter selectors (reuse the capio pcaps above) and
    # the two `protocol` sidecars, which replay the bare netlink_route_getnexthop pcap
    # and are filtered client-side (print_cache_nexthop, ip/ipnexthop.c:821).
    side $ns $subdir ip_nexthop_dev_n       "ip -d nexthop show dev goip0"
    side $ns $subdir ip_nexthop_master_n    "ip -d nexthop show master goipvrf"
    side $ns $subdir ip_nexthop_vrf_n       "ip -d nexthop show vrf goipvrf"
    side $ns $subdir ip_nexthop_groups_n    "ip -d nexthop show groups"
    side $ns $subdir ip_nexthop_fdb_n       "ip -d nexthop show fdb"
    side $ns $subdir ip_nexthop_proto       "ip nexthop show protocol 4"
    side $ns $subdir ip_nexthop_proto_n     "ip -d nexthop show protocol 4"

    # nexthop JSON. nexthop is the one object the JSON set above skipped, so these
    # answer "does goip -json use ip -j's nexthop key names?" for id/group/
    # resilient_args/gateway/dev/scope/protocol/flags and the null-valued
    # blackhole/fdb. Each is the `-j -p` twin of a text golden and replays that
    # golden's pcap, since -j changes only client-side rendering, not the request.
    side $ns $subdir ip_nexthop_json          "ip -j -p nexthop show"
    side $ns $subdir ip_nexthop_n_json        "ip -j -p -d nexthop show"
    side $ns $subdir ip_nexthop_id_json       "ip -j -p nexthop show id 10"
    side $ns $subdir ip_nexthop_id_n_json     "ip -j -p -d nexthop show id 10"
    side $ns $subdir ip_nexthop_res_json      "ip -j -p nexthop show id 20"
    side $ns $subdir ip_nexthop_res_n_json    "ip -j -p -d nexthop show id 20"
    side $ns $subdir ip_nexthop_dev_json      "ip -j -p nexthop show dev goip0"
    side $ns $subdir ip_nexthop_dev_n_json    "ip -j -p -d nexthop show dev goip0"
    side $ns $subdir ip_nexthop_master_json   "ip -j -p nexthop show master goipvrf"
    side $ns $subdir ip_nexthop_master_n_json "ip -j -p -d nexthop show master goipvrf"
    side $ns $subdir ip_nexthop_vrf_json      "ip -j -p nexthop show vrf goipvrf"
    side $ns $subdir ip_nexthop_vrf_n_json    "ip -j -p -d nexthop show vrf goipvrf"
    side $ns $subdir ip_nexthop_groups_json   "ip -j -p nexthop show groups"
    side $ns $subdir ip_nexthop_groups_n_json "ip -j -p -d nexthop show groups"
    side $ns $subdir ip_nexthop_fdb_json      "ip -j -p nexthop show fdb"
    side $ns $subdir ip_nexthop_fdb_n_json    "ip -j -p -d nexthop show fdb"
    side $ns $subdir ip_nexthop_proto_json    "ip -j -p nexthop show protocol 4"
    side $ns $subdir ip_nexthop_proto_n_json  "ip -j -p -d nexthop show protocol 4"
    # addrlabel JSON replays netlink_route_getaddrlabel.pcap; the default table is
    # static, so a separate `-j -p` run matches the capio'd text listing.
    side $ns $subdir ip_addrlabel_json      "ip -j -p addrlabel show"
    # ntable JSON replays netlink_route_getneightbl.pcap; -j does not reach the
    # wire, and the reply bytes are the plain form's, so a `-j -p` run matches.
    side $ns $subdir ip_ntable_json         "ip -j -p ntable show"
    # netconf JSON replays netlink_route_getnetconf.pcap; -j does not reach the
    # wire and the reply bytes are the plain form's, so a `-j -p` run matches the
    # capio'd text listing.
    side $ns $subdir ip_netconf_json        "ip -j -p netconf show"
    # stats: ip_stats_s is the extended `-s` render and ip_stats_json the JSON form;
    # both replay netlink_route_getstats.pcap, as -s and -j never reach the wire.
    side $ns $subdir ip_stats_s             "ip -s stats show group link"
    side $ns $subdir ip_stats_json          "ip -j -p stats show group link"
    # xstats: ip_stats_xstats_s is the extended `-s` render (equal to plain, the
    # bridge bodies have no extended branch) and ip_stats_xstats_json the `-j` array;
    # both replay netlink_route_getstats_xstats.pcap, as -s/-j never reach the wire.
    side $ns $subdir ip_stats_xstats_s      "ip -s stats show group xstats"
    side $ns $subdir ip_stats_xstats_json   "ip -j -p stats show group xstats"
    side $ns $subdir ip_neigh               "ip neigh show"
    side $ns $subdir ip_neigh_n             "ip -d neigh show"
    side $ns $subdir ip_link_dev            "ip link show dev $dev"

    # The addr `dev` stanza. Not a slice of ip_addr: `addr show dev X` prints
    # the link through print_linkinfo with do_link still 0, so it has no
    # `mode DEFAULT`, and it is the one form whose link stanza comes from a
    # single-get rather than from a dump. Committed so the renderer has
    # something to diff against that was produced by the same code path.
    side $ns $subdir ip_addr_dev            "ip addr show dev $dev"

    # The route `dev` stanza, and it is NOT the `dev`-matching lines of
    # ip_route_main with the rest deleted. Two differences, both from
    # print_route: the main line loses its `dev NAME` token entirely
    # (ip/iproute.c:900-901 guards it on filter.oifmask), while a multipath
    # route KEEPS `dev NAME` on every nexthop, including nexthops on other
    # interfaces, because the nexthop tokens at :743 and :751 have no guard.
    # So the one word the command named appears nowhere on the lines it
    # selected and everywhere on the lines it did not.
    side $ns $subdir ip_route_dev           "ip route show dev $dev"

    # The neigh `dev` stanza. Unlike the route one this IS the matching lines
    # of ip_neigh with the rest deleted - minus one token per line, because
    # print_neigh's `dev NAME` is guarded on filter.index the same way
    # print_route's is guarded on filter.oifmask (ip/ipneigh.c:415). There is
    # no nexthop half to keep the word alive, so here the device the command
    # named really does appear nowhere in the output.
    side $ns $subdir ip_neigh_dev           "ip neigh show dev $dev"

    # The proxy stanza, and it is not a slice of ip_neigh in either
    # direction: the two commands read different tables, so not one line is
    # shared. Every line here is short — destination, `dev NAME`, `proxy`,
    # and then nothing, because pneigh_fill_info sends no NDA_LLADDR and
    # ndm_state NUD_NONE, and print_neigh guards the state on
    # `if (r->ndm_state)` (ip/ipneigh.c:462). That trailing absence is the
    # part worth committing: it is the only sidecar in this list where a
    # line ENDS at a flag token, so a renderer that emitted a placeholder
    # for the empty state diverges here and nowhere else.
    #
    # No `-d` pair, for the reason the `-s` stanza above has none. The JSON
    # form IS captured because the flags are where the two output modes
    # disagree most: print_null writes `"proxy": null`, not the `true`
    # print_bool writes for an address flag.
    side $ns $subdir ip_neigh_proxy         "ip neigh show proxy"
    side $ns $subdir ip_neigh_proxy_json    "ip -j -p neigh show proxy"

    # JSON, which is what turns "does goip -json use ip -j's key names?" from
    # an eyeball question into a diff. -p pretty-prints so the committed file
    # is reviewable line by line.
    side $ns $subdir ip_link_json           "ip -j -p link show"
    side $ns $subdir ip_addr_json           "ip -j -p addr show"
    side $ns $subdir ip_route_main_json     "ip -j -p route show"
    side $ns $subdir ip_neigh_json          "ip -j -p neigh show"

    # The rule stanzas. `ip_rule_v4` is captured even though it must equal
    # ip_rule byte for byte - the bare form forces AF_INET at
    # ip/iprule.c:749-752 - because "must equal" is the claim, and a sidecar
    # that is diffed against another sidecar is how it gets checked without
    # trusting the reading of one C line.
    #
    # The `-d` pair is the useful one here in a way the neigh pair was not.
    # Every rule in the topology carries FRA_PROTOCOL, and for the sixteen
    # user-added ones it carries ZERO; print_rule suppresses the token unless
    # `protocol && protocol != RTPROT_KERNEL` or show_details (:552-557). So
    # ip_rule holds an attribute that is present, decoded, and printed
    # nowhere, and ip_rule_n is the only file that proves it was there. That
    # is the cleanest presence-versus-value case in the corpus: a renderer
    # that stored FRA_PROTOCOL as a bare uint8 cannot tell the sixteen
    # `proto unspec` rules from a rule that never sent the attribute, and
    # both goldens are needed to catch it.
    side $ns $subdir ip_rule                "ip rule show"
    side $ns $subdir ip_rule_v4             "ip -4 rule show"
    side $ns $subdir ip_rule_n              "ip -d rule show"
    side $ns $subdir ip_rule6               "ip -6 rule show"
    side $ns $subdir ip_rule6_n             "ip -d -6 rule show"
    side $ns $subdir ip_rule_json           "ip -j -p rule show"

    # The `-s` stanzas. Four of this sweep's goldens are NOT here - they are
    # written by the `capio` lines in capture_set, because a test replays
    # their pcap and diffs the sidecar byte for byte, which only works if both
    # came from one invocation. What is left is the five that do not need
    # that: two JSON forms, where the comparison drops counter values anyway,
    # and three no-ops, where the golden is diffed against another golden and
    # no pcap is involved.
    side $ns $subdir ip_addr_stats_json     "ip -j -p -s addr show"
    side $ns $subdir ip_neigh_stats_json    "ip -j -p -s neigh show"

    # route: expected byte-identical to ip_route_main and ip_route6, and that
    # is the claim. print_rta_cacheinfo gates only `users`, `used` and `age`
    # on show_stats (ip/iproute.c:500-532), and all three come from
    # rtnl_put_cacheinfo's `if (dst)` arm (net/core/rtnetlink.c:1028-1052),
    # which no route DUMP ever takes - rt_fill_info passes a dst only on a
    # `route get` and the v4 FIB dump never calls it at all, while
    # rt6_fill_node passes one only on the get. So the three members `-s`
    # prints are structurally zero on every dump and `-s route show` renders
    # nothing new.
    #
    # ip_route6_stats is the more valuable of the two, even though it is the
    # one the sweep's plan did not list: the v6 dump is the only command here
    # that puts RTA_CACHEINFO on the wire at all, so it is the only file whose
    # being identical to its non-`-s` pair rules out a renderer that prints
    # the attribute merely because it arrived.
    #
    # `side` and not `capio` precisely BECAUSE these are no-ops: the pair they
    # are compared against is ip_route_main and ip_route6, text against text,
    # and holding across two different boots is stronger evidence than holding
    # within one. A capio would tie each golden to its own fresh pcap and make
    # the comparison same-boot, which is the weaker claim.
    side $ns $subdir ip_route_main_stats    "ip -s route show"
    side $ns $subdir ip_route6_stats        "ip -s -6 route show"

    # rule: expected byte-identical to ip_rule, and the evidence is an empty
    # grep - `grep -n show_stats ip/iprule.c` returns nothing, against 5 hits
    # in iproute.c, 4 in ipneigh.c and 15 in ipaddress.c. `-s` cannot reach
    # the rule request either, so this is the cheapest no-op in the sweep.
    side $ns $subdir ip_rule_stats          "ip -s rule show"
}

###############################################################################
# run
###############################################################################

vmlib::init
nltopo::reset
# 300 s: a cold microvm boot on a loaded host is the slow case, and the
# runner's own timeout is the real backstop.
vmlib::connect $port 300

# Fail fast and loudly if the helper is not on PATH - every later step would
# otherwise report rc 127 and the reason would be buried.
if {[vmlib::run "command -v xtcp2-nlcap >/dev/null"] != 0} {
    vmlib::log "FATAL: xtcp2-nlcap is not on the guest PATH."
    vmlib::log "       The VM was probably built without the netlink-dump-capture"
    vmlib::log "       flavor's environment.systemPackages entry."
    puts "NLCAP_DRIVER_FAIL"
    exit 3
}

# Root-namespace sidecars: what kernel and what iproute2 produced all of this.
# ip_version is the per-capture record that nix/upstream-pins.json's iproute2
# entry is asserted against at eval time.
vmlib::must "xtcp2-nlcap side - . uname 'uname -a'"
vmlib::must "xtcp2-nlcap side - . ip_version 'ip -V'"

vmlib::log "=== clean namespace ==="
vmlib::must "xtcp2-nlcap ns-add $NS_CLEAN"
nltopo::build_clean $NS_CLEAN "." $DUMMY
capture_set $NS_CLEAN "." $DUMMY
sidecar_set $NS_CLEAN "." $DUMMY

if {!$skip_mesh} {
    vmlib::log "=== mesh namespace (advisory) ==="
    vmlib::must "xtcp2-nlcap ns-add $NS_MESH"
    nltopo::build_mesh $NS_MESH "mesh"
    capture_set $NS_MESH "mesh" "veth0"
    sidecar_set $NS_MESH "mesh" "veth0"
}

if {!$skip_tunnel} {
    vmlib::log "=== tunnel namespace (ll_addr_n2a) ==="

    # Load the five tunnel modules HERE, and not in boot.kernelModules, and
    # not before the two sets above have been captured. The ordering is
    # load-bearing, not tidiness.
    #
    # Each module creates its family's fallback device from
    # pernet_operations, which runs for every network namespace that exists
    # when the module loads as well as every one created afterwards. So
    # loading these at boot puts tunl0, gre0, gretap0, erspan0, sit0,
    # ip6tnl0 and ip6gre0 in the CLEAN and MESH namespaces as well as this
    # one. Measured, on the run that found it: the clean set went from three
    # links to ten and goip0 moved from ifindex 3 to ifindex 10, which
    # rewrites every committed fixture and every NDA_IFINDEX / RTA_OIF /
    # ifa_index byte that names it. Putting the tunnels in their own
    # namespace does not avoid that, because a module is kernel-wide.
    #
    # Loading them at this point puts the fallback devices where they are
    # wanted - they are half this set's coverage, being the all-zero,
    # non-IFF_POINTOPOINT arm of ip/ipaddress.c:1077-1084 - and nowhere that
    # has anything left to capture.
    #
    # Not vmlib::must: a failure here must not abort a run whose clean and
    # mesh fixtures are already recorded but not yet packed. build_tunnel's
    # own refusals report it, and NLCAP_TOPO_REFUSED names every step.
    set modprobe_rc [vmlib::run "modprobe ipip ip_gre sit ip6_tunnel ip6_gre"]
    if {$modprobe_rc != 0} {
        vmlib::log "WARNING: modprobe of the tunnel modules returned $modprobe_rc;"
        vmlib::log "         expect every build_tunnel step below to be refused."
    }

    vmlib::must "xtcp2-nlcap ns-add $NS_TUNNEL"
    nltopo::build_tunnel $NS_TUNNEL "tunnel"
    capture_set $NS_TUNNEL "tunnel" $TUNDEV
    sidecar_set $NS_TUNNEL "tunnel" $TUNDEV
}

# Inventory before pack, so a missing file is named here rather than inferred
# from a short tar on the host.
lassign [nlcap inventory] inv_rc inventory
vmlib::log "captured [llength [split [string trim $inventory] "\n"]] files"

vmlib::log "=== packing ==="
# 600 s: the blob is a few thousand wrapped base64 lines and expect matches
# one line at a time.
lassign [vmlib::run_out "xtcp2-nlcap pack" 600] pack_rc blob
if {$pack_rc != 0} {
    vmlib::log "FATAL: pack failed (rc=$pack_rc)"
    puts "NLCAP_DRIVER_FAIL"
    exit 3
}

set fh [open $blob_out w]
puts $fh $blob
close $fh
vmlib::log "wrote [string length $blob] bytes of base64 to $blob_out"

# Delete the namespaces before powering off. Not strictly needed - the guest
# is about to cease existing - but it keeps `ns-add`'s idempotence honest if
# this driver is ever pointed at a long-lived VM.
vmlib::run "xtcp2-nlcap ns-del $NS_CLEAN"
if {!$skip_mesh} {
    vmlib::run "xtcp2-nlcap ns-del $NS_MESH"
}
if {!$skip_tunnel} {
    vmlib::run "xtcp2-nlcap ns-del $NS_TUNNEL"
}

vmlib::poweroff

###############################################################################
# verdict
###############################################################################

puts ""
set failed_topo [nltopo::refused_steps]
if {[llength $failed_topo] > 0} {
    puts "NLCAP_TOPO_REFUSED [llength $failed_topo]"
    foreach t $failed_topo {
        puts "  $t"
    }
    puts "  Expect the fixture each step was there to produce to be missing"
    puts "  its positive case. See the topology sidecar."
}

if {[llength $short_caps] > 0} {
    puts "NLCAP_MISSED_FLOOR [llength $short_caps]"
    foreach c $short_caps {
        puts "  $c"
    }
    puts "  Those came in short twice and were DISCARDED rather than written,"
    puts "  so any committed fixture of the same name is unchanged."
    puts "NLCAP_DRIVER_FAIL"
    exit 1
}

puts "NLCAP_DRIVER_PASS"
exit 0

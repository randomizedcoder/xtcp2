#!/usr/bin/env expect
###############################################################################
# goip-parity.exp - drive the ip/goip/ip parity harness inside a microVM
#
# Usage:
#   goip-parity.exp <serial-port> <blob-out> [--keep-going] [--no-allowlist]
#
#   <serial-port>   host TCP port qemu bound the guest's serial console to
#   <blob-out>      file to write the base64 tarball of captures + report to
#   --keep-going    capture every command even after one misses its floor
#   --no-allowlist  pass -no-allowlist to the comparator, so every accepted
#                   divergence is reported instead of suppressed
#
# This is Tier C of the plan's parity harness: real sockets, real replies, a
# real kernel. Tiers A and B are Go tests over committed fixtures and gate on
# every `nix flake check`; this one cannot, because it needs /dev/kvm and owns
# a fixed serial port, so it is a runner in the sequential integration list.
#
# WHAT IT ACTUALLY ASSERTS, AND WHY THE TRIPLE
#
# For each command in the table, three captures are taken back to back:
#
#     ip_a  ->  goip  ->  ip_b
#
# D_control = diff(ip_a, ip_b) is a measurement of what changed across a
# window that CONTAINS the goip run, so a kernel value that drifted during the
# goip capture falls inside the control interval rather than beside it. The
# comparator subtracts it. The order is load-bearing and is not an
# optimization: capturing ip twice up front and goip afterwards would measure
# an adjacent window and would quietly attribute the drift to goip.
#
# THE COMMAND LIST IS NOT IN THIS FILE
#
# It comes from `goip-parity commands`, which prints the same table the
# comparator reads. Two copies of that list is precisely how a command stops
# being compared: the shell captures `ip -6 route show`, the comparator looks
# for route_show_v6, nothing matches, and a skipped command looks exactly like
# a passing one. So the driver asks the comparator what to capture, and the
# two cannot disagree.
#
# The table also carries each command's Implemented flag, and a command marked
# unimplemented gets NO goip capture at all. That is not a shortcut - the
# comparator treats a goip capture for an unimplemented command as a FAIL,
# on the grounds that the table and the driver disagreeing about what goip can
# run is a defect in one of them.
#
# NO `ip monitor`, DELIBERATELY
#
# The nlmon-capture flavor starts `ip -t monitor all` because its subject is
# notifications. Here it would be actively harmful: for dumps it multiplies
# deliveries, and every extra socket in the namespace is another portid the
# comparator's attribution has to discard. A multicast notification inside a
# read-only capture window is a capture-hygiene FAILURE by design
# (GOIP_PARITY_HYGIENE_FAIL), so adding a monitor would fail the run it was
# meant to observe.
#
# WHY THE COMPARISON HAPPENS IN THE GUEST
#
# The captures never have to leave for a verdict to exist, so the verdict does
# not depend on the exfil path working. The blob is still shipped out, because
# a failing run is only actionable with the pcaps in hand - but it is evidence,
# not input.
###############################################################################

source [file dirname [info script]]/vm-lib.exp
source [file dirname [info script]]/netlink-topology.exp

set usage "usage: goip-parity.exp <serial-port> <blob-out> --save-blobs <dir> \[--keep-going\] \[--no-allowlist\]"
if {$argc < 2} {
    puts $usage
    exit 2
}
set port     [lindex $argv 0]
set blob_out [lindex $argv 1]
set keep_going   0
set no_allowlist 0
# The restore and showdump rows' <slug>.save files, a store path the guest
# can read. It is required: a run without it would fail those rows on a
# missing file, which reads as a goip divergence rather than as the runner's
# mistake.
set save_blobs   ""
set rest [lrange $argv 2 end]
while {[llength $rest] > 0} {
    set rest [lassign $rest a]
    switch -- $a {
        --keep-going   { set keep_going 1 }
        --no-allowlist { set no_allowlist 1 }
        --save-blobs {
            if {[llength $rest] == 0} {
                puts $usage
                exit 2
            }
            set rest [lassign $rest save_blobs]
        }
        default {
            puts "unknown argument: $a"
            exit 2
        }
    }
}
if {$save_blobs eq ""} {
    puts $usage
    exit 2
}

# One namespace, the clean one. There is no mesh set here: the mesh topology
# carries the side `ll_link_get` transactions that positional transaction
# comparison cannot survive, so it is the decoder corpus's advisory set and
# has no business in a gated parity run.
set NS      "goipp"
set DUMMY   "goip0"
set SUBDIR  "parity"
# The write rows' namespace, recreated for every side of every write row; see
# capture_write_triple.
set NSW     "goipw"

# Accumulated problems, reported together at the end.
set short_caps    {}
set skipped       {}
set write_skipped {}

###############################################################################
# helpers over vmlib
###############################################################################

proc nlcap {args} {
    return [vmlib::run_out "xtcp2-nlcap [join $args { }]"]
}

# capio <name> <floor> <command> <stdout-name> ?ns? - one side of one triple.
#
# <ns> is the shared dump topology unless a row with a Setup names the
# namespace it built. Returns 1 on success. A miss is recorded and reported at the end; the
# comparator will separately report the command as MISSING, because it checks
# for all six files of a triple before reading any of them.
proc capio {name floor command sout {ns ""}} {
    global short_caps NS SUBDIR
    if {$ns eq ""} {
        set ns $NS
    }
    lassign [nlcap capio $ns $SUBDIR $name $floor "'$command'" $sout] rc out
    if {$rc != 0} {
        lappend short_caps "$SUBDIR/$name"
        vmlib::log "MISSED FLOOR $SUBDIR/$name: $out"
        return 0
    }
    vmlib::log [string trim $out]
    return 1
}

###############################################################################
# the command table, read from the comparator
#
# `goip-parity commands` prints one tab-separated row per command:
#
#     slug  floor  implemented  needs-dev  write  setup  args  name
#
# setup is `-` or a row's precondition steps joined with ';'. It, args
# and name hold spaces, which is why the split is on tabs. Parsed with
# `split ... \t` rather than a regexp so a name with two consecutive spaces
# cannot be silently reflowed.
###############################################################################

proc read_command_table {} {
    lassign [vmlib::run_out "goip-parity commands"] rc out
    if {$rc != 0} {
        vmlib::log "FATAL: `goip-parity commands` exited $rc"
        vmlib::log $out
        puts "GOIP_PARITY_DRIVER_FAIL"
        exit 3
    }

    set rows {}
    foreach line [split $out "\n"] {
        set line [string trimright $line]
        if {$line eq ""} {
            continue
        }
        set f [split $line "\t"]
        if {[llength $f] != 8} {
            vmlib::log "FATAL: unparseable table row ([llength $f] fields): $line"
            puts "GOIP_PARITY_DRIVER_FAIL"
            exit 3
        }
        lappend rows $f
    }

    # An empty table is a failure rather than a clean no-op, for the same
    # reason the comparator has GOIP_PARITY_NOTHING_COMPARED: a run that
    # compared nothing is indistinguishable from a passing one in the output,
    # and it means the binary is not the one this driver expects.
    if {[llength $rows] == 0} {
        vmlib::log "FATAL: `goip-parity commands` printed no rows"
        puts "GOIP_PARITY_DRIVER_FAIL"
        exit 3
    }
    return $rows
}

###############################################################################
# capture one command's triple
#
# The side names and file names are the comparator's own - <slug>.<side>.pcap
# and <slug>.<side>.out - and they are spelled here once, in one place, from
# the slug the table handed over.
###############################################################################

proc capture_triple {row dev} {
    global skipped
    lassign $row slug floor impl needs_dev write setup args name

    if {$write eq "yes" && $impl eq "yes"} {
        capture_write_triple $slug $floor $setup $args
        return
    }

    set argv_str $args
    if {$needs_dev eq "yes"} {
        set argv_str "$args $dev"
    }

    # `ip` twice and `goip` once, in that order. Both get exactly the same
    # argv, which is the property that makes the comparison mean anything -
    # internal/goip's matchesPrefix exists so that goip parses it the way
    # iproute2 does rather than merely accepting it.
    set plan [list \
        ip_a "ip $argv_str" \
        goip "goip $argv_str" \
        ip_b "ip $argv_str"]

    if {$impl ne "yes"} {
        # No goip capture, on purpose: the comparator FAILS a command that is
        # marked unimplemented but has one, because that means the table and
        # this driver disagree. Capturing only the ip sides would be worse than
        # useless - it would leave a half-triple that reads as MISSING rather
        # than as the deliberate SKIP it is - so the whole command is skipped.
        lappend skipped "$slug ($name)"
        vmlib::log "SKIP $slug: goip does not implement `$name` yet"
        return
    }

    # A read row with a Setup reads the namespace it builds instead of the
    # dump topology: built once, since a read changes nothing, so all three
    # sides see the same devices, ifindexes and MACs.
    set ns ""
    if {$setup ne "-"} {
        set ns [setup_read_ns $slug $setup]
        if {$ns eq ""} {
            return
        }
    }

    set ok 1
    foreach {side cmd} $plan {
        if {![capio "$slug.$side" $floor $cmd "$slug.$side.out" $ns]} {
            set ok 0
        }
    }
    if {!$ok} {
        vmlib::log "INCOMPLETE TRIPLE $slug - the comparator will report it MISSING"
    }
}

###############################################################################
# setup_step <ns> <step> - one Setup step; 0 when it applied.
#
# A step is an `ip` argument list for nltopo::topo, or `sysctl KEY VALUE`,
# which xtcp2-nlcap writes under /proc/sys in the namespace (the corpus's
# pre_step form in addr-corpus.exp; `route get … iif` needs forwarding on),
# or `smcroute CONF-LINE`, which xtcp2-nlcap mroute-start runs as smcrouted's
# whole configuration and holds in the namespace, its (S,G) entry listed,
# until the namespace's next ns-add or ns-del (`ip mroute show`).
###############################################################################

proc setup_step {ns step} {
    global SUBDIR
    if {[lindex $step 0] eq "sysctl"} {
        if {[llength $step] != 3} {
            vmlib::log "setup: a sysctl step is {sysctl KEY VALUE}: $step"
            return 1
        }
        lassign [vmlib::run_out "xtcp2-nlcap sysctl $ns $SUBDIR [lindex $step 1] [lindex $step 2]"] rc out
        return $rc
    }
    if {[lindex $step 0] eq "smcroute"} {
        lassign [vmlib::run_out "xtcp2-nlcap mroute-start $ns $SUBDIR '[lrange $step 1 end]'"] rc out
        return $rc
    }
    return [nltopo::topo $ns $SUBDIR {*}$step]
}

###############################################################################
# setup_read_ns <slug> <setup> - a read row's own namespace.
#
# goipw, recreated and prepared with the row's Setup, through setup_step
# and outside any capture window. Returns the namespace, or "" when a step
# was refused, in which case the whole row is skipped and the comparator
# reports it MISSING.
###############################################################################

proc setup_read_ns {slug setup} {
    global NSW SUBDIR write_skipped
    vmlib::must "xtcp2-nlcap ns-add $NSW"
    foreach step [split $setup ";"] {
        if {[setup_step $NSW $step] != 0} {
            lappend write_skipped $slug
            return ""
        }
    }
    return $NSW
}

###############################################################################
# capture one write row's triple
#
# EVERY SIDE GETS A NEW NAMESPACE
#
# ip_a's write changes the namespace, so ip_b run after it in the same one
# would meet -EEXIST, or enslave a port that is already enslaved. ns-add
# deletes and recreates goipw with lo = 1 and nlmon0 = 2, and Setup's steps
# make the same devices in the same order, so each side sees the same
# ifindexes. They are in the request bytes (ifi_index, IFLA_MASTER).
#
# Setup runs through setup_step, outside the capture window. A refused step
# skips that side, which the comparator then reports as MISSING.
#
# goip sends the lookups and writes its request to GOIP_WRITE_OUT, which is
# <slug>.goip.write beside the captures. Its floor is two lower than ip's: no
# write request, no NLMSG_ERROR. Every side is a `write` capture (one attempt,
# exit status kept), since the comparator reads all three .rc files.
###############################################################################

proc capture_write_triple {slug floor setup argv_str} {
    global NSW SUBDIR short_caps write_skipped capture_dir
    set steps {}
    if {$setup ne "-"} {
        set steps [split $setup ";"]
    }
    set plan [list \
        ip_a "ip $argv_str" $floor \
        goip "GOIP_WRITE_OUT=$capture_dir/$slug.goip.write goip $argv_str" [expr {$floor - 2}] \
        ip_b "ip $argv_str" $floor]

    foreach {side cmd side_floor} $plan {
        vmlib::must "xtcp2-nlcap ns-add $NSW"
        set refused 0
        foreach step $steps {
            if {[setup_step $NSW $step] != 0} {
                set refused 1
                break
            }
        }
        if {$refused} {
            lappend write_skipped "$slug.$side"
            continue
        }
        lassign [nlcap write $NSW $SUBDIR "$slug.$side" $side_floor "'$cmd'"] rc out
        if {$rc != 0} {
            lappend short_caps "$SUBDIR/$slug.$side"
            vmlib::log "MISSED FLOOR $SUBDIR/$slug.$side: $out"
            continue
        }
        vmlib::log [string trim $out]
    }
}

###############################################################################
# run
###############################################################################

vmlib::init
nltopo::reset
# 300 s: a cold microvm boot on a loaded host is the slow case, and the
# runner's own timeout is the real backstop.
vmlib::connect $port 300

# Fail fast and loudly if any of the three are missing, and name all of them
# in one pass rather than aborting on the first - a VM built without the
# flavor's package list is missing the helper AND both binaries, and reporting
# that as one problem is more useful than three runs.
set missing {}
foreach tool {xtcp2-nlcap goip goip-parity} {
    if {[vmlib::run "command -v $tool >/dev/null"] != 0} {
        lappend missing $tool
    }
}
if {[llength $missing] > 0} {
    vmlib::log "FATAL: not on the guest PATH: [join $missing { }]"
    vmlib::log "       goip and goip-parity come from xtcp2AllPackage, which"
    vmlib::log "       every flavor gets; xtcp2-nlcap needs the goip-parity"
    vmlib::log "       flavor's own environment.systemPackages entry."
    puts "GOIP_PARITY_DRIVER_FAIL"
    exit 3
}

# Root-namespace sidecars: what kernel and what iproute2 produced all of this.
# ip_version is what makes a divergence attributable to a version skew rather
# than to goip, and it is what nix/upstream-pins.json's iproute2 entry is
# checked against.
vmlib::must "xtcp2-nlcap side - $SUBDIR uname 'uname -a'"
vmlib::must "xtcp2-nlcap side - $SUBDIR ip_version 'ip -V'"
# goip has no -version flag, and giving it one to satisfy a sidecar would be
# the wrong way round. Its store path is a stronger identity than a version
# string anyway: the hash covers the source tree it was built from, so two
# runs with the same path compared the same binary, and two with different
# paths did not - which is the actual question a provenance sidecar answers.
vmlib::must "xtcp2-nlcap side - $SUBDIR goip_store_path 'readlink -f \"\$(command -v goip)\"'"

vmlib::log "=== topology ==="
vmlib::must "xtcp2-nlcap ns-add $NS"
nltopo::build_clean $NS $SUBDIR $DUMMY

# Resolved before the captures, not after: a write row's goip side names a
# file in it for GOIP_WRITE_OUT.
lassign [nlcap dir $SUBDIR] dir_rc capture_dir
set capture_dir [string trim [lindex [split $capture_dir "\n"] 0]]
if {$dir_rc != 0 || $capture_dir eq ""} {
    vmlib::log "FATAL: could not resolve the capture directory (rc=$dir_rc)"
    puts "GOIP_PARITY_DRIVER_FAIL"
    exit 3
}

# The restore and showdump rows read `< <slug>.save` from the capture
# directory, where every row's command runs. Copied once, before any row,
# from the store path the runner passed; they then ship in the blob beside
# the captures.
vmlib::must "cp $save_blobs/restore_fresh.save $save_blobs/restore_existing.save $save_blobs/route_save.save $save_blobs/rule_save.save $capture_dir/"

set table [read_command_table]
vmlib::log "=== capturing [llength $table] commands x 3 sides ==="

foreach row $table {
    capture_triple $row $DUMMY
    if {[llength $short_caps] > 0 && !$keep_going} {
        vmlib::log "stopping after a missed floor; pass --keep-going to continue"
        break
    }
}

###############################################################################
# compare, in the guest
###############################################################################

set flags ""
if {$no_allowlist} {
    set flags " -no-allowlist"
}

vmlib::log "=== comparing in $capture_dir ==="

# Two round trips, not one `| tee`.
#
# A pipeline's `$?` is the LAST stage's status, so `compare ... | tee` would
# have handed back tee's exit code - which is 0 whether or not the comparator
# found anything. The driver's whole verdict is that number. `set -o pipefail`
# would have fixed it and would have left the correctness of this run resting
# on a shell option set over a serial console; running the comparator on its
# own and reading the file afterwards leaves nothing to get wrong.
#
# Redirecting to a file rather than reading stdout directly also means the
# report ships in the blob beside the captures it describes, which is what
# makes a failing run actionable.
lassign [vmlib::run_out \
    "goip-parity compare -dir $capture_dir$flags > $capture_dir/report.txt 2>&1" \
    300] cmp_rc _cmp_out
lassign [vmlib::run_out "cat $capture_dir/report.txt" 300] read_rc report
if {$read_rc != 0} {
    vmlib::log "FATAL: the comparator wrote no readable report (rc=$read_rc)"
    puts "GOIP_PARITY_DRIVER_FAIL"
    exit 3
}

# Echoed verbatim to this driver's stdout, which the host runner tees to the
# transcript. The sentinels are the interface - the runner greps them - so
# reformatting them here would break the thing that reads them.
puts ""
puts $report
puts ""

###############################################################################
# ship the evidence
###############################################################################

lassign [nlcap inventory] inv_rc inventory
vmlib::log "captured [llength [split [string trim $inventory] "\n"]] files"

vmlib::log "=== packing ==="
# 600 s: the blob is a few thousand wrapped base64 lines and expect matches
# one line at a time.
lassign [vmlib::run_out "xtcp2-nlcap pack" 600] pack_rc blob
if {$pack_rc != 0} {
    vmlib::log "WARNING: pack failed (rc=$pack_rc); the verdict below still stands"
} else {
    set fh [open $blob_out w]
    puts $fh $blob
    close $fh
    vmlib::log "wrote [string length $blob] bytes of base64 to $blob_out"
}

vmlib::run "xtcp2-nlcap ns-del $NS"
vmlib::poweroff

###############################################################################
# verdict
#
# The comparator's own exit status decides it. This driver adds context - what
# was skipped, what missed a floor, what topology the kernel refused - but it
# does not second-guess the verdict, because then there would be two verdicts.
###############################################################################

puts ""
set refused [nltopo::refused_steps]
if {[llength $refused] > 0} {
    puts "GOIP_PARITY_TOPO_REFUSED [llength $refused]"
    foreach t $refused {
        puts "  $t"
    }
    puts "  Any command whose parity depends on those objects is comparing a"
    puts "  smaller topology than intended. Not a failure by itself."
}

if {[llength $skipped] > 0} {
    puts "GOIP_PARITY_DRIVER_SKIPPED [llength $skipped]"
    foreach s $skipped {
        puts "  $s"
    }
}

if {[llength $write_skipped] > 0} {
    puts "GOIP_PARITY_WRITE_SETUP_REFUSED [llength $write_skipped]"
    foreach s $write_skipped {
        puts "  $s"
    }
    puts "  A refused precondition step skipped those sides (or, for a read"
    puts "  row, the whole row), so their rows are MISSING above."
}

if {[llength $short_caps] > 0} {
    puts "GOIP_PARITY_MISSED_FLOOR [llength $short_caps]"
    foreach c $short_caps {
        puts "  $c"
    }
    puts "  Those came in short (twice for a read, once for a write) and were"
    puts "  DISCARDED rather than written,"
    puts "  so the command is MISSING above rather than compared against a"
    puts "  truncated capture."
}

if {$cmp_rc != 0} {
    puts "GOIP_PARITY_DRIVER_FAIL"
    exit 1
}

puts "GOIP_PARITY_DRIVER_PASS"
exit 0

#!/usr/bin/env expect
###############################################################################
# rtnl-read-corpus-test.exp - table-driven test for rtnl-read-corpus.exp,
# with no microVM and no console
#
# Usage: rtnl-read-corpus-test.exp
#
# Run by nix/checks/vm-lib-exp.nix after rtnl-write-corpus-test.exp, the same
# way: the corpus is data, and its step proc is driven through a recorder
# that replaces vmlib::run_out, so no shell is needed.
#
# The names and steps are written out again below as literals rather than
# read from the corpus, so a row dropped or changed there has to disagree
# with something that was not edited with it.
#
# What this does NOT cover: what the guest runs or what the kernel answers.
# TestRtnlReadCorpus in pkg/xtcpnl pins that in the committed fixtures.
#
# Every row has a name, a description that starts with its class
# (positive/negative/boundary/corner) and an expected value.
###############################################################################

set here [file dirname [info script]]
source $here/vm-lib.exp
source $here/netlink-topology.exp
source $here/rtnl-read-corpus.exp

vmlib::init

set pass 0
set fail 0

###############################################################################
# The recorder, as in rtnl-write-corpus-test.exp.
###############################################################################
set ::calls {}
set ::refuse ""
proc vmlib::run_out {cmd {cmd_timeout ""} {quiet 0}} {
    lappend ::calls $cmd
    if {$::refuse ne "" && [regexp -- $::refuse $cmd]} {
        return [list 1 "REFUSED"]
    }
    return [list 0 "ok"]
}

# check <name> <description> <script> <expected> - the script's result, or
# ERROR if it raised one, must equal expected.
proc check {name description script expected} {
    global pass fail
    if {[catch {uplevel #0 $script} got]} {
        set got ERROR
    }
    if {$got eq $expected} {
        puts "PASS: $name - $description"
        incr pass
    } else {
        puts "FAIL: $name - $description"
        puts "      got \[$got\] want \[$expected\]"
        incr fail
    }
}

proc column {rows i} {
    set out {}
    foreach r $rows {
        lappend out [lindex $r $i]
    }
    return $out
}

set ALL [concat $rtnlread::empty_rows $rtnlread::rows]

###############################################################################
# 1. the rows
###############################################################################
set design_rows {
    netlink_route_getroute_mroute netlink_route_getroute_mroute6
    netlink_route_getrule_mrule netlink_route_getstats_xstats_bridge
    netlink_route_getstats_xstats_bridge_slave netlink_route_getstats_afstats
    netlink_route_getnsid_list netlink_route_getlink_token
    netlink_route_getlink_tunnel netlink_route_getlink_tunnel6
    netlink_route_getlink_tuntap
}

# Rows that are not {name floor command stdout}.
proc bad_arity {} {
    set out {}
    foreach r $::ALL {
        if {[llength $r] != 4} {
            lappend out [lindex $r 0]
        }
    }
    return $out
}

# Every name and stdout name used more than once.
proc dups {} {
    set seen {}
    set out {}
    foreach n [concat [column $::ALL 0] [column $::ALL 3]] {
        if {$n in $seen} {
            lappend out $n
        }
        lappend seen $n
    }
    return $out
}

# Names that are not netlink_route_<lower case, digits, underscore>, and
# stdout names that are not ip_<the same>.
proc bad_names {} {
    set out {}
    foreach r $::ALL {
        lassign $r name floor command sout
        if {![regexp {^netlink_route_[a-z0-9_]+$} $name]} {
            lappend out $name
        }
        if {![regexp {^ip_[a-z0-9_]+$} $sout]} {
            lappend out $sout
        }
    }
    return $out
}

# Rows whose floor is not 2: every one is a dump that may hold nothing.
proc bad_floors {} {
    set out {}
    foreach r $::ALL {
        if {[lindex $r 1] != 2} {
            lappend out [lindex $r 0]
        }
    }
    return $out
}

# Everything the driver passes inside single quotes.
proc quoted {} {
    set out {}
    foreach s [concat [column $::ALL 2] [list $rtnlread::MROUTE_CONF $rtnlread::TUNNEL_NOTE]] {
        if {[string first ' $s] >= 0} {
            lappend out $s
        }
    }
    return $out
}

check row_names "positive: the rows are the plan's, in run order" \
    {column $rtnlread::rows 0} [join $design_rows " "]
check empty_row "boundary: the one empty row is ip mroute show before any entry" \
    {lindex $rtnlread::empty_rows 0} \
    {netlink_route_getroute_mroute_empty 2 {ip mroute show} ip_mroute_empty}
check empty_same_command "corner: and is the populated row's command" \
    {expr {[lindex $rtnlread::empty_rows 0 2] eq [lindex $rtnlread::rows 0 2]}} 1
check arity "negative: every row is {name floor command stdout}" {bad_arity} {}
check unique "negative: no name or stdout name is used twice" {dups} {}
check names "corner: every name is netlink_route_<x> and every stdout ip_<x>" {bad_names} {}
check floors "boundary: every floor is the request and its NLMSG_DONE" {bad_floors} {}
check no_single_quotes "corner: nothing passed in single quotes holds one" {quoted} {}

###############################################################################
# 2. the state
###############################################################################
proc build_index {prefix} {
    set i 0
    foreach s $rtnlread::build {
        if {[string match $prefix $s]} {
            return $i
        }
        incr i
    }
    return -1
}

check mroute_conf "positive: the multicast route is (192.0.2.10, 239.1.1.1) from v0 to v1" \
    {set rtnlread::MROUTE_CONF} {mroute from v0 source 192.0.2.10 group 239.1.1.1 to v1}
check mroute_group_parse "positive: mroute-start's group pattern finds the group" \
    {regexp -inline { group ([0-9.]*)} $rtnlread::MROUTE_CONF} {{ group 239.1.1.1} 239.1.1.1}
check mroute_devs_veth "corner: both VIF devices are veths, since a dummy has no IFF_MULTICAST" \
    {list [build_index {topo link add v0 type veth *}] [build_index {topo link add v1 type veth *}]} {0 1}
check token_after_up "corner: the token is set after v0 is up" \
    {expr {[build_index {topo token set *}] > [build_index {topo link set v0 up}]}} 1
check peers "positive: two peers, for two NEWNSID replies" \
    {rtnlread::peers} {nlcaprp1 nlcaprp2}
check peer_ids "boundary: the peers' nsids are distinct" \
    {lmap s [lsearch -all -inline -index 0 $rtnlread::build peer] {lindex $s 2}} {1 2}
check tunnel_note "positive: the tunnel note says the ioctl half is missing" \
    {string match "*SIOCGETTUNNEL*" $rtnlread::TUNNEL_NOTE} 1

###############################################################################
# 3. steps through the recorder
###############################################################################

# run_build - every build step through the recorder: the number accepted,
# the number refused, and whether any raised.
proc run_build {} {
    set ok 0
    set no 0
    foreach s $rtnlread::build {
        if {[rtnlread::step nlcapr reads $s]} {
            incr ok
        } else {
            incr no
        }
    }
    return [list $ok $no]
}

set ::calls {}
set ::refuse ""
nltopo::reset
check build_all_accepted "positive: every build step is well-formed and accepted" \
    {run_build} {18 0}
check peer_root_add "positive: a peer is added from the root, then given its nsid in the namespace" \
    {lrange $::calls end-3 end} \
    {{ip netns add nlcaprp1} {xtcp2-nlcap topo nlcapr reads netns set nlcaprp1 1} {ip netns add nlcaprp2} {xtcp2-nlcap topo nlcapr reads netns set nlcaprp2 2}}

set ::calls {}
set ::refuse {^ip netns add nlcaprp1$}
nltopo::reset
check peer_refused "negative: a refused peer add is a refused step, and no nsid is set" \
    {list [rtnlread::step nlcapr reads {peer nlcaprp1 1}] [nltopo::refused_steps] [llength $::calls]} \
    {0 {{ip netns add nlcaprp1}} 1}

set ::refuse {topo nlcapr reads tuntap add }
nltopo::reset
check topo_refused "negative: a refused topo step is a refused step" \
    {list [rtnlread::step nlcapr reads {topo tuntap add dev tap0 mode tap}] [nltopo::refused_steps]} \
    {0 {{ip -n nlcapr tuntap add dev tap0 mode tap}}}
set ::refuse ""

check peer_arity "negative: a peer step without an id is an error" \
    {rtnlread::step nlcapr reads {peer nlcaprp1}} ERROR
check unknown_kind "negative: an unknown step kind is an error" \
    {rtnlread::step nlcapr reads {root ip link}} ERROR

###############################################################################
# summary
###############################################################################
puts ""
puts "=== rtnl-read-corpus.exp: $pass passed, $fail failed ==="
if {$fail > 0} {
    puts "RTNLREAD_TEST_FAIL"
    exit 1
}
puts "RTNLREAD_TEST_PASS"
exit 0

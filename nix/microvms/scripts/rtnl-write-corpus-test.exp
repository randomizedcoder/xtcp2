#!/usr/bin/env expect
###############################################################################
# rtnl-write-corpus-test.exp - table-driven test for rtnl-write-corpus.exp,
# with no microVM and no console
#
# Usage: rtnl-write-corpus-test.exp
#
# Run by nix/checks/vm-lib-exp.nix after addr-corpus-test.exp, the same way:
# the corpus is data, and the procs it has (ipmon, readback_args,
# rc_problem) and the one it borrows (addrcorpus::pre_step) are driven
# through a recorder that replaces vmlib::run_out, so no shell is needed.
#
# The slugs, readbacks and statuses are written out again below as literals
# rather than read from the corpus, so a row dropped or changed there has to
# disagree with something that was not edited with it.
#
# What this does NOT cover: what the guest runs or what the kernel answers.
# TestRtnlWriteCorpus in pkg/xtcpnl pins that in the committed fixtures.
#
# Every row has a name, a description that starts with its class
# (positive/negative/boundary/corner) and an expected value.
###############################################################################

set here [file dirname [info script]]
source $here/vm-lib.exp
source $here/netlink-topology.exp
source $here/addr-topology.exp
source $here/addr-corpus.exp
source $here/rtnl-write-corpus.exp

vmlib::init

set pass 0
set fail 0

###############################################################################
# The recorder, as in addr-corpus-test.exp.
###############################################################################
set ::calls {}
set ::refuse ""
proc vmlib::run_out {cmd {cmd_timeout ""} {quiet 0}} {
    lappend ::calls $cmd
    if {$::refuse ne "" && [regexp -- $::refuse $cmd]} {
        return [list 1 "REFUSED"]
    }
    return [list 0 "ok"]
}

# check <name> <description> <script> <expected> - the script's result, or
# ERROR if it raised one, must equal expected.
proc check {name description script expected} {
    global pass fail
    if {[catch {uplevel #0 $script} got]} {
        set got ERROR
    }
    if {$got eq $expected} {
        puts "PASS: $name - $description"
        incr pass
    } else {
        puts "FAIL: $name - $description"
        puts "      got \[$got\] want \[$expected\]"
        incr fail
    }
}

set R $rtnlcorpus::rows

proc slugs {rows} {
    set out {}
    foreach r $rows {
        lappend out [lindex $r 0]
    }
    return $out
}

proc field {slug i} {
    return [lindex [lsearch -exact -index 0 -inline $::R $slug] $i]
}

# readback_names <slug> - the names of a row's readbacks, in order.
proc readback_names {slug} {
    set out {}
    foreach rb [field $slug 4] {
        lappend out [lindex $rb 0]
    }
    return $out
}

###############################################################################
# 1. the rows
###############################################################################
set design_rows {
    rule_del rule_del_missing addrlabel_del nexthop_del ntable_change
    ntable_change_missing ntable_change_thresh_netns stats_set_l3 netns_set
    nsid_del_event anycast_del_event
    neigh_add neigh_add_existing neigh_change neigh_change_missing
    neigh_replace neigh_del neigh_flush neigh_flush_empty neigh_get
    neigh_get_missing rule_add_selectors rule_add_existing rule_flush
    rule_save rule_restore nexthop_add_single nexthop_add_group
    nexthop_add_resilient nexthop_add_existing nexthop_replace nexthop_flush
    nexthop_flush_empty nexthop_get nexthop_get_missing nexthop_bucket_show
    nexthop_bucket_get addrlabel_add addrlabel_flush link_altname_add
    link_altname_del link_altname_taken token_set token_set_noarp route_get
    route_get_fibmatch route_get_notify route_get_v6 route_get_from_iif
    route_get_unreachable route_flush route_flush_empty route_flush_no_table
    route_save route_restore
    prefix_event prefix_no_monitor monitor_all monitor_all_timestamp
}

proc bad_arity {} {
    set out {}
    foreach r $::R {
        if {[llength $r] != 6} {
            lappend out [lindex $r 0]
        }
    }
    return $out
}

proc dup_slugs {} {
    set seen {}
    set out {}
    foreach s [slugs $::R] {
        if {$s in $seen} {
            lappend out $s
        }
        lappend seen $s
    }
    return $out
}

# refused_rows - {slug rc} for every row whose ip.rc is meant to be non-zero.
proc refused_rows {} {
    set out {}
    foreach r $::R {
        if {[lindex $r 5] != 0} {
            lappend out [lindex $r 0] [lindex $r 5]
        }
    }
    return $out
}

# Every row whose status is not 0 or 2, which is all ip exits with.
proc bad_rc {} {
    set out {}
    foreach r $::R {
        if {[lindex $r 5] ni {0 2}} {
            lappend out [lindex $r 0]
        }
    }
    return $out
}

check slug_list "positive: the rows are the plan's, in run order" \
    {slugs $R} [join $design_rows " "]
check arity "negative: every row is {slug floor pre command readbacks rc}" \
    {bad_arity} {}
check unique_slugs "negative: no slug names two rows" \
    {dup_slugs} {}
set refused_design {
    rule_del_missing 2 ntable_change_missing 2 ntable_change_thresh_netns 2
    neigh_add_existing 2 neigh_change_missing 2 neigh_get_missing 2
    rule_add_existing 2 nexthop_add_existing 2 nexthop_get_missing 2
    link_altname_taken 2 token_set_noarp 2 route_get_unreachable 2
    route_flush_no_table 2
}
check refused_statuses "positive: exactly the refusal rows expect rc 2" \
    {refused_rows} [join $refused_design " "]
check row_count "boundary: C1-T01's 11 rows, C1-T02's 44 and C1-T04's 4" \
    {llength $R} 59
check c1t01_rows_first "corner: C1-T02's rows come after C1-T01's, which keep their order" \
    {lindex [slugs $R] 10} anycast_del_event
check c1t02_rows_next "corner: C1-T04's rows come after C1-T02's" \
    {lindex [slugs $R] 54} route_restore
check rc_values "boundary: every status is 0 or 2" \
    {bad_rc} {}

###############################################################################
# 2. readbacks
###############################################################################
foreach {name description slug expected} {
    rb_rule_del       "positive: rule_del reads the rules back"                  rule_del       getrule
    rb_addrlabel_del  "positive: addrlabel_del reads the labels back"            addrlabel_del  getaddrlabel
    rb_nexthop_del    "positive: nexthop_del reads the nexthops back"            nexthop_del    getnexthop
    rb_ntable_change  "positive: ntable_change reads arp_cache on d0 back"       ntable_change  getneightbl
    rb_stats_set_l3   "positive: stats_set_l3 reads the l3_stats subgroup back"  stats_set_l3   getstats
    rb_rule_missing   "negative: a refused write has nothing to read back"       rule_del_missing {}
    rb_ntable_missing "negative: nor does a refused ntable change"               ntable_change_missing {}
    rb_thresh_netns   "negative: nor the thresh1 change the netns refuses"       ntable_change_thresh_netns {}
    rb_netns_set      "corner: netns_set's readback is inside its own command"   netns_set      {}
    rb_nsid_event     "corner: an event row's readback is the monitor's stdout"  nsid_del_event {}
    rb_anycast_event  "corner: and so is the anycast event row's"                anycast_del_event {}
    rb_neigh_add      "positive: neigh_add reads d0's neighbors back"            neigh_add      getneigh
    rb_neigh_flush    "positive: neigh_flush reads what the flush left"          neigh_flush    getneigh
    rb_neigh_get      "corner: a get is its own readback"                        neigh_get      {}
    rb_selectors      "positive: the selector rules are read back in both families" rule_add_selectors {getrule getrule6}
    rb_rule_restore   "positive: rule_restore reads the restored rules back"     rule_restore   getrule
    rb_rule_save      "corner: a save's readback is its ip.save"                 rule_save      {}
    rb_nh_resilient   "positive: the resilient group is read back"               nexthop_add_resilient getnexthop
    rb_nh_flush       "positive: nexthop_flush reads the empty table back"       nexthop_flush  getnexthop
    rb_addrlabel_add  "positive: addrlabel_add reads the labels back"            addrlabel_add  getaddrlabel
    rb_altname_add    "positive: link_altname_add reads d0 back"                 link_altname_add getlink
    rb_altname_taken  "negative: a refused altname has nothing to read back"     link_altname_taken {}
    rb_token_set      "positive: token_set reads the token back"                 token_set      gettoken
    rb_route_flush    "positive: route_flush reads table 100 back"               route_flush    getroute
    rb_route_restore  "positive: route_restore reads table 100 back"             route_restore  getroute
    rb_flush_empty    "boundary: an empty flush has nothing to read back"        route_flush_empty {}
    rb_prefix_event   "corner: the prefix event row's readback is the monitor's stdout" prefix_event {}
    rb_no_monitor     "positive: with no monitor, r0's routes are read back for the RA's" prefix_no_monitor getroute6
    rb_monitor_all    "corner: and monitor_all's is its stdout"                  monitor_all    {}
} {
    check $name $description [list readback_names $slug] $expected
}

check netns_set_lists_ids "corner: netns_set lists the ids before it deletes its peer" \
    {regexp {ip netns set c1set 7 && ip netns list-id; ip netns del c1set$} [field netns_set 3]} 1

check readback_args_shape "positive: a readback is a capio of netlink_route_<name> into ip_<name>" \
    {rtnlcorpus::readback_args lacpa rtnl/rule_del {getrule 2 {ip rule show}}} \
    {lacpa rtnl/rule_del netlink_route_getrule 2 {ip rule show} ip_getrule}
check readback_args_short "negative: a two-field readback is an error" \
    {rtnlcorpus::readback_args lacpa rtnl/x {getrule 2}} ERROR
check readback_args_long "negative: a four-field readback is an error" \
    {rtnlcorpus::readback_args lacpa rtnl/x {getrule 2 {ip rule show} extra}} ERROR

###############################################################################
# 3. floors and quoting
###############################################################################

# Rows under their structural floor: 2 for the write and its answer, 4 when
# the command names d0 outside a monitor trigger (the RTM_GETLINK by name
# first) or is an `ip ntable` (its link dump first), and every readback 2 or
# more.
proc bad_floors {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command readbacks
        set want 2
        if {![string match xtcp2-nl-ipmon* $command] && [string match "*dev d0*" $command]} {
            set want 4
        }
        if {[string match "ip ntable *" $command]} {
            set want 4
        }
        if {$floor < $want} {
            lappend out $slug
        }
        foreach rb $readbacks {
            if {[lindex $rb 1] < 2} {
                lappend out $slug/[lindex $rb 0]
            }
        }
    }
    return $out
}

proc quoted {} {
    set out {}
    foreach r $::R {
        lassign $r slug floor pre command readbacks
        if {[string first ' $command] >= 0} {
            lappend out $slug
        }
        foreach rb $readbacks {
            if {[string first ' [lindex $rb 2]] >= 0} {
                lappend out $slug/[lindex $rb 0]
            }
        }
    }
    return $out
}

# Names that would break the capture's netlink_<proto>_ name guard or a file
# name: lower case, digits and underscore only.
proc bad_names {} {
    set out {}
    foreach r $::R {
        foreach rb [lindex $r 4] {
            if {![regexp {^[a-z0-9_]+$} [lindex $rb 0]]} {
                lappend out [lindex $rb 0]
            }
        }
    }
    return $out
}

check floors "boundary: no row or readback is under its structural floor" \
    {bad_floors} {}
check floor_dev_rows "boundary: the two d0 writes count the name lookup" \
    {list [field ntable_change 1] [field stats_set_l3 1]} {4 4}
check floor_ntable_rows "boundary: every ntable row counts the link dump ip takes first" \
    {list [field ntable_change_missing 1] [field ntable_change_thresh_netns 1]} {4 4}
# rule_adds - the number of `ip rule add`s in a row's command.
proc rule_adds {slug} {
    return [regexp -all {ip (-6 )?rule add } [field $slug 3]]
}

check floor_selectors "boundary: rule_add_selectors' floor is 2 for each of its 14 adds" \
    {list [rule_adds rule_add_selectors] [field rule_add_selectors 1]} {14 28}
check floor_bucket_show "boundary: the bucket dump's floor is the request and two reply datagrams" \
    {field nexthop_bucket_show 1} 3
check floor_event_rows "positive: the event rows' floors are two thirds of the measured run" \
    {lmap slug {nsid_del_event anycast_del_event prefix_event monitor_all monitor_all_timestamp} {field $slug 1}} \
    {14 20 11 36 36}
check floor_no_monitor "boundary: prefix_no_monitor's floor is two route reads, each a name lookup and a dump" \
    {list [regexp -all {ip -6 route show dev r0} [field prefix_no_monitor 3]] [field prefix_no_monitor 1]} {2 8}
check no_single_quotes "corner: no command or readback holds a single quote" \
    {quoted} {}
check readback_names_safe "corner: every readback name is lower case, digits and underscore" \
    {bad_names} {}

###############################################################################
# 3a. C1-T02's states
###############################################################################
check restore_copies_rule_save "positive: rule_restore restores rule_save's blob" \
    {field rule_restore 3} {cp ../rule_save/ip.save . && ip rule restore < ip.save}
check restore_copies_route_save "positive: route_restore restores route_save's blob" \
    {field route_restore 3} {cp ../route_save/ip.save . && ip route restore < ip.save}
check saves_before_restores "corner: each save runs before the restore that copies it" \
    {list [expr {[lsearch [slugs $R] rule_save] < [lsearch [slugs $R] rule_restore]}] \
          [expr {[lsearch [slugs $R] route_save] < [lsearch [slugs $R] route_restore]}]} {1 1}
check flush_empty_table_exists "boundary: route_flush_empty's table is made and emptied first" \
    {lrange [field route_flush_empty 2] end-1 end} \
    {{route add 203.0.113.0/24 dev d0 table 100} {route del 203.0.113.0/24 dev d0 table 100}}
check flush_no_table "negative: route_flush_no_table has no table 100 at all" \
    {field route_flush_no_table 2} {}
check resilient_buckets "corner: the bucket rows' group has 1024 buckets" \
    {string match "*type resilient buckets 1024*" [lindex [field nexthop_bucket_show 2] end]} 1
check neigh_veth "corner: neighbor rows use a veth, which does neighbor discovery" \
    {lindex [field neigh_add 2] 0} {link add d0 type veth peer name d1}
check token_noarp_dummy "negative: token_set_noarp's d0 is a dummy (IFF_NOARP)" \
    {lindex [field token_set_noarp 2] 0} {link add d0 type dummy}
check flush_skips_permanent "corner: neigh_flush's entries are stale, since a flush skips permanent ones" \
    {regexp -all {nud stale} [field neigh_flush 2]} 2

###############################################################################
# 4. event rows
###############################################################################
check ipmon_line "positive: ipmon builds the monitor, its trigger and each pattern" \
    {rtnlcorpus::ipmon nsid {ip netns del p} {{^a } {b}}} \
    {xtcp2-nl-ipmon c0 "monitor nsid maddress" "ip netns del p" "^a " "b"}
check ipmon_no_pattern "boundary: no pattern gives no trailing argument" \
    {rtnlcorpus::ipmon acaddress {true} {}} \
    {xtcp2-nl-ipmon c0 "monitor acaddress maddress" "true"}
check nsid_waits_for_delete "positive: the nsid row waits for the add and the Deleted line" \
    {regexp {"\^nsid 7 " "\^Deleted nsid 7 "$} [field nsid_del_event 3]} 1
check anycast_waits_for_delete "positive: the anycast row waits for the Deleted any line" \
    {regexp {"Deleted \.\*any 2001:db8:1:: "$} [field anycast_del_event 3]} 1
check event_rows_have_canary "corner: both event rows build c0 for the canary" \
    {list [expr {{link add c0 type dummy} in [field nsid_del_event 2]}] \
          [expr {{link add c0 type dummy} in [field anycast_del_event 2]}]} {1 1}
check anycast_forwarding_first "corner: forwarding is set before d0 exists" \
    {lindex [field anycast_del_event 2] 0} {sysctl net.ipv6.conf.default.forwarding 1}

# C1-T04's event rows.
check ipmon_all "positive: an all monitor takes its options first and no maddress" \
    {rtnlcorpus::ipmon all {true} {} -t} {xtcp2-nl-ipmon c0 "-t monitor all" "true"}
check all_netconf_inet "corner: the netconf pattern names the family as ip prints it, inet" \
    {lsearch -inline $rtnlcorpus::UNTIL_ALL {*forwarding*}} {inet d0 forwarding on}
check ipmon_opts_object "boundary: options before a named object keep maddress" \
    {rtnlcorpus::ipmon prefix {true} {} -t} {xtcp2-nl-ipmon c0 "-t monitor prefix maddress" "true"}
check prefix_event_waits "positive: the prefix row sends the RA and waits for the prefix line" \
    {field prefix_event 3} \
    {xtcp2-nl-ipmon c0 "monitor prefix maddress" "xtcp2-nl-ra r0p fe80::2 2001:db8:5::/64" "prefix 2001:db8:5::/64"}
check no_monitor_unsubscribed "negative: prefix_no_monitor runs no monitor, so nothing joins the prefix group" \
    {string match *xtcp2-nl-ipmon* [field prefix_no_monitor 3]} 0
check no_monitor_status "corner: prefix_no_monitor's status is the last route test" \
    {string match "*; ip -6 route show dev r0 | grep -q 2001:db8:5::" [field prefix_no_monitor 3]} 1
check timestamp_row_only_t "corner: monitor_all_timestamp is monitor_all with -t" \
    {expr {[string map {{"-t monitor all"} {"monitor all"}} [field monitor_all_timestamp 3]] eq [field monitor_all 3]}} 1
check all_waits_every_group "positive: monitor_all waits for every group its trigger fires" \
    {llength $rtnlcorpus::UNTIL_ALL} 8
check all_triggers "positive: monitor_all's trigger is one command per group, the RA last" \
    {list [llength [split $rtnlcorpus::TRIGGER_ALL ";"]] [lindex [split $rtnlcorpus::TRIGGER_ALL ";"] end]} \
    {8 { xtcp2-nl-ra r0p fe80::2 2001:db8:5::/64}}
check c1t04_canary "corner: the monitored C1-T04 rows build c0 for the canary" \
    {lmap slug {prefix_event monitor_all monitor_all_timestamp} {expr {{link add c0 type dummy} in [field $slug 2]}}} {1 1 1}
check all_forwarding_first "corner: monitor_all sets forwarding before d0 and r0 exist" \
    {lindex [field monitor_all 2] 0} {sysctl net.ipv6.conf.default.forwarding 1}

# ra_index <prefix> - the index of PRE_RA's first step that starts <prefix>.
proc ra_index {prefix} {
    return [lsearch -glob $rtnlcorpus::PRE_RA "$prefix*"]
}
check ra_sysctls "positive: r0 takes an RA although it forwards (2), and from a local source" \
    {lsearch -all -inline -glob $rtnlcorpus::PRE_RA {sysctl *}} \
    {{sysctl net.ipv6.conf.r0.accept_ra 2} {sysctl net.ipv6.conf.r0.accept_ra_from_local 1}}
check ra_receiver_after_add "boundary: r0's sysctls follow its creation and precede its up" \
    {expr {[ra_index {link add r0 }] < [ra_index {sysctl net.ipv6.conf.r0.accept_ra 2}]
        && [ra_index {sysctl net.ipv6.conf.r0.accept_ra_from_local 1}] < [ra_index {link set r0 up}]}} 1
check ra_source_nodad "corner: the RA's source is fe80::2 on r0p, without DAD" \
    {lindex $rtnlcorpus::PRE_RA end} {-6 addr add fe80::2/64 dev r0p nodad}

###############################################################################
# 5. pre steps through addrcorpus::pre_step
###############################################################################

# Every pre step of every row, run through the recorder: the number of steps
# that raised (a malformed sysctl) and the number that were refused.
proc run_all_pre {} {
    set raised 0
    set refused 0
    foreach r $::R {
        foreach step [lindex $r 2] {
            if {[catch {addrcorpus::pre_step lacpa rtnl/[lindex $r 0] $step} ok]} {
                incr raised
            } elseif {!$ok} {
                incr refused
            }
        }
    }
    return [list $raised $refused]
}

set ::refuse ""
nltopo::reset
check pre_steps_dispatch "positive: every pre step is well-formed and accepted" \
    {run_all_pre} {0 0}
set ::refuse {^xtcp2-nlcap topo .* rule add }
nltopo::reset
check pre_rule_refused "negative: a refused rule add is a refused step" \
    {list [addrcorpus::pre_step lacpa rtnl/rule_del [lindex [field rule_del 2] 0]] \
          [nltopo::refused_steps]} \
    {0 {{ip -n lacpa rule add pref 100 from 192.0.2.0/24 table 100}}}
set ::refuse ""

###############################################################################
# 6. rc_problem
###############################################################################
foreach {name description want got expected} {
    rc_ok           "positive: the expected status is no problem"       0 "0\n" ""
    rc_refused_ok   "positive: an expected refusal is no problem"       2 "2"   ""
    rc_unexpected   "negative: an accepted write that should be refused" 2 "0"  "rtnl/x/ip.rc is 0, want 2"
    rc_failed       "negative: a refusal where an ACK was expected"     0 "2"   "rtnl/x/ip.rc is 2, want 0"
    rc_unreadable   "boundary: an empty file is unreadable"             0 ""    "rtnl/x/ip.rc unreadable, want 0"
    rc_whitespace   "corner: surrounding whitespace is ignored"         0 " 0 " ""
} {
    check $name $description [list rtnlcorpus::rc_problem x $want $got] $expected
}

###############################################################################
# summary
###############################################################################
puts ""
puts "=== rtnl-write-corpus.exp: $pass passed, $fail failed ==="
if {$fail > 0} {
    puts "RTNLCORPUS_TEST_FAIL"
    exit 1
}
puts "RTNLCORPUS_TEST_PASS"
exit 0

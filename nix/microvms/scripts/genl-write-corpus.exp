###############################################################################
# genl-write-corpus.exp - generic netlink reads and writes the corpus had no
# capture of (docs/netlink/goip-parity-gaps.md, C2)
#
# Sourced AFTER vm-lib.exp, netlink-topology.exp, addr-topology.exp and
# addr-corpus.exp, by scripts/capture-link-writes.exp, which runs each row
# into link-write/genl/<slug>/ with `--proto generic`. Data plus small procs,
# as rtnl-write-corpus.exp is, so the hermetic check
# (scripts/genl-write-corpus-test.exp) can read it without a console.
#
# A ROW IS {slug floor pre command readbacks rc}, as in rtnl-write-corpus.exp.
#
#   slug       the fixture directory, link-write/genl/<slug>/
#   floor      a structural minimum of datagrams: 2 for the family lookup
#              every `ip` genl command starts with (CTRL_CMD_GETFAMILY and
#              its NEWFAMILY, which each pcap keeps, since the family id is
#              assigned at boot and only that answer names it), then 2 for
#              the command and its answer: a GET and its reply or refusal, a
#              DEL and its ACK, or a dump and its NLMSG_DONE. A flush that
#              is not `flush all` is a dump, a DEL for each match and a
#              second dump, so 6
#   pre        steps run in the row's fresh namespace before the capture
#              window opens: pre_step below
#   command    run with `sh -c` from the row's directory (xtcp2-nlcap
#              write); it must contain no single quote
#   readbacks  {name floor command} reads, each one capio in the same
#              namespace straight after the command, as
#              netlink_generic_<name>.pcap and ip_<name>
#   rc         the exit status `ip.rc` must hold: 0, or the status `ip`
#              exits with when the kernel refuses the request, which ip/ip.c
#              takes from the command's negated return: 2 for tcp_metrics
#              (ip/tcp_metrics.c returns -2), 1 for an sr or ioam write
#              (ip/ipseg6.c and ip/ipioam6.c return -1)
#
# TCP_METRICS (C2-T01)
#
# The kernel makes a tcp_metrics entry when a connection with an RTT sample
# closes (tcp_update_metrics), keyed by its destination and source. A `tcp`
# pre step runs one connection inside the namespace with xtcp2-nl-tcp, so
# each address pair leaves two entries, one per end: 192.0.2.1 from
# 192.0.2.2 and 192.0.2.2 from 192.0.2.1, and the same for 2001:db8::1 and
# ::2.
#
# `src` comes before `address` in the two src rows. ip/tcp_metrics.c's
# argument loop steps past each address and its value twice, once in the
# body and once in the for, so the word after an address is skipped and
# `address A src B` reads B as a second address: "either "address" is
# duplicate", rc 255, before any netlink. `src B address A` skips `address`
# and reads A as the address, which is what the request then carries.
###############################################################################

namespace eval genlcorpus {

    # d0, a dummy that is up, with an IPv4 and an IPv6 pair on it: the
    # namespace's lo carries the traffic, and the entries are keyed by these.
    variable PRE_ADDRS {
        {link add d0 type dummy}
        {link set d0 up}
        {addr add 192.0.2.1/24 dev d0}
        {addr add 192.0.2.2/24 dev d0}
        {-6 addr add 2001:db8::1/64 dev d0 nodad}
        {-6 addr add 2001:db8::2/64 dev d0 nodad}
    }

    # The same with a connection over each pair: four entries.
    variable PRE_TCPM [concat $PRE_ADDRS {
        {tcp 192.0.2.1 192.0.2.2}
        {tcp 2001:db8::1 2001:db8::2}
    }]

    # The table after a write.
    variable TCPM_SHOW {{tcpm 4 {ip tcp_metrics show}}}

    variable rows [list \
        [list tcpm_show 4 $PRE_TCPM "ip tcp_metrics show" {} 0] \
        [list tcpm_show_empty 4 $PRE_ADDRS "ip tcp_metrics show" {} 0] \
        [list tcpm_show_v6 4 $PRE_TCPM "ip -6 tcp_metrics show" {} 0] \
        [list tcpm_get 4 $PRE_TCPM "ip tcp_metrics show address 192.0.2.1" {} 0] \
        [list tcpm_get_src 4 $PRE_TCPM "ip tcp_metrics show src 192.0.2.2 address 192.0.2.1" {} 0] \
        [list tcpm_get_v6 4 $PRE_TCPM "ip tcp_metrics show address 2001:db8::1" {} 0] \
        [list tcpm_get_missing 4 $PRE_TCPM "ip tcp_metrics show address 192.0.2.9" {} 2] \
        [list tcpm_delete 4 $PRE_TCPM "ip tcp_metrics delete address 192.0.2.1" $TCPM_SHOW 0] \
        [list tcpm_delete_src 4 $PRE_TCPM \
            "ip tcp_metrics delete src 192.0.2.2 address 192.0.2.1" $TCPM_SHOW 0] \
        [list tcpm_delete_missing 4 $PRE_TCPM "ip tcp_metrics delete address 192.0.2.9" {} 2] \
        [list tcpm_flush_all 4 $PRE_TCPM "ip tcp_metrics flush all" $TCPM_SHOW 0] \
        [list tcpm_flush_prefix 6 $PRE_TCPM "ip tcp_metrics flush 192.0.2.0/24" $TCPM_SHOW 0] \
        [list tcpm_flush_v6 6 $PRE_TCPM "ip -6 tcp_metrics flush" $TCPM_SHOW 0] \
        [list tcpm_flush_empty 4 $PRE_ADDRS "ip tcp_metrics flush 192.0.2.0/24" {} 0] \
    ]

    ###########################################################################
    # C2-T02 - sr, the SEG6 family: the HMAC keys and the tunnel source,
    # both per namespace.
    #
    # `ip sr hmac set` reads its secret through getpass(3), so each set row
    # pipes it in under `setsid -w`, which leaves `ip` no controlling
    # terminal for getpass to read instead (see cmd_hmac in
    # nix/microvms/netlink-capture.nix). A blank secret deletes the key. A
    # refused set exits 1, not 2: seg6_do_cmd returns -1 for a write and -2
    # only for a get.
    ###########################################################################
    variable PRE_HMAC1 {{hmac 1 sha256 s3cret}}
    variable PRE_HMAC2 {{hmac 1 sha256 s3cret} {hmac 2 sha1 0ther}}
    variable HMAC_SHOW {{hmac 4 {ip sr hmac show}}}

    # hmac_set <keyid> <algo> <secret> - the command that sets one key, or
    # deletes it when <secret> is "".
    proc hmac_set {keyid algo secret} {
        return "[string trim "echo $secret"] | setsid -w ip sr hmac set $keyid $algo"
    }

    # 65 characters, one more than SEG6_HMAC_SECRET_LEN, which the kernel
    # refuses; and 64, which it takes but `ip sr hmac show` prints only 63
    # of, with a warning on stderr.
    variable LONG_SECRET [string repeat x 65]
    variable MAX_SECRET [string repeat y 64]

    lappend rows \
        [list sr_hmac_show_empty 4 {} "ip sr hmac show" {} 0] \
        [list sr_hmac_set 4 {} [hmac_set 1 sha256 s3cret] $HMAC_SHOW 0] \
        [list sr_hmac_set_sha1 4 {} [hmac_set 2 sha1 0ther] $HMAC_SHOW 0] \
        [list sr_hmac_replace 4 $PRE_HMAC1 [hmac_set 1 sha1 n3w] $HMAC_SHOW 0] \
        [list sr_hmac_delete 4 $PRE_HMAC2 [hmac_set 1 sha256 ""] $HMAC_SHOW 0] \
        [list sr_hmac_delete_missing 4 {} [hmac_set 9 sha256 ""] {} 1] \
        [list sr_hmac_set_long 4 {} [hmac_set 3 sha256 $LONG_SECRET] {} 1] \
        [list sr_hmac_show 4 $PRE_HMAC2 "ip sr hmac show" {} 0] \
        [list sr_hmac_show_64 4 [list [list hmac 4 sha256 $MAX_SECRET]] "ip sr hmac show" {} 0] \
        [list sr_tunsrc_show 4 {} "ip sr tunsrc show" {} 0] \
        [list sr_tunsrc_set 4 {} "ip sr tunsrc set 2001:db8::1" {{tunsrc 4 {ip sr tunsrc show}}} 0]

    ###########################################################################
    # C2-T03 - ioam, the IOAM6 family: namespaces, schemas and the binding
    # between them, all per namespace, made with plain `ip` pre steps.
    #
    # The kernel keeps a namespace's data and wide data as all ones when
    # none is given, and leaves an all-ones value out of the dump, so data
    # 0xffffffff given explicitly reads back as no data. It pads a schema's
    # data to a multiple of 4 bytes with zeros. `ip` parses data in any base
    # and wide data in hex only. A refused write exits 1, as sr's do:
    # ioam6_do_cmd returns -1.
    #
    # The only IOAM6 event, TRACE, is sent when a packet with an IOAM trace
    # option arrives for a known namespace on a device with ioam6_enabled.
    # The monitor rows run `ip ioam monitor` inside xtcp2-nl-ioam, which
    # sends such packets to ::1 until the monitor prints, so their floor is
    # the family lookup and one event; a row where the kernel stays silent,
    # for an unknown namespace or with ioam6_enabled off, is the lookup
    # alone, and the helper exits 1.
    ###########################################################################
    variable PRE_NS1 {{ioam namespace add 1}}
    variable PRE_SC1 {{ioam schema add 1 abcd}}
    variable PRE_NS1_SC1 {{ioam namespace add 1} {ioam schema add 1 abcd}}
    variable PRE_BOUND {{ioam namespace add 1} {ioam schema add 1 abcd} {ioam namespace set 1 schema 1}}
    variable NS_SHOW {{ns 4 {ip ioam namespace show}}}
    variable SC_SHOW {{sc 4 {ip ioam schema show}}}
    variable BOTH_SHOW {{ns 4 {ip ioam namespace show}} {sc 4 {ip ioam schema show}}}
    variable PRE_TRACE {{ioam namespace add 123} {sysctl net.ipv6.conf.lo.ioam6_enabled 1}}

    lappend rows \
        [list ioam_ns_show_empty 4 {} "ip ioam namespace show" {} 0] \
        [list ioam_ns_add 4 {} "ip ioam namespace add 1" $NS_SHOW 0] \
        [list ioam_ns_add_data 4 {} "ip ioam namespace add 2 data 42 wide 2a" $NS_SHOW 0] \
        [list ioam_ns_add_unavailable 4 {} \
            "ip ioam namespace add 3 data 0xffffffff wide ffffffffffffffff" $NS_SHOW 0] \
        [list ioam_ns_add_dup 4 $PRE_NS1 "ip ioam namespace add 1" {} 1] \
        [list ioam_ns_del 4 $PRE_NS1 "ip ioam namespace del 1" $NS_SHOW 0] \
        [list ioam_ns_del_missing 4 {} "ip ioam namespace del 9" {} 1] \
        [list ioam_sc_show_empty 4 {} "ip ioam schema show" {} 0] \
        [list ioam_sc_add 4 {} "ip ioam schema add 1 abcd" $SC_SHOW 0] \
        [list ioam_sc_add_pad 4 {} "ip ioam schema add 2 abcde" $SC_SHOW 0] \
        [list ioam_sc_add_dup 4 $PRE_SC1 "ip ioam schema add 1 wxyz" {} 1] \
        [list ioam_sc_del 4 $PRE_SC1 "ip ioam schema del 1" $SC_SHOW 0] \
        [list ioam_sc_del_missing 4 {} "ip ioam schema del 9" {} 1] \
        [list ioam_ns_set_schema 4 $PRE_NS1_SC1 "ip ioam namespace set 1 schema 1" $BOTH_SHOW 0] \
        [list ioam_ns_set_none 4 $PRE_BOUND "ip ioam namespace set 1 schema none" $BOTH_SHOW 0] \
        [list ioam_ns_set_missing 4 $PRE_NS1 "ip ioam namespace set 1 schema 9" {} 1] \
        [list ioam_sc_del_bound 4 $PRE_BOUND "ip ioam schema del 1" $NS_SHOW 0] \
        [list ioam_ns_del_bound 4 $PRE_BOUND "ip ioam namespace del 1" $SC_SHOW 0] \
        [list ioam_monitor_trace 3 $PRE_TRACE "xtcp2-nl-ioam ::1 123" {} 0] \
        [list ioam_monitor_unknown_ns 2 $PRE_TRACE "xtcp2-nl-ioam ::1 99 5" {} 1] \
        [list ioam_monitor_disabled 2 {{ioam namespace add 123}} "xtcp2-nl-ioam ::1 123 5" {} 1]

    ###########################################################################
    # pre_step <ns> <subdir> <step> - 1 if the step was taken, else 0.
    #
    # `tcp SERVER CLIENT` is one connection (xtcp2-nlcap tcp), and
    # `hmac KEYID ALGO SECRET` one SRv6 HMAC key (xtcp2-nlcap hmac); a
    # refused one joins nltopo's refusals, so it fails the run as a refused
    # `ip` step does. Anything else is an address-corpus step
    # (addrcorpus::pre_step).
    ###########################################################################
    proc pre_step {ns subdir step} {
        switch -- [lindex $step 0] {
            tcp {
                if {[llength $step] != 3} {
                    error "genlcorpus: a tcp step is {tcp SERVER CLIENT}: $step"
                }
                lassign [lrange $step 1 2] server client
                set cmd "xtcp2-nlcap tcp $ns $subdir $server $client"
                set refusal "xtcp2-nl-tcp -n $ns $server $client"
            }
            hmac {
                if {[llength $step] != 4} {
                    error "genlcorpus: an hmac step is {hmac KEYID ALGO SECRET}: $step"
                }
                lassign [lrange $step 1 3] keyid algo secret
                set cmd "xtcp2-nlcap hmac $ns $subdir $keyid $algo $secret"
                set refusal "ip -n $ns sr hmac set $keyid $algo"
            }
            default {
                return [addrcorpus::pre_step $ns $subdir $step]
            }
        }
        lassign [vmlib::run_out $cmd] rc out
        if {$rc == 0} {
            return 1
        }
        lappend nltopo::refused $refusal
        vmlib::log "genl corpus: step refused: $refusal"
        return 0
    }

    ###########################################################################
    # readback_args <ns> <subdir> <readback> - the capio argument list for one
    # readback, ending with the protocol its pcap keeps.
    ###########################################################################
    proc readback_args {ns subdir readback} {
        if {[llength $readback] != 3} {
            error "genlcorpus: a readback is {name floor command}: $readback"
        }
        lassign $readback name floor command
        return [list $ns $subdir netlink_generic_$name $floor $command ip_$name generic]
    }

    ###########################################################################
    # rc_problem <slug> <want> <got> - as rtnlcorpus::rc_problem, under genl/.
    ###########################################################################
    proc rc_problem {slug want got} {
        set got [string trim $got]
        if {$got eq $want} {
            return ""
        }
        if {$got eq ""} {
            return "genl/$slug/ip.rc unreadable, want $want"
        }
        return "genl/$slug/ip.rc is $got, want $want"
    }
}

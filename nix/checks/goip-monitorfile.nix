# nix/checks/goip-monitorfile.nix
#
# EP2-T03: the crafted monitor files, gated. This is the check that would
# have caught 0067cbc8 (the u16 bond partner read) and P14 (the u32 reason
# read as a u8) before the notes existed: every committed spec is
# regenerated by the real nlcapgen and must write the committed .nl byte for
# byte, and every committed .nl is replayed through `ip -d monitor file` at
# both pinned versions and `goip -d monitor file` at both GOIP_IP730 knobs,
# stdout and rc against the committed goldens
# (docs/netlink/goip-parity-events.md, "EP2-T02 the blobs").
#
# AF_NETLINK works in the build sandbox, and the sandbox's network namespace
# holds only lo and the two fallback tunnels (a runCommand probe measured it),
# so ifindex 7 carries no name and every dev prints `if7` — the
# no-sandbox-index rule. The check asserts that rule first, so a sandbox that
# ever names ifindex 7 is a named red, not a wall of golden mismatches. The
# refusal row is the measured one: a file that is not netlink prints no
# stdout and exits 1 on every tool, goip's complaint prefixed with its own
# name (stderr is checked non-empty, not equal — the prefix is the only
# difference).
{
  pkgs,
  lib,
  src,
  binaries,
}:

let
  # nlcapgen is a host tool — it builds the .nl streams; it captures nothing
  # — so it rides no microVM and no xtcp2AllPackage: the check builds it
  # itself, through the same mkGoBinary machinery every cmd/ and tools/
  # binary builds with (the subPath override nix/binaries.nix's tool
  # binaries use).
  mkGoBinary = import ../lib/mkGoBinary.nix { inherit pkgs lib; };
  nlcapgen = mkGoBinary {
    name = "nlcapgen";
    inherit src;
    subPath = "tools/nlcapgen";
    variant = "default";
  };
  # iproute2 7.3.0, the parity pin (nix/iproute2-7-3-0.nix).
  iproute2_7_3_0 = import ../iproute2-7-3-0.nix { inherit pkgs; };
in
pkgs.runCommand "xtcp2-test-goip-monitorfile"
  {
    nativeBuildInputs = [ pkgs.iproute2 ];
  }
  ''
        blobs=${src}/internal/goip/testdata/monitor
        ip720=${pkgs.iproute2}/sbin/ip
        ip730=${iproute2_7_3_0}/sbin/ip
        goip=${binaries.goip}/bin/goip
        nlc=${nlcapgen}/bin/nlcapgen
        fails=0
        red() {
          echo "RED: $*" >&2
          fails=1
        }

        # The no-sandbox-index rule: the blobs use ifindex 7 because no sandbox
        # carries a 7th link. A sandbox that does must fail naming the rule, not
        # as a wall of golden mismatches.
        if "$ip720" -o link show | grep -Eq '^7: '; then
          red "the sandbox carries ifindex 7, so the blobs' goldens would print
    its name — the no-sandbox-index rule (docs/netlink/goip-parity-events.md,
    EP2-T02) says the input moves, not the goldens"
        fi

        # 1. Every committed .nl is what the real nlcapgen writes from its
        #    spec, so the binary can never drift from its reviewable source.
        specs=0
        for spec in "$blobs"/*.spec; do
          stem=$(basename "$spec" .spec)
          specs=$((specs + 1))
          if ! "$nlc" monfile -spec "$spec" -out reg.nl >got.txt 2>err.txt; then
            red "$stem: nlcapgen refused its own spec: $(cat err.txt)"
            continue
          fi
          cmp -s reg.nl "$blobs/$stem.nl" || red "$stem.nl: not what nlcapgen writes"
        done

        # 2. Replay every .nl through both tools at both versions. The stdout is
        #    the parity claim; rc 0 is the replay's own.
        replays=0
        for nl in "$blobs"/*.nl; do
          stem=$(basename "$nl" .nl)
          run() {
            label=$1
            golden=$2
            shift 2
            replays=$((replays + 1))
            if ! "$@" -d monitor file "$nl" >got.txt 2>err.txt; then
              red "$stem/$label: $(cat err.txt)"
              return
            fi
            cmp -s got.txt "$golden" || red "$stem/$label: stdout differs (got $(wc -c <got.txt) bytes, want $(wc -c <"$golden"))"
          }
          run ip730-by-ip730 "$blobs/$stem.ip730.out" "$ip730"
          run ip720-by-ip720 "$blobs/$stem.ip720.out" "$ip720"
          run ip730-by-goip "$blobs/$stem.ip730.out" env GOIP_IP730=1 "$goip"
          run ip720-by-goip "$blobs/$stem.ip720.out" env GOIP_IP730=0 "$goip"
        done

        # 3. The refusal row: a file that is not netlink. Both ips and goip, at
        #    both knobs — the monitor file walk is the parser's, not the
        #    release's. The parity claim is the empty stdout and rc 1; the
        #    stderr is each tool's own complaint (goip prefixes its name).
        printf 'this is not a netlink file at all, just text\n' > not-nl.txt
        for label in ip730 ip720; do
          ip=$ip730
          [ "$label" = ip720 ] && ip=$ip720
          rc=0
          "$ip" -d monitor file not-nl.txt >got.txt 2>err.txt || rc=$?
          [ "$rc" -eq 1 ] || red "refusal/$label: rc $rc, want 1"
          [ ! -s got.txt ] || red "refusal/$label: stdout is not empty"
          [ -s err.txt ] || red "refusal/$label: no complaint"
        done
        for knob in 1 0; do
          rc=0
          GOIP_IP730=$knob "$goip" -d monitor file not-nl.txt >got.txt 2>err.txt || rc=$?
          [ "$rc" -eq 1 ] || red "refusal/goip-knob$knob: rc $rc, want 1"
          [ ! -s got.txt ] || red "refusal/goip-knob$knob: stdout is not empty"
          [ -s err.txt ] || red "refusal/goip-knob$knob: no complaint"
        done

        if [ "$fails" -ne 0 ]; then
          echo "xtcp2-test-goip-monitorfile: FAILED" >&2
          exit 1
        fi
        echo "PASS: $specs specs regenerated, $replays replays byte for byte, 4 refusals" > $out
  ''
